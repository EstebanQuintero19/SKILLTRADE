<header class="sticky top-0 z-10 bg-white/80 backdrop-blur border-b border-[#edeaf0]">
  <div class="mx-auto max-w-[1200px] px-6 h-14 flex items-center justify-between">
    <a href="/" class="flex items-center space-x-2">
      <div class="w-8 h-8 bg-purple-600 rounded-lg flex items-center justify-center">
        <span class="text-white font-bold text-sm">ST</span>
      </div>
      <span class="text-xl font-bold text-gray-900">SkillTrade</span>
    </a>
    <nav class="hidden md:flex space-x-8">
      <a href="/cursos" class="text-gray-600 hover:text-purple-600 font-medium">Cursos</a>
      <a href="/intercambios" class="text-gray-600 hover:text-purple-600 font-medium">Intercambios</a>
      <a href="/ventas" class="text-gray-600 hover:text-purple-600 font-medium">Ventas</a>
    </nav>
    <div class="flex items-center gap-3">
      <% if (signedIn) { %>
        <a href="/perfil" class="text-sm text-[#151117] hover:text-[#5a1593]">Mi perfil</a>
        <form action="/logout" method="post">
          <button class="h-9 px-3 rounded-lg bg-[#eee8f3] text-[#151117] text-sm font-semibold">Salir</button>
        </form>
      <% } else { %>
        <a href="/login" class="text-gray-600 hover:text-purple-600 font-medium">Iniciar Sesión</a>
        <a href="/registro" class="bg-purple-600 text-white px-4 py-2 rounded-lg hover:bg-purple-700 font-medium">Registrarse</a>
      <% } %>
    </div>
  </div>
</header>

