<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-gray-200 shadow-sm">
  <div class="container mx-auto px-6 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2">
      <span class="text-2xl font-extrabold text-indigo-700 tracking-tight">SkillTrade</span>
    </a>
    
    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-6">
      <a href="/cursos" class="text-gray-700 hover:text-indigo-700 font-medium transition-colors">Cursos</a>
      <a href="/intercambios" class="text-gray-700 hover:text-indigo-700 font-medium transition-colors">Intercambios</a>
      <a href="/usuarios/destacados" class="text-gray-700 hover:text-indigo-700 font-medium transition-colors">Comunidad</a>
      <% if (signedIn) { %>
        <a href="/ventas" class="text-gray-700 hover:text-indigo-700 font-medium transition-colors">Mis Ventas</a>
      <% } %>
    </nav>

    <!-- User Actions -->
    <div class="flex items-center gap-4">
      <% if (signedIn) { %>
        <a href="/perfil" class="flex items-center gap-2 text-gray-700 hover:text-indigo-700 font-medium transition-colors">
          <span class="hidden sm:inline">Mi Perfil</span>
          <div class="w-9 h-9 rounded-full bg-indigo-100 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-indigo-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
        </a>
        <form action="/logout" method="post" class="ml-2">
          <button type="submit" class="px-4 py-1 rounded border border-indigo-700 text-indigo-700 hover:bg-indigo-50 text-sm font-medium transition-colors">
            Cerrar sesión
          </button>
        </form>
      <% } else { %>
        <a href="/login" class="text-gray-700 hover:text-indigo-700 font-medium transition-colors">Iniciar sesión</a>
        <a href="/registro" class="px-4 py-1 rounded bg-indigo-700 text-white text-sm font-semibold shadow hover:bg-indigo-800 transition-colors">
          Crear cuenta
        </a>
      <% } %>
    </div>
  </div>
</header>
