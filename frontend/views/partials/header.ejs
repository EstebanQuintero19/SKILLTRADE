<header class="sticky top-0 z-10 bg-white/80 backdrop-blur border-b border-[#edeaf0]">
  <div class="mx-auto max-w-[1200px] px-6 h-14 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 font-bold text-[#151117]">
      <span class="inline-block w-4 h-4 bg-[#5a1593] rounded-sm"></span>
      <span>SkillTrade</span>
    </a>
    <nav class="hidden md:flex items-center gap-6 text-sm text-[#5a5670]">
      <a href="/admin" class="hover:text-[#5a1593]">Dashboard</a>
      <a href="/cursos" class="hover:text-[#5a1593]">Cursos</a>
      <a href="/usuarios/destacados" class="hover:text-[#5a1593]">Usuarios</a>
      <a href="/intercambios" class="hover:text-[#5a1593]">Intercambios</a>
      <a href="/ventas" class="hover:text-[#5a1593]">Ventas</a>
    </nav>
    <div class="flex items-center gap-3">
      <% if (signedIn) { %>
        <a href="/perfil" class="text-sm text-[#151117] hover:text-[#5a1593]">Mi perfil</a>
        <form action="/logout" method="post">
          <button class="h-9 px-3 rounded-lg bg-[#eee8f3] text-[#151117] text-sm font-semibold">Salir</button>
        </form>
      <% } else { %>
        <a href="/login" class="h-9 px-3 rounded-lg bg-[#eee8f3] text-[#151117] text-sm font-semibold">Entrar</a>
        <a href="/registro" class="h-9 px-3 rounded-lg bg-[#5a1593] text-white text-sm font-semibold">Crear cuenta</a>
      <% } %>
    </div>
  </div>
</header>

