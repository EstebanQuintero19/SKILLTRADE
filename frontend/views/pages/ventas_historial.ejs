<!--
/**
 * HISTORIAL DE VENTAS - SkillTrade Frontend
 * @author SkillTrade Team
 * @version 1.0.0
 * 
 * DESCRIPCIÓN:
 * Página para mostrar el historial completo de ventas del usuario
 * con filtros, búsqueda y paginación de transacciones.
 * 
 * FUNCIONALIDADES:
 * - Historial completo de ventas paginado
 * - Filtros por fecha, estado y monto
 * - Búsqueda por curso o comprador
 * - Estadísticas de ventas del usuario
 * - Exportación de datos (opcional)
 * 
 * CARACTERÍSTICAS TÉCNICAS:
 * - Tabla responsive con información detallada
 * - Filtros dinámicos con JavaScript
 * - Paginación de resultados
 * - Gráficos de estadísticas (opcional)
 * 
 * VARIABLES EJS:
 * - ventas: Array de ventas del usuario
 * - estadisticas: Métricas de ventas
 * - paginacion: Información de paginación
 */
-->
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Historial de Ventas - SkillTrade</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-gray-50 min-h-screen">

<section class="mb-4">
  <h1 class="text-2xl font-extrabold text-[#151117]">Historial de compras</h1>
  <p class="text-sm text-[#6f6880]">Revisa tus compras y descarga comprobantes.</p>
</section>

</body>
</html>

<div class="overflow-x-auto rounded-lg border border-[#edeaf0]">
  <table class="w-full text-sm">
    <thead class="bg-[#f5f2f8] text-[#6f6880]">
      <tr>
        <th class="px-4 py-2 text-left">ID</th>
        <th class="px-4 py-2 text-left">Curso</th>
        <th class="px-4 py-2 text-left">Monto</th>
        <th class="px-4 py-2 text-left">Fecha</th>
        <th class="px-4 py-2 text-left">Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% (ventas||[]).forEach(v => { %>
        <tr class="border-t border-[#edeaf0]">
          <td class="px-4 py-3">#<%= v._id %></td>
          <td class="px-4 py-3 text-[#5a1593]"><%= v.curso?.titulo || '-' %></td>
          <td class="px-4 py-3">$<%= Number(v.monto||v.precio||0).toFixed(2) %></td>
          <td class="px-4 py-3"><%= (new Date(v.fecha||v.createdAt)).toISOString().slice(0,10) %></td>
          <td class="px-4 py-3">
            <a class="text-[#5a1593]" href="<%= API_BASE %>/api/ventas/<%= v._id %>/comprobante" target="_blank">Comprobante</a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

