<% layout('layout') %>

<section class="mb-10">
  <h1 class="text-3xl font-extrabold text-gray-900">Historial de compras</h1>
  <p class="text-base text-gray-500 mt-2">Revisa tus compras y descarga comprobantes</p>
  
  <!-- Estadísticas -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-6">
    <!-- Total compras -->
    <div class="rounded-xl border border-gray-200 bg-white shadow-sm p-6 flex items-center gap-4">
      <div class="w-14 h-14 rounded-full bg-purple-50 flex items-center justify-center">
        <svg class="w-7 h-7 text-purple-700" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
          <path fill="currentColor" d="M216 64h-40v-8a24 24 0 0 0-24-24h-48a24 24 0 0 0-24 24v8H40a8 8 0 0 0 0 16h8v120a16 16 0 0 0 16 16h128a16 16 0 0 0 16-16V80h8a8 8 0 0 0 0-16ZM96 56a8 8 0 0 1 8-8h48a8 8 0 0 1 8 8v8H96Zm96 144H64V80h128Z"/>
        </svg>
      </div>
      <div>
        <p class="text-3xl font-bold text-gray-900"><%= (ventas||[]).length %></p>
        <p class="text-sm text-gray-500">Compras totales</p>
      </div>
    </div>
    <!-- Total gastado -->
    <div class="rounded-xl border border-gray-200 bg-white shadow-sm p-6 flex items-center gap-4">
      <div class="w-14 h-14 rounded-full bg-purple-50 flex items-center justify-center">
        <svg class="w-7 h-7 text-purple-700" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
          <path fill="currentColor" d="M128 24a104 104 0 1 0 104 104A104.11 104.11 0 0 0 128 24Zm0 192a88 88 0 1 1 88-88a88.1 88.1 0 0 1-88 88Zm40-68a28 28 0 0 1-28 28h-4v8a8 8 0 0 1-16 0v-8h-12a8 8 0 0 1 0-16h28a12 12 0 0 0 0-24h-16a28 28 0 0 1 0-56h4v-8a8 8 0 0 1 16 0v8h12a8 8 0 0 1 0 16h-28a12 12 0 0 0 0 24h16a28 28 0 0 1 28 28Z"/>
        </svg>
      </div>
      <div>
        <p class="text-3xl font-bold text-gray-900">
          $<%= (ventas||[]).reduce((sum, v) => sum + Number(v.monto||v.precio||0), 0).toFixed(2) %>
        </p>
        <p class="text-sm text-gray-500">Total gastado</p>
      </div>
    </div>
    <!-- Últimos 30 días -->
    <div class="rounded-xl border border-gray-200 bg-white shadow-sm p-6 flex items-center gap-4">
      <div class="w-14 h-14 rounded-full bg-purple-50 flex items-center justify-center">
        <svg class="w-7 h-7 text-purple-700" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
          <path fill="currentColor" d="M208 32H48a16 16 0 0 0-16 16v160a16 16 0 0 0 16 16h160a16 16 0 0 0 16-16V48a16 16 0 0 0-16-16Zm0 176H48V48h160v160ZM96 96a8 8 0 0 1 8-8h48a8 8 0 0 1 0 16h-48a8 8 0 0 1-8-8Zm0 32a8 8 0 0 1 8-8h48a8 8 0 0 1 0 16h-48a8 8 0 0 1-8-8Zm0 32a8 8 0 0 1 8-8h48a8 8 0 0 1 0 16h-48a8 8 0 0 1-8-8Z"/>
        </svg>
      </div>
      <div>
        <p class="text-3xl font-bold text-gray-900">
          <%= (ventas||[]).filter(v => {
            const date = new Date(v.fecha||v.createdAt);
            const now = new Date();
            const diffDays = (now - date) / (1000 * 60 * 60 * 24);
            return diffDays <= 30;
          }).length %>
        </p>
        <p class="text-sm text-gray-500">Últimos 30 días</p>
      </div>
    </div>
  </div>
</section>

<!-- Filtros y búsqueda -->
<section class="mb-6 flex flex-col md:flex-row gap-4">
  <div class="relative flex-1">
    <input 
      id="searchInput" 
      class="w-full h-12 rounded-lg border border-gray-200 pl-12 pr-4 bg-white text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-purple-600 focus:border-transparent transition"
      placeholder="Buscar por curso o ID..." 
    />
    <svg class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
      <path fill="currentColor" d="M229.66 218.34l-50.07-50.06a88.11 88.11 0 1 0-11.31 11.31l50.06 50.07a8 8 0 0 0 11.32-11.32ZM40 112a72 72 0 1 1 72 72a72.08 72.08 0 0 1-72-72Z"/>
    </svg>
  </div>
  
  <select id="sortSelect" class="h-12 px-4 rounded-lg border border-gray-200 bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-purple-600 focus:border-transparent transition">
    <option value="date-desc">Más recientes</option>
    <option value="date-asc">Más antiguos</option>
    <option value="amount-desc">Mayor monto</option>
    <option value="amount-asc">Menor monto</option>
  </select>
  
  <button id="exportBtn" class="h-12 px-5 rounded-lg bg-purple-50 text-purple-700 text-base font-semibold hover:bg-purple-100 transition flex items-center gap-2 shadow-sm border border-purple-100">
    <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
      <path fill="currentColor" d="M74.34 85.66a8 8 0 0 1 11.32-11.32L120 108.69V24a8 8 0 0 1 16 0v84.69l34.34-34.35a8 8 0 0 1 11.32 11.32l-48 48a8 8 0 0 1-11.32 0ZM240 136v64a16 16 0 0 1-16 16H32a16 16 0 0 1-16-16v-64a16 16 0 0 1 16-16h52.4a4 4 0 0 1 2.83 1.17L111 145a24 24 0 0 0 34 0l23.8-23.8a4 4 0 0 1 2.8-1.2H224a16 16 0 0 1 16 16Zm-16 64v-64h-49.66a4 4 0 0 1-2.82-1.17L148 111.31a8 8 0 0 0-11.31 0l-23.52 23.52A4 4 0 0 1 110.34 136H32v64h192Zm-20-24a12 12 0 1 0-12 12a12 12 0 0 0 12-12Z"/>
    </svg>
    Exportar
  </button>
</section>

<!-- Tabla de compras -->
<% if (!ventas || ventas.length === 0) { %>
  <div class="rounded-xl border border-gray-200 bg-white shadow-sm p-16 text-center">
    <svg class="mx-auto mb-6 w-20 h-20 text-gray-300" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
      <path fill="currentColor" d="M216 64h-40v-8a24 24 0 0 0-24-24h-48a24 24 0 0 0-24 24v8H40a8 8 0 0 0 0 16h8v120a16 16 0 0 0 16 16h128a16 16 0 0 0 16-16V80h8a8 8 0 0 0 0-16ZM96 56a8 8 0 0 1 8-8h48a8 8 0 0 1 8 8v8H96Zm96 144H64V80h128Z"/>
    </svg>
    <h3 class="text-xl font-bold text-gray-900 mb-2">No hay compras aún</h3>
    <p class="text-base text-gray-500 mb-6">Cuando realices una compra aparecerá aquí</p>
    <a href="/cursos" class="inline-block h-12 px-8 rounded-lg bg-purple-700 text-white text-base font-semibold hover:bg-purple-800 transition">
      Explorar cursos
    </a>
  </div>
<% } else { %>
  <!-- Vista desktop: tabla -->
  <div class="hidden md:block overflow-x-auto rounded-xl border border-gray-200 bg-white shadow-sm">
    <table class="w-full text-base" id="purchasesTable">
      <thead class="bg-gray-50 text-gray-500">
        <tr>
          <th class="px-6 py-4 text-left font-semibold">ID de compra</th>
          <th class="px-6 py-4 text-left font-semibold">Curso</th>
          <th class="px-6 py-4 text-left font-semibold">Monto</th>
          <th class="px-6 py-4 text-left font-semibold">Fecha</th>
          <th class="px-6 py-4 text-left font-semibold">Estado</th>
          <th class="px-6 py-4 text-left font-semibold">Acciones</th>
        </tr>
      </thead>
      <tbody id="tableBody">
        <% ventas.forEach(v => { %>
          <tr class="border-t border-gray-100 hover:bg-gray-50 transition-colors purchase-row" 
              data-id="<%= v._id %>" 
              data-curso="<%= (v.curso?.titulo || '').toLowerCase() %>"
              data-monto="<%= Number(v.monto||v.precio||0) %>"
              data-fecha="<%= new Date(v.fecha||v.createdAt).getTime() %>">
            <td class="px-6 py-4">
              <span class="text-gray-400 font-mono text-xs">#<%= v._id.toString().slice(-8) %></span>
            </td>
            <td class="px-6 py-4">
              <div class="flex items-center gap-3">
                <% if (v.curso?.imagen) { %>
                  <img src="<%= v.curso.imagen %>" class="w-12 h-12 rounded object-cover border border-gray-200" alt="">
                <% } %>
                <div>
                  <p class="font-semibold text-gray-900"><%= v.curso?.titulo || 'Curso no disponible' %></p>
                  <% if (v.curso?.instructor) { %>
                    <p class="text-xs text-gray-400"><%= v.curso.instructor %></p>
                  <% } %>
                </div>
              </div>
            </td>
            <td class="px-6 py-4">
              <span class="font-semibold text-gray-900">$<%= Number(v.monto||v.precio||0).toFixed(2) %></span>
            </td>
            <td class="px-6 py-4">
              <div>
                <p class="text-gray-900"><%= new Date(v.fecha||v.createdAt).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' }) %></p>
                <p class="text-xs text-gray-400"><%= new Date(v.fecha||v.createdAt).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' }) %></p>
              </div>
            </td>
            <td class="px-6 py-4">
              <span class="px-3 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-700">
                Completado
              </span>
            </td>
            <td class="px-6 py-4">
              <div class="flex items-center gap-3">
                <a 
                  class="text-purple-700 hover:text-purple-900 font-medium transition-colors flex items-center gap-1" 
                  href="<%= API_BASE %>/api/ventas/<%= v._id %>/comprobante" 
                  target="_blank"
                  title="Descargar comprobante"
                >
                  <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
                    <path fill="currentColor" d="M74.34 85.66a8 8 0 0 1 11.32-11.32L120 108.69V24a8 8 0 0 1 16 0v84.69l34.34-34.35a8 8 0 0 1 11.32 11.32l-48 48a8 8 0 0 1-11.32 0ZM240 136v64a16 16 0 0 1-16 16H32a16 16 0 0 1-16-16v-64a16 16 0 0 1 16-16h52.4a4 4 0 0 1 2.83 1.17L111 145a24 24 0 0 0 34 0l23.8-23.8a4 4 0 0 1 2.8-1.2H224a16 16 0 0 1 16 16Z"/>
                  </svg>
                  PDF
                </a>
                <% if (v.curso?._id) { %>
                  <a 
                    class="text-purple-700 hover:text-purple-900 font-medium transition-colors" 
                    href="/cursos/<%= v.curso._id %>"
                    title="Ver curso"
                  >
                    Ver curso
                  </a>
                <% } %>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- Vista mobile: cards -->
  <div class="md:hidden space-y-4" id="mobileCards">
    <% ventas.forEach(v => { %>
      <div class="rounded-xl border border-gray-200 bg-white shadow-sm p-5 purchase-card" 
           data-id="<%= v._id %>" 
           data-curso="<%= (v.curso?.titulo || '').toLowerCase() %>"
           data-monto="<%= Number(v.monto||v.precio||0) %>"
           data-fecha="<%= new Date(v.fecha||v.createdAt).getTime() %>">
        <div class="flex items-start justify-between mb-3">
          <div>
            <p class="text-xs text-gray-400 font-mono">#<%= v._id.toString().slice(-8) %></p>
            <p class="text-sm text-gray-500 mt-1">
              <%= new Date(v.fecha||v.createdAt).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' }) %>
            </p>
          </div>
          <span class="px-3 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-700">
            Completado
          </span>
        </div>
        
        <div class="flex items-center gap-4 mb-4">
          <% if (v.curso?.imagen) { %>
            <img src="<%= v.curso.imagen %>" class="w-16 h-16 rounded object-cover border border-gray-200" alt="">
          <% } %>
          <div class="flex-1 min-w-0">
            <p class="font-semibold text-gray-900 truncate"><%= v.curso?.titulo || 'Curso no disponible' %></p>
            <% if (v.curso?.instructor) { %>
              <p class="text-xs text-gray-400 mt-1"><%= v.curso.instructor %></p>
            <% } %>
          </div>
        </div>
        
        <div class="flex items-center justify-between pt-4 border-t border-gray-100">
          <span class="text-lg font-bold text-gray-900">$<%= Number(v.monto||v.precio||0).toFixed(2) %></span>
          <div class="flex items-center gap-2">
            <a 
              class="h-10 px-4 rounded-lg bg-purple-50 text-purple-700 text-sm font-semibold hover:bg-purple-100 transition flex items-center gap-1 border border-purple-100" 
              href="<%= API_BASE %>/api/ventas/<%= v._id %>/comprobante" 
              target="_blank"
            >
              <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
                <path fill="currentColor" d="M74.34 85.66a8 8 0 0 1 11.32-11.32L120 108.69V24a8 8 0 0 1 16 0v84.69l34.34-34.35a8 8 0 0 1 11.32 11.32l-48 48a8 8 0 0 1-11.32 0Z"/>
              </svg>
              PDF
            </a>
            <% if (v.curso?._id) { %>
              <a 
                class="h-10 px-4 rounded-lg bg-purple-700 text-white text-sm font-semibold hover:bg-purple-800 transition" 
                href="/cursos/<%= v.curso._id %>"
              >
                Ver curso
              </a>
            <% } %>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

  <!-- Paginación (si aplica) -->
  <div class="mt-8 flex items-center justify-between">
    <p class="text-base text-gray-500">
      Mostrando <span id="showingCount"><%= ventas.length %></span> de <%= ventas.length %> compras
    </p>
  </div>
<% } %>

<script>
  // ... Tu script permanece igual ...
</script>
