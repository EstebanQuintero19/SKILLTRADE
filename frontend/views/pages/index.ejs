<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  
  <!-- Hero Section -->
  <section class="mb-16">
    <div class="bg-gradient-to-br from-[#5a1593] via-[#6b2aa3] to-[#8b4dbf] rounded-2xl overflow-hidden shadow-2xl">
      <div class="grid lg:grid-cols-2 gap-8 items-center">
        <!-- Contenido -->
        <div class="p-8 lg:p-12 text-white">
          <div class="inline-block px-4 py-1.5 rounded-full bg-white/20 backdrop-blur text-sm font-medium mb-4">
            🎓 Plataforma de Aprendizaje
          </div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold mb-4 leading-tight">
            Explora y comparte conocimiento
          </h1>
          <p class="text-lg md:text-xl text-white/90 mb-8 leading-relaxed">
            Cursos, suscripciones, intercambios y ventas en una sola plataforma educativa.
          </p>
          
          <!-- Estadísticas rápidas -->
          <div class="grid grid-cols-3 gap-4 mb-8 pb-8 border-b border-white/20">
            <div>
              <p class="text-3xl font-bold"><%= (cursos || []).length %></p>
              <p class="text-sm text-white/80">Cursos</p>
            </div>
            <div>
              <p class="text-3xl font-bold">500+</p>
              <p class="text-sm text-white/80">Estudiantes</p>
            </div>
            <div>
              <p class="text-3xl font-bold">50+</p>
              <p class="text-sm text-white/80">Instructores</p>
            </div>
          </div>

          <!-- Botones de acción -->
          <div class="flex flex-wrap gap-4">
            <a 
              href="/cursos" 
              class="inline-flex items-center gap-2 py-3 px-6 rounded-lg bg-white text-[#5a1593] font-semibold hover:bg-gray-100 transition-colors shadow-lg hover:shadow-xl"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
              Explorar Cursos
            </a>
            <a 
              href="/crear-curso" 
              class="inline-flex items-center gap-2 py-3 px-6 rounded-lg bg-white/10 backdrop-blur border-2 border-white/30 text-white font-semibold hover:bg-white/20 transition-colors"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
              </svg>
              Crear Curso
            </a>
          </div>
        </div>

        <!-- Imagen/Ilustración -->
        <div class="hidden lg:block relative h-full min-h-[400px]">
          <div class="absolute inset-0 bg-gradient-to-br from-white/10 to-transparent"></div>
          <div class="absolute inset-0 flex items-center justify-center p-8">
            <div class="grid grid-cols-2 gap-4 w-full max-w-md">
              <!-- Cards flotantes decorativas -->
              <div class="bg-white/90 backdrop-blur rounded-xl p-4 shadow-xl transform rotate-3 hover:rotate-0 transition-transform">
                <div class="w-full aspect-video bg-gradient-to-br from-teal-400 to-teal-600 rounded-lg mb-2"></div>
                <div class="h-2 bg-gray-200 rounded mb-1"></div>
                <div class="h-2 bg-gray-200 rounded w-2/3"></div>
              </div>
              <div class="bg-white/90 backdrop-blur rounded-xl p-4 shadow-xl transform -rotate-3 hover:rotate-0 transition-transform mt-8">
                <div class="w-full aspect-video bg-gradient-to-br from-blue-400 to-blue-600 rounded-lg mb-2"></div>
                <div class="h-2 bg-gray-200 rounded mb-1"></div>
                <div class="h-2 bg-gray-200 rounded w-3/4"></div>
              </div>
              <div class="bg-white/90 backdrop-blur rounded-xl p-4 shadow-xl transform rotate-2 hover:rotate-0 transition-transform -mt-4">
                <div class="w-full aspect-video bg-gradient-to-br from-purple-400 to-purple-600 rounded-lg mb-2"></div>
                <div class="h-2 bg-gray-200 rounded mb-1"></div>
                <div class="h-2 bg-gray-200 rounded w-1/2"></div>
              </div>
              <div class="bg-white/90 backdrop-blur rounded-xl p-4 shadow-xl transform -rotate-2 hover:rotate-0 transition-transform mt-4">
                <div class="w-full aspect-video bg-gradient-to-br from-pink-400 to-pink-600 rounded-lg mb-2"></div>
                <div class="h-2 bg-gray-200 rounded mb-1"></div>
                <div class="h-2 bg-gray-200 rounded w-3/5"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Características rápidas -->
  <section class="mb-16">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="bg-white rounded-xl shadow-sm border border-[#edeaf0] p-6 hover:shadow-md transition-shadow">
        <div class="w-12 h-12 bg-[#f5f2f8] rounded-lg flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-[#5a1593]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
          </svg>
        </div>
        <h3 class="font-bold text-[#151117] mb-2">Cursos Variados</h3>
        <p class="text-sm text-[#6f6880]">Accede a cientos de cursos en diferentes categorías</p>
      </div>

      <div class="bg-white rounded-xl shadow-sm border border-[#edeaf0] p-6 hover:shadow-md transition-shadow">
        <div class="w-12 h-12 bg-[#f5f2f8] rounded-lg flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-[#5a1593]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <h3 class="font-bold text-[#151117] mb-2">Aprende a tu Ritmo</h3>
        <p class="text-sm text-[#6f6880]">Contenido disponible 24/7 para aprender cuando quieras</p>
      </div>

      <div class="bg-white rounded-xl shadow-sm border border-[#edeaf0] p-6 hover:shadow-md transition-shadow">
        <div class="w-12 h-12 bg-[#f5f2f8] rounded-lg flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-[#5a1593]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
          </svg>
        </div>
        <h3 class="font-bold text-[#151117] mb-2">Certificados</h3>
        <p class="text-sm text-[#6f6880]">Obtén certificados al completar tus cursos</p>
      </div>

      <div class="bg-white rounded-xl shadow-sm border border-[#edeaf0] p-6 hover:shadow-md transition-shadow">
        <div class="w-12 h-12 bg-[#f5f2f8] rounded-lg flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-[#5a1593]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
        </div>
        <h3 class="font-bold text-[#151117] mb-2">Comunidad</h3>
        <p class="text-sm text-[#6f6880]">Conecta con otros estudiantes y instructores</p>
      </div>
    </div>
  </section>

  <!-- Cursos recientes -->
  <section>
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-3xl font-bold text-[#151117]">Cursos Recientes</h2>
        <p class="text-[#6f6880] mt-1">Descubre los últimos cursos agregados a la plataforma</p>
      </div>
      <a 
        href="/cursos" 
        class="hidden sm:inline-flex items-center gap-2 text-[#5a1593] font-semibold hover:gap-3 transition-all"
      >
        Ver todos
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>

    <% if (cursos && cursos.length > 0) { %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-6">
        <% cursos.slice(0, 6).forEach(c => { %>
          <a 
            href="/curso/<%= c._id %>" 
            class="group block bg-white rounded-xl overflow-hidden shadow-sm border border-[#edeaf0] hover:shadow-lg transition-all duration-300"
          >
            <!-- Imagen -->
            <div class="relative w-full aspect-video bg-cover bg-center overflow-hidden" style="background-image:url('<%= c.imagen || 'https://via.placeholder.com/640x360' %>')">
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
              <% if (c.nivel) { %>
                <span class="absolute top-3 right-3 px-2 py-1 rounded-full text-xs font-semibold bg-white/90 backdrop-blur text-[#5a1593] capitalize">
                  <%= c.nivel %>
                </span>
              <% } %>
            </div>

            <!-- Contenido -->
            <div class="p-4">
              <!-- Categorías -->
              <% if (c.categoria && c.categoria.length > 0) { %>
                <div class="flex flex-wrap gap-1 mb-2">
                  <% c.categoria.slice(0, 2).forEach(cat => { %>
                    <span class="inline-block px-2 py-0.5 rounded text-xs font-medium bg-[#f5f2f8] text-[#5a1593]">
                      <%= cat %>
                    </span>
                  <% }) %>
                </div>
              <% } %>

              <!-- Título -->
              <h3 class="font-bold text-[#151117] mb-2 group-hover:text-[#5a1593] transition-colors line-clamp-2 min-h-[3rem]">
                <%= c.titulo %>
              </h3>

              <!-- Descripción -->
              <p class="text-sm text-[#6f6880] line-clamp-2 mb-3 min-h-[2.5rem]">
                <%= c.descripcion %>
              </p>

              <!-- Footer -->
              <div class="flex items-center justify-between pt-3 border-t border-[#edeaf0]">
                <div class="flex items-center gap-1 text-xs text-[#6f6880]">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                  </svg>
                  <span>Curso online</span>
                </div>
                <% if (c.precio !== undefined && c.precio !== null) { %>
                  <span class="text-lg font-bold text-[#5a1593]">
                    $<%= Number(c.precio).toFixed(2) %>
                  </span>
                <% } %>
              </div>
            </div>
          </a>
        <% }) %>
      </div>

      <!-- Ver todos en móvil -->
      <div class="text-center sm:hidden">
        <a 
          href="/cursos" 
          class="inline-flex items-center gap-2 py-3 px-6 rounded-lg bg-[#eee8f3] text-[#5a1593] font-semibold hover:bg-[#e0d5ed] transition-colors"
        >
          Ver Todos los Cursos
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    <% } else { %>
      <!-- Estado vacío -->
      <div class="bg-white rounded-xl shadow-sm border border-[#edeaf0] p-12 text-center">
        <div class="max-w-md mx-auto">
          <div class="w-24 h-24 bg-[#f5f2f8] rounded-full flex items-center justify-center mx-auto mb-6">
            <svg class="w-12 h-12 text-[#6f6880]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-[#151117] mb-3">No hay cursos disponibles aún</h3>
          <p class="text-[#6f6880] mb-6">Sé el primero en crear un curso para la comunidad</p>
          <a 
            href="/crear-curso" 
            class="inline-flex items-center gap-2 py-3 px-8 rounded-lg bg-[#5a1593] text-white font-semibold hover:bg-[#4a1275] transition-colors shadow-md hover:shadow-lg"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Crear Primer Curso
          </a>
        </div>
      </div>
    <% } %>
  </section>
</div>