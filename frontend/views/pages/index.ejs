<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SkillTrade - Plataforma de Aprendizaje</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-gray-50 min-h-screen">

<%- include('../partials/header') %>

<!-- Main Content -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

<!-- Hero Section -->
<section class="mb-20">
  <div class="bg-gradient-to-r from-purple-600 to-purple-800 rounded-2xl overflow-hidden shadow-xl">
    <div class="px-8 py-16 lg:px-16 lg:py-24">
      <div class="max-w-3xl mx-auto text-center text-white">
        <div class="inline-flex items-center px-4 py-2 rounded-full bg-white/20 text-sm font-medium mb-8">
          <span class="mr-2">🎓</span>
          Plataforma de Aprendizaje
        </div>
        
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight">
          Explora y comparte <br>
          <span class="text-yellow-300">conocimiento</span>
        </h1>
        
        <p class="text-xl text-purple-100 mb-12 max-w-2xl mx-auto">
          Descubre cursos increíbles, conecta con expertos y acelera tu crecimiento profesional en nuestra plataforma educativa.
        </p>
        
        <!-- Estadísticas -->
        <div class="grid grid-cols-3 gap-8 mb-12 max-w-md mx-auto">
          <div class="text-center">
            <div class="text-3xl font-bold mb-1"><%= (cursos || []).length %></div>
            <div class="text-sm text-purple-200">Cursos</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold mb-1">500+</div>
            <div class="text-sm text-purple-200">Estudiantes</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold mb-1">50+</div>
            <div class="text-sm text-purple-200">Instructores</div>
          </div>
        </div>

        <!-- Botones -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/cursos" class="inline-flex items-center justify-center px-8 py-4 bg-white text-purple-600 font-bold rounded-xl hover:bg-gray-50 transition-colors shadow-lg">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            Explorar Cursos
          </a>
          <a href="/crear-curso" class="inline-flex items-center justify-center px-8 py-4 bg-purple-500 text-white font-bold rounded-xl hover:bg-purple-400 transition-colors">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Crear Curso
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Características principales -->
<section class="mb-20">
  <div class="text-center mb-16">
    <h2 class="text-4xl font-bold text-gray-900 mb-4">¿Por qué elegir SkillTrade?</h2>
    <p class="text-xl text-gray-600 max-w-2xl mx-auto">
      Nuestra plataforma te ofrece las mejores herramientas para aprender y enseñar
    </p>
  </div>
  
  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-lg transition-shadow">
      <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mb-4">
        <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
        </svg>
      </div>
      <h3 class="font-bold text-gray-900 mb-2">Cursos Variados</h3>
      <p class="text-sm text-gray-600">Accede a cientos de cursos en diferentes categorías</p>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-lg transition-shadow">
      <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mb-4">
        <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
      <h3 class="font-bold text-gray-900 mb-2">Aprende a tu Ritmo</h3>
      <p class="text-sm text-gray-600">Contenido disponible 24/7 para aprender cuando quieras</p>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-lg transition-shadow">
      <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-4">
        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
        </svg>
      </div>
      <h3 class="font-bold text-gray-900 mb-2">Certificados</h3>
      <p class="text-sm text-gray-600">Obtén certificados al completar tus cursos</p>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-lg transition-shadow">
      <div class="w-12 h-12 bg-pink-100 rounded-lg flex items-center justify-center mb-4">
        <svg class="w-6 h-6 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
        </svg>
      </div>
      <h3 class="font-bold text-gray-900 mb-2">Comunidad</h3>
      <p class="text-sm text-gray-600">Conecta con otros estudiantes y instructores</p>
    </div>
  </div>
</section>

<!-- Cursos destacados -->
<section class="mb-20">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h2 class="text-3xl font-bold text-gray-900 mb-2">Cursos Destacados</h2>
      <p class="text-gray-600">Descubre los cursos más populares de nuestra plataforma</p>
    </div>
    <a href="/cursos" class="hidden sm:inline-flex items-center text-purple-600 font-semibold hover:text-purple-700">
      Ver todos
      <svg class="w-5 h-5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
      </svg>
    </a>
  </div>

  <% if (cursos && cursos.length > 0) { %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-6">
      <% cursos.slice(0, 6).forEach(c => { %>
        <a href="/curso/<%= c._id %>" class="group block bg-white rounded-xl overflow-hidden shadow-sm border border-gray-200 hover:shadow-lg transition-shadow">
          <div class="relative w-full aspect-video bg-gray-200">
            <% if (c.imagen) { %>
              <img src="<%= c.imagen %>" alt="<%= c.titulo %>" class="w-full h-full object-cover">
            <% } else { %>
              <div class="w-full h-full bg-gradient-to-br from-purple-400 to-purple-600 flex items-center justify-center">
                <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                </svg>
              </div>
            <% } %>
            <% if (c.nivel) { %>
              <span class="absolute top-3 right-3 px-2 py-1 rounded-full text-xs font-semibold bg-white text-purple-600 capitalize">
                <%= c.nivel %>
              </span>
            <% } %>
          </div>

          <div class="p-4">
            <% if (c.categoria && c.categoria.length > 0) { %>
              <div class="flex flex-wrap gap-1 mb-2">
                <% c.categoria.slice(0, 2).forEach(cat => { %>
                  <span class="inline-block px-2 py-0.5 rounded text-xs font-medium bg-purple-100 text-purple-600">
                    <%= cat %>
                  </span>
                <% }) %>
              </div>
            <% } %>

            <h3 class="font-bold text-gray-900 mb-2 group-hover:text-purple-600 transition-colors">
              <%= c.titulo %>
            </h3>

            <p class="text-sm text-gray-600 mb-3">
              <%= c.descripcion %>
            </p>

            <div class="flex items-center justify-between pt-3 border-t border-gray-200">
              <div class="flex items-center gap-1 text-xs text-gray-500">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                </svg>
                <span>Curso online</span>
              </div>
              <% if (c.precio !== undefined && c.precio !== null) { %>
                <span class="text-lg font-bold text-purple-600">
                  $<%= Number(c.precio).toFixed(2) %>
                </span>
              <% } %>
            </div>
          </div>
        </a>
      <% }) %>
    </div>
  <% } else { %>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-12 text-center">
      <div class="max-w-md mx-auto">
        <div class="w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-gray-900 mb-3">No hay cursos disponibles aún</h3>
        <p class="text-gray-600 mb-6">Sé el primero en crear un curso para la comunidad</p>
        <a href="/crear-curso" class="inline-flex items-center gap-2 py-3 px-8 rounded-lg bg-purple-600 text-white font-semibold hover:bg-purple-700 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          Crear Primer Curso
        </a>
      </div>
    </div>
  <% } %>
</section>

<!-- CTA Final -->
<section class="mb-20">
  <div class="bg-gradient-to-r from-purple-600 to-purple-800 rounded-2xl p-12 text-center text-white">
    <h2 class="text-4xl font-bold mb-4">¿Listo para comenzar?</h2>
    <p class="text-xl text-purple-100 mb-8 max-w-2xl mx-auto">
      Únete a miles de estudiantes que ya están transformando sus carreras con SkillTrade
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/registro" class="inline-flex items-center justify-center px-8 py-4 bg-white text-purple-600 font-bold rounded-xl hover:bg-gray-50 transition-colors">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
        </svg>
        Crear Cuenta Gratis
      </a>
      <a href="/cursos" class="inline-flex items-center justify-center px-8 py-4 bg-purple-500 text-white font-bold rounded-xl hover:bg-purple-400 transition-colors">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        Explorar Cursos
      </a>
    </div>
  </div>
</section>

</div>

<%- include('../partials/footer') %>

</body>
</html>
