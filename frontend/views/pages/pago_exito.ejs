<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pago Exitoso - SkillTrade</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <style>
    body { font-family: 'Inter', sans-serif; }
    .card-shadow { box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06); }
    .fade-in { animation: fadeIn 0.8s ease-out; }
    .bounce-in { animation: bounceIn 1s ease-out; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes bounceIn { 
      0% { transform: scale(0.3); opacity: 0; }
      50% { transform: scale(1.05); }
      70% { transform: scale(0.9); }
      100% { transform: scale(1); opacity: 1; }
    }
    .gradient-bg { background: linear-gradient(135deg, #10b981 0%, #059669 100%); }
    .bg-custom { background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 30%, #a7f3d0 60%, #ecfdf5 100%); }
  </style>
</head>
<body class="bg-custom min-h-screen">

<!-- Header -->
<%- include('../partials/header') %>

<!-- Contenido principal -->
<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-2xl w-full">
    <!-- Tarjeta principal -->
    <div class="bg-white rounded-2xl card-shadow p-8 text-center fade-in">
      <!-- Icono de éxito -->
      <div class="w-24 h-24 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6 bounce-in">
        <i class="fas fa-check text-4xl text-green-600"></i>
      </div>

      <!-- Título -->
      <h1 class="text-3xl font-bold text-gray-900 mb-4">
        ¡Pago Exitoso!
      </h1>
      
      <!-- Mensaje -->
      <p class="text-lg text-gray-600 mb-8">
        Tu compra se ha procesado correctamente. Ya tienes acceso a tus cursos.
      </p>

      <!-- Información del pago -->
      <% if (typeof payment_id !== 'undefined' && payment_id) { %>
        <div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-8">
          <div class="flex items-center justify-center mb-2">
            <i class="fas fa-receipt text-green-600 mr-2"></i>
            <span class="font-semibold text-green-800">ID de Transacción</span>
          </div>
          <p class="text-green-700 font-mono text-sm"><%= payment_id %></p>
        </div>
      <% } %>

      <!-- Características del acceso -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
        <div class="bg-blue-50 rounded-lg p-4">
          <i class="fas fa-infinity text-blue-600 text-2xl mb-2"></i>
          <p class="text-sm font-medium text-blue-800">Acceso de por vida</p>
        </div>
        <div class="bg-purple-50 rounded-lg p-4">
          <i class="fas fa-mobile-alt text-purple-600 text-2xl mb-2"></i>
          <p class="text-sm font-medium text-purple-800">Multiplataforma</p>
        </div>
        <div class="bg-orange-50 rounded-lg p-4">
          <i class="fas fa-certificate text-orange-600 text-2xl mb-2"></i>
          <p class="text-sm font-medium text-orange-800">Certificado incluido</p>
        </div>
      </div>

      <!-- Botones de acción -->
      <div class="space-y-4">
        <a 
          href="/mis-cursos"
          class="block w-full py-4 px-6 rounded-xl bg-gradient-to-r from-green-600 to-green-700 text-white font-bold text-lg hover:from-green-700 hover:to-green-800 transition-all duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-1"
        >
          <i class="fas fa-play-circle mr-2"></i>
          Ver Mis Cursos
        </a>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <a 
            href="/cursos"
            class="block py-3 px-6 rounded-xl bg-gray-100 text-gray-700 font-semibold hover:bg-gray-200 transition-colors"
          >
            <i class="fas fa-search mr-2"></i>
            Explorar Más Cursos
          </a>
          <a 
            href="/perfil"
            class="block py-3 px-6 rounded-xl bg-gray-100 text-gray-700 font-semibold hover:bg-gray-200 transition-colors"
          >
            <i class="fas fa-user mr-2"></i>
            Ver Perfil
          </a>
        </div>
      </div>

      <!-- Mensaje adicional -->
      <div class="mt-8 pt-6 border-t border-gray-200">
        <p class="text-sm text-gray-500">
          <i class="fas fa-envelope mr-1"></i>
          Recibirás un email de confirmación con los detalles de tu compra
        </p>
      </div>
    </div>

    <!-- Información adicional -->
    <div class="mt-8 bg-white rounded-xl card-shadow p-6 fade-in">
      <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
        <i class="fas fa-lightbulb text-yellow-500 mr-2"></i>
        ¿Qué sigue?
      </h3>
      <div class="space-y-3 text-sm text-gray-600">
        <div class="flex items-start">
          <i class="fas fa-check-circle text-green-500 mr-3 mt-0.5"></i>
          <span>Accede a tus cursos desde la sección "Mis Cursos"</span>
        </div>
        <div class="flex items-start">
          <i class="fas fa-check-circle text-green-500 mr-3 mt-0.5"></i>
          <span>Descarga los recursos y materiales complementarios</span>
        </div>
        <div class="flex items-start">
          <i class="fas fa-check-circle text-green-500 mr-3 mt-0.5"></i>
          <span>Completa el curso para obtener tu certificado</span>
        </div>
        <div class="flex items-start">
          <i class="fas fa-check-circle text-green-500 mr-3 mt-0.5"></i>
          <span>Califica y comenta tu experiencia</span>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Footer -->
<%- include('../partials/footer') %>

<script>
// Confetti effect
function createConfetti() {
  const colors = ['#10b981', '#059669', '#34d399', '#6ee7b7'];
  const confettiCount = 50;
  
  for (let i = 0; i < confettiCount; i++) {
    const confetti = document.createElement('div');
    confetti.style.position = 'fixed';
    confetti.style.width = '10px';
    confetti.style.height = '10px';
    confetti.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
    confetti.style.left = Math.random() * 100 + 'vw';
    confetti.style.top = '-10px';
    confetti.style.zIndex = '1000';
    confetti.style.borderRadius = '50%';
    confetti.style.pointerEvents = 'none';
    
    document.body.appendChild(confetti);
    
    const animation = confetti.animate([
      { transform: 'translateY(-10px) rotate(0deg)', opacity: 1 },
      { transform: `translateY(100vh) rotate(${Math.random() * 360}deg)`, opacity: 0 }
    ], {
      duration: Math.random() * 2000 + 3000,
      easing: 'cubic-bezier(0.25, 0.46, 0.45, 0.94)'
    });
    
    animation.onfinish = () => confetti.remove();
  }
}

// Ejecutar confetti al cargar la página
window.addEventListener('load', () => {
  setTimeout(createConfetti, 500);
});
</script>

</body>
</html>
