<!--
/**
 * PÁGINA DE INICIO DE SESIÓN - SkillTrade Frontend
 * @author SkillTrade Team
 * @version 1.0.0
 * 
 * DESCRIPCIÓN:
 * Formulario de autenticación para usuarios existentes. Incluye validación
 * de credenciales, sistema CAPTCHA de seguridad, funcionalidad "Recordarme"
 * y opciones de autenticación social (Google, Facebook).
 * 
 * SECCIONES PRINCIPALES:
 * - HEADER: Presentación visual con gradiente y bienvenida
 * - FORMULARIO: Campos de email, contraseña y CAPTCHA
 * - OPCIONES: Recordarme, recuperar contraseña
 * - AUTENTICACIÓN SOCIAL: Botones de Google y Facebook
 * - REGISTRO: Enlace para crear nueva cuenta
 * - FOOTER: Información de seguridad SSL
 * 
 * CARACTERÍSTICAS TÉCNICAS:
 * - Validación HTML5 en campos requeridos
 * - Sistema CAPTCHA matemático anti-bot
 * - Botón ojito para mostrar/ocultar contraseña
 * - Funcionalidad "Recordarme" con localStorage
 * - Manejo de errores con mensajes descriptivos
 * - Diseño responsive y accesible
 * - Integración con backend para autenticación
 * 
 * VARIABLES EJS:
 * - error: Mensaje de error si la autenticación falla
 * 
 * ARCHIVOS RELACIONADOS:
 * - /css/auth.css: Estilos específicos de autenticación
 * - /js/login.js: JavaScript para interactividad
 */
-->
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Iniciar Sesión - SkillTrade</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body class="bg-gray-50 min-h-screen">

<div class="min-h-[calc(100vh-200px)] flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-md">
    
    <!--CARD PRINCIPAL - Contenedor del formulario-->
    <div class="bg-white rounded-2xl shadow-xl border border-gray-200 overflow-hidden">
      
      <!-- HEADER: Presentación visual con bienvenida -->
      <div class="bg-gradient-to-br from-purple-600 to-purple-800 p-8 text-center">
        <div class="w-20 h-20 bg-white rounded-full flex items-center justify-center mx-auto mb-4 shadow-lg">
          <svg class="w-10 h-10 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
        </div>
        <h1 class="text-3xl font-bold text-white mb-2">¡Bienvenido!</h1>
        <p class="text-white/90">Inicia sesión para continuar aprendiendo</p>
      </div>

      <!--FORMULARIO DE AUTENTICACIÓN-->
      <div class="p-8">
        
        <!-- MENSAJE DE ERROR: Mostrado si la autenticación falla -->
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="mb-6 rounded-lg bg-red-50 border border-red-200 p-4 flex items-start gap-3">
            <svg class="w-5 h-5 text-red-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <div>
              <p class="text-sm font-medium text-red-800">Error al iniciar sesión</p>
              <p class="text-sm text-red-700 mt-1"><%= error %></p>
            </div>
          </div>
        <% } %>

        <form method="post" action="/login" class="space-y-5">
          
          <!-- CAMPO EMAIL: Validación HTML5 requerida -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">
              Correo electrónico
            </label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <input 
                class="w-full h-12 rounded-lg border border-gray-300 pl-11 pr-4 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all" 
                type="email" 
                name="email" 
                placeholder="tu@email.com"
                required 
              />
            </div>
          </div>

          <!-- CAMPO CONTRASEÑA: Con botón ojito para mostrar/ocultar -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">
              Contraseña
            </label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
              </div>
              <input 
                id="loginPassword"
                class="w-full h-12 rounded-lg border border-gray-300 pl-11 pr-12 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all" 
                type="password" 
                name="password" 
                placeholder="••••••••"
                required 
              />
              <button 
                type="button" 
                id="toggleLoginPassword" 
                class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600"
              >
                <svg id="loginEyeIcon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                </svg>
              </button>
            </div>
          </div>

          <!-- OPCIONES: Recordarme y recuperar contraseña -->
          <div class="flex items-center justify-between text-sm">
            <label class="flex items-center gap-2 cursor-pointer">
              <input id="rememberMe" name="rememberMe" type="checkbox" class="w-4 h-4 text-purple-600 border-gray-300 rounded focus:ring-purple-500" />
              <span class="text-gray-600">Recordarme</span>
            </label>
            <a href="/recuperar-password" class="text-purple-600 font-medium hover:text-purple-700 transition-colors">
              ¿Olvidaste tu contraseña?
            </a>
          </div>

          <!-- SISTEMA CAPTCHA: Verificación anti-bot matemática -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">
              Verificación de seguridad
              <span class="text-red-500">*</span>
            </label>
            <div class="bg-gray-50 border border-gray-300 rounded-lg p-4 mb-3">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  <span class="text-sm font-medium text-gray-700">Resuelve esta operación:</span>
                </div>
                <button type="button" id="refreshCaptcha" class="text-purple-600 hover:text-purple-700 text-sm font-medium">
                  Cambiar
                </button>
              </div>
              <div class="mt-2">
                <span id="captchaPregunta" class="text-lg font-mono bg-white px-3 py-2 rounded border inline-block min-w-[120px] text-center">
                  Cargando...
                </span>
              </div>
            </div>
            <input 
              id="captchaRespuesta"
              class="w-full h-12 rounded-lg border border-gray-300 px-4 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent" 
              type="number" 
              name="captcha_respuesta" 
              placeholder="Ingresa tu respuesta"
              required 
            />
            <p class="text-xs text-gray-500 mt-1">Resuelve la operación matemática para continuar</p>
          </div>

          <!-- BOTÓN DE ENVÍO: Procesa autenticación -->
          <button 
            class="w-full h-12 rounded-lg bg-purple-600 text-white font-semibold hover:bg-purple-700 transition-colors shadow-md hover:shadow-lg flex items-center justify-center gap-2" 
            type="submit"
          >
            <span>Iniciar Sesión</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
            </svg>
          </button>
        </form>

        <!--SEPARADOR VISUAL-->
        <div class="relative my-6">
          <div class="absolute inset-0 flex items-center">
            <div class="w-full border-t border-gray-200"></div>
          </div>
          <div class="relative flex justify-center text-sm">
            <span class="px-4 bg-white text-gray-500">o continúa con</span>
          </div>
        </div>

        <!-- AUTENTICACIÓN SOCIAL: Google y Facebook -->
        <div class="grid grid-cols-2 gap-3">
          <button 
            type="button"
            class="h-11 rounded-lg border-2 border-gray-200 text-gray-700 font-medium hover:bg-gray-50 transition-colors flex items-center justify-center gap-2"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
            Google
          </button>
          
          <button 
            type="button"
            class="h-11 rounded-lg border-2 border-gray-200 text-gray-700 font-medium hover:bg-gray-50 transition-colors flex items-center justify-center gap-2"
          >
            <svg class="w-5 h-5" fill="#1877F2" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            Facebook
          </button>
        </div>

        <!-- ENLACE A REGISTRO: Para usuarios nuevos -->
        <div class="mt-6 pt-6 border-t border-gray-200 text-center">
          <p class="text-sm text-gray-600">
            ¿No tienes una cuenta? 
            <a href="/registro" class="text-purple-600 font-semibold hover:text-purple-700 transition-colors">
              Crear cuenta gratis
            </a>
          </p>
        </div>
      </div>
    </div>

    <!-- FOOTER DE SEGURIDAD: Información SSL -->
    <div class="mt-6 text-center">
      <p class="text-xs text-gray-500 flex items-center justify-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
        </svg>
        Tu información está protegida con encriptación SSL
      </p>
    </div>
  </div>
</div>

<!-- JAVASCRIPT ESPECÍFICO: Manejo de CAPTCHA, ojito y recordarme -->
<script src="/js/login.js"></script>

</body>
</html>
