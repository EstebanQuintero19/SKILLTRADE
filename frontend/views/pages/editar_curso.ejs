<% layout('layout') %>

<div class="max-w-4xl mx-auto px-4 sm:px-8 py-10">
  <!-- Header -->
  <div class="mb-10">
    <nav class="flex items-center gap-2 text-sm text-gray-400 mb-4">
      <a href="/cursos" class="hover:text-[#5a1593] transition-colors font-medium">Cursos</a>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
      <a href="/curso/<%= curso?._id %>" class="hover:text-[#5a1593] transition-colors font-medium"><%= curso?.titulo %></a>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
      <span class="text-[#151117] font-semibold">Editar</span>
    </nav>
    <h1 class="text-4xl font-extrabold text-[#151117] tracking-tight">Editar Curso</h1>
    <p class="text-gray-500 mt-2">Actualiza la información de tu curso para que destaque en la plataforma.</p>
  </div>

  <!-- Formulario -->
  <form method="post" action="/curso/<%= curso?._id %>/editar" enctype="application/x-www-form-urlencoded" class="space-y-8">
    <!-- Información básica -->
    <section class="bg-white rounded-2xl shadow-lg border border-[#edeaf0] p-8">
      <h2 class="text-2xl font-bold text-[#151117] mb-8 flex items-center gap-3">
        <div class="w-10 h-10 bg-[#5a1593] rounded-lg flex items-center justify-center shadow">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        Información Básica
      </h2>
      <div class="grid md:grid-cols-2 gap-6">
        <!-- Título -->
        <div>
          <label class="block text-sm font-semibold text-[#151117] mb-2">
            Título del curso <span class="text-red-500">*</span>
          </label>
          <input 
            class="w-full h-12 rounded-lg border border-[#edeaf0] px-4 focus:outline-none focus:ring-2 focus:ring-[#5a1593] focus:border-transparent transition-all text-base" 
            name="titulo" 
            value="<%= curso?.titulo %>" 
            placeholder="Ej: Desarrollo Web Completo con React"
            required 
          />
        </div>
        <!-- Categorías -->
        <div>
          <label class="block text-sm font-semibold text-[#151117] mb-2">
            Categorías
          </label>
          <input 
            class="w-full h-12 rounded-lg border border-[#edeaf0] px-4 focus:outline-none focus:ring-2 focus:ring-[#5a1593] focus:border-transparent transition-all text-base" 
            name="categoria" 
            value="<%= (curso?.categoria||[]).join(',') %>" 
            placeholder="Programación, Diseño Web, Frontend"
          />
          <p class="text-xs text-gray-400 mt-1">Separa múltiples categorías con comas</p>
        </div>
        <!-- Descripción -->
        <div class="md:col-span-2">
          <label class="block text-sm font-semibold text-[#151117] mb-2">
            Descripción <span class="text-red-500">*</span>
          </label>
          <textarea 
            class="w-full rounded-lg border border-[#edeaf0] p-4 focus:outline-none focus:ring-2 focus:ring-[#5a1593] focus:border-transparent transition-all resize-none text-base" 
            name="descripcion" 
            rows="5" 
            placeholder="Describe de qué trata tu curso, qué aprenderán los estudiantes..."
            required
          ><%= curso?.descripcion %></textarea>
          <p class="text-xs text-gray-400 mt-1">Mínimo 50 caracteres recomendados</p>
        </div>
      </div>
    </section>

    <!-- Configuración del curso -->
    <section class="bg-white rounded-2xl shadow-lg border border-[#edeaf0] p-8">
      <h2 class="text-2xl font-bold text-[#151117] mb-8 flex items-center gap-3">
        <div class="w-10 h-10 bg-[#5a1593] rounded-lg flex items-center justify-center shadow">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
        </div>
        Configuración
      </h2>
      <div class="grid md:grid-cols-3 gap-6">
        <!-- Nivel -->
        <div>
          <label class="block text-sm font-semibold text-[#151117] mb-2">Nivel</label>
          <select 
            class="w-full h-12 rounded-lg border border-[#edeaf0] px-3 focus:outline-none focus:ring-2 focus:ring-[#5a1593] focus:border-transparent transition-all text-base" 
            name="nivel"
          >
            <option value="basico" <%= (curso?.nivel==='basico'?'selected':'') %>>🟢 Básico</option>
            <option value="intermedio" <%= (curso?.nivel==='intermedio'?'selected':'') %>>🟡 Intermedio</option>
            <option value="avanzado" <%= (curso?.nivel==='avanzado'?'selected':'') %>>🔴 Avanzado</option>
          </select>
        </div>
        <!-- Visibilidad -->
        <div>
          <label class="block text-sm font-semibold text-[#151117] mb-2">Visibilidad</label>
          <select 
            class="w-full h-12 rounded-lg border border-[#edeaf0] px-3 focus:outline-none focus:ring-2 focus:ring-[#5a1593] focus:border-transparent transition-all text-base" 
            name="visibilidad"
          >
            <option value="publico" <%= (curso?.visibilidad==='publico'?'selected':'') %>>🌐 Público</option>
            <option value="privado" <%= (curso?.visibilidad==='privado'?'selected':'') %>>🔒 Privado</option>
            <option value="soloSuscriptores" <%= (curso?.visibilidad==='soloSuscriptores'?'selected':'') %>>⭐ Solo suscriptores</option>
          </select>
        </div>
        <!-- Precio -->
        <div>
          <label class="block text-sm font-semibold text-[#151117] mb-2">Precio (USD)</label>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 font-medium">$</span>
            <input 
              class="w-full h-12 rounded-lg border border-[#edeaf0] pl-8 pr-4 focus:outline-none focus:ring-2 focus:ring-[#5a1593] focus:border-transparent transition-all text-base" 
              type="number" 
              step="0.01" 
              min="0"
              name="precio" 
              value="<%= curso?.precio || 0 %>" 
              placeholder="0.00"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Contenido adicional -->
    <section class="bg-white rounded-2xl shadow-lg border border-[#edeaf0] p-8">
      <h2 class="text-2xl font-bold text-[#151117] mb-8 flex items-center gap-3">
        <div class="w-10 h-10 bg-[#5a1593] rounded-lg flex items-center justify-center shadow">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z"/>
          </svg>
        </div>
        Contenido Adicional
      </h2>
      <div class="grid md:grid-cols-2 gap-6">
        <!-- Etiquetas -->
        <div>
          <label class="block text-sm font-semibold text-[#151117] mb-2">
            Etiquetas
          </label>
          <input 
            class="w-full h-12 rounded-lg border border-[#edeaf0] px-4 focus:outline-none focus:ring-2 focus:ring-[#5a1593] focus:border-transparent transition-all text-base" 
            name="etiquetas" 
            value="<%= (curso?.etiquetas||[]).join(',') %>" 
            placeholder="javascript, react, hooks, frontend"
          />
          <p class="text-xs text-gray-400 mt-1">Ayuda a los estudiantes a encontrar tu curso</p>
        </div>
        <!-- Video introductorio -->
        <div>
          <label class="block text-sm font-semibold text-[#151117] mb-2">
            Video Introductorio (URL)
          </label>
          <input 
            class="w-full h-12 rounded-lg border border-[#edeaf0] px-4 focus:outline-none focus:ring-2 focus:ring-[#5a1593] focus:border-transparent transition-all text-base" 
            name="videoIntroductorio" 
            type="url"
            value="<%= curso?.videoIntroductorio || '' %>" 
            placeholder="https://youtube.com/watch?v=..."
          />
          <p class="text-xs text-gray-400 mt-1">URL de YouTube, Vimeo u otra plataforma</p>
        </div>
      </div>
    </section>

    <!-- Acciones -->
    <div class="bg-white rounded-2xl shadow-lg border border-[#edeaf0] p-8 flex flex-wrap gap-4 items-center">
      <!-- Guardar -->
      <button 
        class="flex-1 min-w-[180px] py-3 px-6 rounded-lg bg-[#5a1593] text-white font-bold hover:bg-[#4a1275] transition-colors shadow-md hover:shadow-lg flex items-center justify-center gap-2 text-lg" 
        type="submit"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
        </svg>
        Guardar Cambios
      </button>
      <!-- Cancelar -->
      <a 
        href="/curso/<%= curso?._id %>" 
        class="flex-1 min-w-[180px] py-3 px-6 rounded-lg bg-[#eee8f3] text-[#5a1593] font-bold hover:bg-[#e0d5ed] transition-colors text-center flex items-center justify-center gap-2 text-lg"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
        Cancelar
      </a>
      <!-- Eliminar -->
      <button 
        type="button"
        onclick="if(confirm('¿Estás seguro de que quieres eliminar este curso? Esta acción no se puede deshacer.')) { document.getElementById('delete-form').submit(); }"
        class="flex-1 min-w-[180px] py-3 px-6 rounded-lg bg-red-50 text-red-600 font-bold hover:bg-red-100 transition-colors flex items-center justify-center gap-2 border border-red-200 text-lg"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
        </svg>
        Eliminar Curso
      </button>
    </div>
  </form>

  <!-- Formulario oculto para eliminar -->
  <form id="delete-form" method="post" action="/curso/<%= curso?._id %>/eliminar" class="hidden"></form>
</div>
