<!--
/**
 * PÁGINA EDITAR CURSO - SkillTrade Frontend
 * @author SkillTrade Team
 * @version 1.0.0
 * 
 * DESCRIPCIÓN:
 * Formulario de edición para cursos existentes. Permite modificar toda
 * la información del curso incluyendo título, descripción, precio,
 * categorías, nivel y configuraciones avanzadas.
 * 
 * SECCIONES PRINCIPALES:
 * - HEADER: Breadcrumb de navegación y título
 * - FORMULARIO: Campos pre-rellenados para edición
 * - VALIDACIONES: Validación de campos modificados
 * - ACCIONES: Guardar cambios o cancelar
 * 
 * CARACTERÍSTICAS TÉCNICAS:
 * - Formulario pre-rellenado con datos existentes
 * - Validación de permisos (propietario o admin)
 * - Breadcrumb de navegación contextual
 * - Estilos CSS inline personalizados
 * - Redirección inteligente según usuario
 * 
 * VARIABLES EJS:
 * - curso: Objeto con datos del curso a editar
 * 
 * ARCHIVOS RELACIONADOS:
 * - Estilos CSS inline para diseño específico
 */
-->
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Editar Curso - SkillTrade</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
  <style>
    body { 
      font-family: 'Inter', sans-serif; 
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
    }
    .card-shadow {
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    }
    .gradient-bg {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }
  </style>
</head>
<body>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!--HEADER - Breadcrumb y título de edición-->
  <div class="mb-8">
    <nav class="flex items-center gap-2 text-sm text-white/70 mb-6">
      <a href="/biblioteca" class="hover:text-white transition-colors flex items-center gap-1">
        <i class="fas fa-book"></i>
        Mi Biblioteca
      </a>
      <i class="fas fa-chevron-right text-xs"></i>
      <a href="/curso/<%= curso?._id %>" class="hover:text-white transition-colors"><%= curso?.titulo %></a>
      <i class="fas fa-chevron-right text-xs"></i>
      <span class="text-white font-medium">Editar</span>
    </nav>
    
    <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-6">
      <h1 class="text-4xl font-bold text-white mb-2 flex items-center gap-3">
        <i class="fas fa-edit text-3xl"></i>
        Editar Curso
      </h1>
      <p class="text-white/80 text-lg">Actualiza la información de "<%= curso?.titulo %>"</p>
    </div>
  </div>

  <!--FORMULARIO - Campos pre-rellenados para edición-->
  <form method="post" action="/curso/<%= curso?._id %>/editar" enctype="application/x-www-form-urlencoded">
    <!-- Información básica -->
    <div class="bg-white rounded-2xl card-shadow p-6 mb-6">
      <h2 class="text-xl font-bold text-[#151117] mb-6 flex items-center gap-2">
        <div class="w-8 h-8 bg-[#5a1593] rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        Información Básica
      </h2>

      <div class="space-y-4">
        <!-- Título -->
        <div>
          <label class="block text-sm font-medium text-[#151117] mb-2">
            Título del curso <span class="text-red-500">*</span>
          </label>
          <input 
            class="w-full h-11 rounded-lg border border-[#edeaf0] px-4 focus:outline-none focus:ring-2 focus:ring-[#5a1593] focus:border-transparent transition-all" 
            name="titulo" 
            value="<%= curso?.titulo %>" 
            placeholder="Ej: Desarrollo Web Completo con React"
            required 
          />
        </div>

        <!-- Descripción -->
        <div>
          <label class="block text-sm font-medium text-[#151117] mb-2">
            Descripción <span class="text-red-500">*</span>
          </label>
          <textarea 
            class="w-full rounded-lg border border-[#edeaf0] p-3 focus:outline-none focus:ring-2 focus:ring-[#5a1593] focus:border-transparent transition-all resize-none" 
            name="descripcion" 
            rows="5" 
            placeholder="Describe de qué trata tu curso, qué aprenderán los estudiantes..."
            required
          ><%= curso?.descripcion %></textarea>
          <p class="text-xs text-[#6f6880] mt-1">Mínimo 50 caracteres recomendados</p>
        </div>

        <!-- Categorías -->
        <div>
          <label class="block text-sm font-medium text-[#151117] mb-2">
            Categorías
          </label>
          <input 
            class="w-full h-11 rounded-lg border border-[#edeaf0] px-4 focus:outline-none focus:ring-2 focus:ring-[#5a1593] focus:border-transparent transition-all" 
            name="categoria" 
            value="<%= (curso?.categoria||[]).join(',') %>" 
            placeholder="Programación, Diseño Web, Frontend"
          />
          <p class="text-xs text-[#6f6880] mt-1">Separa múltiples categorías con comas</p>
        </div>
      </div>
    </div>

    <!-- Configuración del curso -->
    <div class="bg-white rounded-2xl card-shadow p-6 mb-6">
      <h2 class="text-xl font-bold text-[#151117] mb-6 flex items-center gap-2">
        <div class="w-8 h-8 bg-[#5a1593] rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
        </div>
        Configuración
      </h2>

      <div class="grid md:grid-cols-3 gap-4">
        <!-- Nivel -->
        <div>
          <label class="block text-sm font-medium text-[#151117] mb-2">Nivel</label>
          <select 
            class="w-full h-11 rounded-lg border border-[#edeaf0] px-3 focus:outline-none focus:ring-2 focus:ring-[#5a1593] focus:border-transparent transition-all" 
            name="nivel"
          >
            <option value="basico" <%= (curso?.nivel==='basico'?'selected':'') %>>🟢 Básico</option>
            <option value="intermedio" <%= (curso?.nivel==='intermedio'?'selected':'') %>>🟡 Intermedio</option>
            <option value="avanzado" <%= (curso?.nivel==='avanzado'?'selected':'') %>>🔴 Avanzado</option>
          </select>
        </div>

        <!-- Visibilidad -->
        <div>
          <label class="block text-sm font-medium text-[#151117] mb-2">Visibilidad</label>
          <select 
            class="w-full h-11 rounded-lg border border-[#edeaf0] px-3 focus:outline-none focus:ring-2 focus:ring-[#5a1593] focus:border-transparent transition-all" 
            name="visibilidad"
          >
            <option value="publico" <%= (curso?.visibilidad==='publico'?'selected':'') %>>🌐 Público</option>
            <option value="privado" <%= (curso?.visibilidad==='privado'?'selected':'') %>>🔒 Privado</option>
            <option value="soloSuscriptores" <%= (curso?.visibilidad==='soloSuscriptores'?'selected':'') %>>⭐ Solo suscriptores</option>
          </select>
        </div>

        <!-- Precio -->
        <div>
          <label class="block text-sm font-medium text-[#151117] mb-2">Precio (COP)</label>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[#6f6880] font-medium">$</span>
            <input 
              class="w-full h-11 rounded-lg border border-[#edeaf0] pl-8 pr-4 focus:outline-none focus:ring-2 focus:ring-[#5a1593] focus:border-transparent transition-all" 
              type="number" 
              step="0.01" 
              min="0"
              name="precio" 
              value="<%= curso?.precio || 0 %>" 
              placeholder="0.00"
            />
          </div>
        </div>
      </div>
    </div>

    <!-- Contenido adicional -->
    <div class="bg-white rounded-2xl card-shadow p-6 mb-6">
      <h2 class="text-xl font-bold text-[#151117] mb-6 flex items-center gap-2">
        <div class="w-8 h-8 bg-[#5a1593] rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z"/>
          </svg>
        </div>
        Contenido Adicional
      </h2>

      <div class="space-y-4">
        <!-- Etiquetas -->
        <div>
          <label class="block text-sm font-medium text-[#151117] mb-2">
            Etiquetas
          </label>
          <input 
            class="w-full h-11 rounded-lg border border-[#edeaf0] px-4 focus:outline-none focus:ring-2 focus:ring-[#5a1593] focus:border-transparent transition-all" 
            name="etiquetas" 
            value="<%= (curso?.etiquetas||[]).join(',') %>" 
            placeholder="javascript, react, hooks, frontend"
          />
          <p class="text-xs text-[#6f6880] mt-1">Ayuda a los estudiantes a encontrar tu curso</p>
        </div>

        <!-- Video introductorio -->
        <div>
          <label class="block text-sm font-medium text-[#151117] mb-2">
            Video Introductorio (URL)
          </label>
          <input 
            class="w-full h-11 rounded-lg border border-[#edeaf0] px-4 focus:outline-none focus:ring-2 focus:ring-[#5a1593] focus:border-transparent transition-all" 
            name="videoIntroductorio" 
            type="url"
            value="<%= curso?.videoIntroductorio || '' %>" 
            placeholder="https://youtube.com/watch?v=..."
          />
          <p class="text-xs text-[#6f6880] mt-1">URL de YouTube, Vimeo u otra plataforma</p>
        </div>
      </div>
    </div>

    <!-- Acciones -->
    <div class="bg-white rounded-2xl card-shadow p-6">
      <div class="flex flex-wrap gap-3">
        <!-- Guardar -->
        <button 
          class="flex-1 sm:flex-none py-3 px-6 rounded-xl bg-gradient-to-r from-purple-600 to-blue-600 text-white font-semibold hover:from-purple-700 hover:to-blue-700 transition-all duration-300 shadow-lg hover:shadow-xl flex items-center justify-center gap-2 transform hover:scale-105" 
          type="submit"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
          </svg>
          Guardar Cambios
        </button>

        <!-- Cancelar -->
        <a 
          href="/biblioteca" 
          class="flex-1 sm:flex-none py-3 px-6 rounded-xl bg-gray-100 text-gray-700 font-semibold hover:bg-gray-200 transition-all duration-300 text-center flex items-center justify-center gap-2 transform hover:scale-105"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
          Cancelar
        </a>

        <!-- Espaciador -->
        <div class="flex-1 hidden sm:block"></div>

        <!-- Eliminar -->
        <button 
          type="button"
          onclick="if(confirm('¿Estás seguro de que quieres eliminar este curso? Esta acción no se puede deshacer.')) { document.getElementById('delete-form').submit(); }"
          class="py-3 px-6 rounded-xl bg-red-50 text-red-600 font-semibold hover:bg-red-100 transition-all duration-300 flex items-center gap-2 border border-red-200 transform hover:scale-105"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
          </svg>
          Eliminar Curso
      </div>
    </div>
  </form>

  <!-- Formulario oculto para eliminar -->
  <form id="delete-form" method="post" action="/curso/<%= curso?._id %>/eliminar" class="hidden"></form>
</div>

</body>
</html>