<% layout('layout') %>

<section class="grid md:grid-cols-3 gap-6">
  <aside class="md:col-span-1 rounded-lg border border-[#edeaf0] p-4">
    <div class="w-24 h-24 rounded-full bg-cover bg-center mx-auto" style="background-image:url('<%= (usuario?.fotoUrl)||'https://via.placeholder.com/160' %>')"></div>
    <h1 class="mt-3 text-center text-xl font-extrabold text-[#151117]"><%= usuario?.nombre %></h1>
    <p class="text-center text-sm text-[#6f6880]"><%= usuario?.email %></p>
    <div class="mt-4 grid gap-2">
      <a href="/perfil/editar" class="h-9 px-3 rounded-lg bg-[#eee8f3] text-[#151117] text-sm font-semibold text-center">Editar perfil</a>
      <form method="post" action="/perfil/eliminar" onsubmit="return confirm('¿Eliminar cuenta definitivamente?');">
        <button class="h-9 w-full px-3 rounded-lg bg-red-600 text-white text-sm font-semibold">Eliminar cuenta</button>
      </form>
    </div>
  </aside>
  <div class="md:col-span-2 grid gap-6">
    <section class="rounded-lg border border-[#edeaf0] p-4">
      <h2 class="font-bold text-[#151117] mb-2">Biografía</h2>
      <p class="text-[#6f6880]"><%= usuario?.biografia || 'Sin biografía' %></p>
    </section>
    <section class="rounded-lg border border-[#edeaf0] p-4">
      <h2 class="font-bold text-[#151117] mb-3">Cambiar contraseña</h2>
      <form method="post" action="/perfil/password" class="grid md:grid-cols-3 gap-3">
        <input class="h-10 px-3 rounded-lg border border-[#edeaf0]" type="password" name="actual" placeholder="Actual" required />
        <input class="h-10 px-3 rounded-lg border border-[#edeaf0]" type="password" name="nueva" placeholder="Nueva" required />
        <button class="h-10 px-4 rounded-lg bg-[#5a1593] text-white font-semibold" type="submit">Actualizar</button>
      </form>
    </section>
  </div>
</section>

