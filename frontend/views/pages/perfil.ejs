<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mi Perfil - SkillTrade</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
    .gradient-bg { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
    .card-shadow { box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04); }
    .profile-card { background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%); }
  </style>
</head>
<body class="bg-gradient-to-br from-gray-50 to-gray-100 min-h-screen">

  <!-- Header con navegación -->
  <header class="gradient-bg shadow-lg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center py-4">
        <div class="flex items-center space-x-4">
          <a href="/" class="text-white hover:text-gray-200 transition-colors">
            <i class="fas fa-arrow-left text-lg"></i>
          </a>
          <h1 class="text-2xl font-bold text-white">Mi Perfil</h1>
        </div>
        <nav class="flex items-center space-x-6">
          <a href="/cursos" class="text-white hover:text-gray-200 transition-colors">
            <i class="fas fa-book-open mr-2"></i>Cursos
          </a>
          <a href="/logout" class="text-white hover:text-gray-200 transition-colors">
            <i class="fas fa-sign-out-alt mr-2"></i>Salir
          </a>
        </nav>
      </div>
    </div>
  </header>

  <!-- Contenido principal -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid lg:grid-cols-3 gap-8">
      
      <!-- Sidebar del perfil -->
      <aside class="lg:col-span-1">
        <div class="profile-card rounded-2xl card-shadow p-8 text-center">
          <!-- Foto de perfil -->
          <div class="relative inline-block">
            <div class="w-32 h-32 rounded-full bg-cover bg-center mx-auto border-4 border-white shadow-lg" 
                 style="background-image:url('<%= (usuario?.fotoUrl)||'https://via.placeholder.com/200' %>')">
            </div>
            <div class="absolute bottom-2 right-2 w-8 h-8 bg-green-500 rounded-full border-2 border-white"></div>
          </div>
          
          <!-- Información básica -->
          <h2 class="mt-6 text-2xl font-bold text-gray-800"><%= usuario?.nombre %></h2>
          <p class="text-gray-600 mt-2 flex items-center justify-center">
            <i class="fas fa-envelope mr-2 text-blue-500"></i>
            <%= usuario?.email %>
          </p>
          
          <% if (usuario?.telefono) { %>
          <p class="text-gray-600 mt-1 flex items-center justify-center">
            <i class="fas fa-phone mr-2 text-green-500"></i>
            <%= usuario.telefono %>
          </p>
          <% } %>
          
          <!-- Estadísticas -->
          <div class="grid grid-cols-2 gap-4 mt-6 pt-6 border-t border-gray-200">
            <div class="text-center">
              <div class="text-2xl font-bold text-blue-600">0</div>
              <div class="text-sm text-gray-600">Cursos</div>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-purple-600">0</div>
              <div class="text-sm text-gray-600">Intercambios</div>
            </div>
          </div>
          
          <!-- Botones de acción -->
          <div class="mt-8 space-y-3">
            <a href="/perfil/editar" 
               class="w-full inline-flex items-center justify-center px-4 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition-colors shadow-md">
              <i class="fas fa-edit mr-2"></i>
              Editar perfil
            </a>
            <form method="post" action="/perfil/eliminar" onsubmit="return confirm('¿Estás seguro de que deseas eliminar tu cuenta? Esta acción no se puede deshacer.');">
              <button type="submit" 
                      class="w-full inline-flex items-center justify-center px-4 py-3 bg-red-600 hover:bg-red-700 text-white font-semibold rounded-lg transition-colors shadow-md">
                <i class="fas fa-trash-alt mr-2"></i>
                Eliminar cuenta
              </button>
            </form>
          </div>
        </div>
      </aside>
      
      <!-- Contenido principal -->
      <div class="lg:col-span-2 space-y-8">
        
        <!-- Biografía -->
        <section class="bg-white rounded-2xl card-shadow p-8">
          <div class="flex items-center mb-6">
            <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mr-4">
              <i class="fas fa-user text-blue-600 text-xl"></i>
            </div>
            <h3 class="text-2xl font-bold text-gray-800">Biografía</h3>
          </div>
          
          <div class="bg-gray-50 rounded-lg p-6">
            <% if (usuario?.biografia) { %>
              <p class="text-gray-700 leading-relaxed"><%= usuario.biografia %></p>
            <% } else { %>
              <div class="text-center py-8">
                <i class="fas fa-user-edit text-gray-400 text-4xl mb-4"></i>
                <p class="text-gray-500 mb-4">Aún no has agregado una biografía</p>
                <a href="/perfil/editar" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                  <i class="fas fa-plus mr-2"></i>
                  Agregar biografía
                </a>
              </div>
            <% } %>
          </div>
        </section>
        
        <!-- Cambiar contraseña -->
        <section class="bg-white rounded-2xl card-shadow p-8">
          <div class="flex items-center mb-6">
            <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mr-4">
              <i class="fas fa-lock text-purple-600 text-xl"></i>
            </div>
            <h3 class="text-2xl font-bold text-gray-800">Seguridad</h3>
          </div>
          
          <div class="bg-gray-50 rounded-lg p-6">
            <h4 class="text-lg font-semibold text-gray-800 mb-4">Cambiar contraseña</h4>
            <form method="post" action="/perfil/password" class="space-y-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Contraseña actual</label>
                <div class="relative">
                  <input class="w-full h-12 pl-12 pr-4 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-transparent" 
                         type="password" name="actual" placeholder="Ingresa tu contraseña actual" required />
                  <i class="fas fa-key absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                </div>
              </div>
              
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Nueva contraseña</label>
                <div class="relative">
                  <input class="w-full h-12 pl-12 pr-4 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-transparent" 
                         type="password" name="nueva" placeholder="Ingresa tu nueva contraseña" required />
                  <i class="fas fa-lock absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                </div>
              </div>
              
              <button type="submit" 
                      class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 bg-purple-600 hover:bg-purple-700 text-white font-semibold rounded-lg transition-colors shadow-md">
                <i class="fas fa-save mr-2"></i>
                Actualizar contraseña
              </button>
            </form>
          </div>
        </section>
        
        <!-- Actividad reciente -->
        <section class="bg-white rounded-2xl card-shadow p-8">
          <div class="flex items-center mb-6">
            <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mr-4">
              <i class="fas fa-chart-line text-green-600 text-xl"></i>
            </div>
            <h3 class="text-2xl font-bold text-gray-800">Actividad reciente</h3>
          </div>
          
          <div class="bg-gray-50 rounded-lg p-6">
            <div class="text-center py-8">
              <i class="fas fa-history text-gray-400 text-4xl mb-4"></i>
              <p class="text-gray-500 mb-4">No hay actividad reciente</p>
              <p class="text-sm text-gray-400">Cuando realices acciones en la plataforma, aparecerán aquí</p>
            </div>
          </div>
        </section>
        
      </div>
    </div>
  </main>

</body>
</html>

