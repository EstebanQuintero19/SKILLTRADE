<!--
/**
 * VER USUARIO ADMIN - SkillTrade Frontend
 * @author SkillTrade Team
 * @version 1.0.0
 * 
 * DESCRIPCIÓN:
 * Página de administrador para ver información detallada de cualquier usuario.
 * Muestra perfil completo, estadísticas y acciones administrativas.
 * 
 * FUNCIONALIDADES:
 * - Ver información completa del usuario
 * - Estadísticas de actividad y cursos
 * - Acciones admin: editar, eliminar, suspender
 * - Breadcrumb de navegación admin
 * - Historial de actividad del usuario
 * 
 * VARIABLES EJS:
 * - title: Título de la página
 * - usuario: Objeto con datos completos del usuario
 * - estadisticas: Métricas del usuario
 */
-->
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - SkillTrade Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="/css/admin_ver_usuario.css">
</head>
<body class="bg-gray-50">
    <%- include('../partials/header') %>
    
    <!-- Header del Admin -->
    <div class="admin-gradient text-white py-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between">
                <div>
                    <nav class="flex items-center space-x-2 text-red-200 mb-4">
                        <a href="/admin" class="hover:text-white">Admin</a>
                        <i class="fas fa-chevron-right text-xs"></i>
                        <a href="/admin_usuarios" class="hover:text-white">Usuarios</a>
                        <i class="fas fa-chevron-right text-xs"></i>
                        <span class="text-white">Ver Perfil</span>
                    </nav>
                    <h1 class="text-3xl font-bold flex items-center">
                        <i class="fas fa-user-circle mr-3"></i>
                        Perfil de Usuario
                    </h1>
                    <p class="text-red-100 mt-2">Vista detallada del perfil desde panel administrativo</p>
                </div>
                <div class="flex space-x-3">
                    <a href="/admin_usuarios" 
                       class="inline-flex items-center px-4 py-2 bg-white/20 hover:bg-white/30 text-white font-medium rounded-lg transition-colors">
                        <i class="fas fa-arrow-left mr-2"></i>
                        Volver a Usuarios
                    </a>
                    <% if (usuario && usuario.email !== 'skilltrade_admin@gmail.com') { %>
                    <a href="/admin/usuario/<%= usuario._id %>/editar" 
                       class="inline-flex items-center px-4 py-2 bg-yellow-600 hover:bg-yellow-700 text-white font-medium rounded-lg transition-colors">
                        <i class="fas fa-edit mr-2"></i>
                        Editar Usuario
                    </a>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- Contenido Principal -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-6">
        <% if (usuario) { %>
        <!-- Perfil del Usuario -->
        <div class="bg-white rounded-xl card-shadow overflow-hidden mb-8">
            <!-- Header del perfil -->
            <div class="bg-gradient-to-r from-red-600 to-red-700 px-8 py-6">
                <div class="flex flex-col md:flex-row items-center gap-6">
                    <!-- Avatar -->
                    <div class="relative">
                        <div class="w-24 h-24 md:w-32 md:h-32 rounded-full profile-avatar border-4 border-white shadow-lg flex items-center justify-center">
                            <% if (usuario.fotoUrl && usuario.fotoUrl !== 'https://via.placeholder.com/200') { %>
                                <img src="<%= usuario.fotoUrl %>" alt="<%= usuario.nombre %>" class="w-full h-full rounded-full object-cover">
                            <% } else { %>
                                <i class="fas fa-user text-white text-3xl md:text-4xl"></i>
                            <% } %>
                        </div>
                        
                        <!-- Badge de tipo de usuario -->
                        <div class="absolute -bottom-2 -right-2">
                            <% if (usuario.email === 'skilltrade_admin@gmail.com') { %>
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800 border-2 border-white">
                                    <i class="fas fa-crown mr-1"></i>
                                    Admin
                                </span>
                            <% } else { %>
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800 border-2 border-white">
                                    <i class="fas fa-user mr-1"></i>
                                    Usuario
                                </span>
                            <% } %>
                        </div>
                    </div>
                    
                    <!-- Información básica -->
                    <div class="text-center md:text-left text-white flex-1">
                        <h2 class="text-2xl md:text-3xl font-bold mb-2"><%= usuario.nombre || 'Sin nombre' %></h2>
                        <p class="text-red-100 text-lg mb-2 flex items-center justify-center md:justify-start">
                            <i class="fas fa-envelope mr-2"></i>
                            <%= usuario.email %>
                        </p>
                        <% if (usuario.telefono) { %>
                        <p class="text-red-100 flex items-center justify-center md:justify-start">
                            <i class="fas fa-phone mr-2"></i>
                            <%= usuario.telefono %>
                        </p>
                        <% } %>
                    </div>
                    
                    <!-- Estado de visibilidad -->
                    <div class="text-center">
                        <div class="mb-2">
                            <% if (usuario.visibilidad === 'publico') { %>
                                <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-medium bg-green-100 text-green-800">
                                    <i class="fas fa-globe mr-2"></i>
                                    Perfil Público
                                </span>
                            <% } else { %>
                                <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-medium bg-gray-100 text-gray-800">
                                    <i class="fas fa-lock mr-2"></i>
                                    Perfil Privado
                                </span>
                            <% } %>
                        </div>
                        <div class="text-red-100 text-sm">
                            Miembro desde <%= new Date(usuario.fechaRegistro || usuario.fechaCreacion).toLocaleDateString('es-ES') %>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Información detallada -->
            <div class="p-8">
                <div class="grid md:grid-cols-2 gap-8">
                    
                    <!-- Información Personal -->
                    <div class="space-y-6">
                        <div>
                            <h3 class="text-lg font-bold text-gray-800 mb-4 flex items-center">
                                <i class="fas fa-user text-blue-600 mr-2"></i>
                                Información Personal
                            </h3>
                            
                            <div class="space-y-4">
                                <div class="bg-gray-50 rounded-lg p-4">
                                    <div class="flex justify-between items-center">
                                        <span class="text-sm font-medium text-gray-600">ID de Usuario</span>
                                        <span class="text-sm text-gray-800 font-mono"><%= usuario._id %></span>
                                    </div>
                                </div>
                                
                                <div class="bg-gray-50 rounded-lg p-4">
                                    <div class="flex justify-between items-center">
                                        <span class="text-sm font-medium text-gray-600">Nombre Completo</span>
                                        <span class="text-sm text-gray-800"><%= usuario.nombre || 'No especificado' %></span>
                                    </div>
                                </div>
                                
                                <div class="bg-gray-50 rounded-lg p-4">
                                    <div class="flex justify-between items-center">
                                        <span class="text-sm font-medium text-gray-600">Email</span>
                                        <span class="text-sm text-gray-800"><%= usuario.email %></span>
                                    </div>
                                </div>
                                
                                <div class="bg-gray-50 rounded-lg p-4">
                                    <div class="flex justify-between items-center">
                                        <span class="text-sm font-medium text-gray-600">Teléfono</span>
                                        <span class="text-sm text-gray-800"><%= usuario.telefono || 'No especificado' %></span>
                                    </div>
                                </div>
                                
                                <div class="bg-gray-50 rounded-lg p-4">
                                    <div class="flex justify-between items-center">
                                        <span class="text-sm font-medium text-gray-600">Fecha de Registro</span>
                                        <span class="text-sm text-gray-800">
                                            <%= new Date(usuario.fechaRegistro || usuario.fechaCreacion).toLocaleDateString('es-ES', { 
                                                year: 'numeric', 
                                                month: 'long', 
                                                day: 'numeric',
                                                hour: '2-digit',
                                                minute: '2-digit'
                                            }) %>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Configuración y Preferencias -->
                    <div class="space-y-6">
                        <div>
                            <h3 class="text-lg font-bold text-gray-800 mb-4 flex items-center">
                                <i class="fas fa-cog text-purple-600 mr-2"></i>
                                Configuración
                            </h3>
                            
                            <div class="space-y-4">
                                <div class="bg-gray-50 rounded-lg p-4">
                                    <div class="flex justify-between items-center">
                                        <span class="text-sm font-medium text-gray-600">Visibilidad del Perfil</span>
                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium <%= usuario.visibilidad === 'publico' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
                                            <i class="fas <%= usuario.visibilidad === 'publico' ? 'fa-globe' : 'fa-lock' %> mr-1"></i>
                                            <%= usuario.visibilidad === 'publico' ? 'Público' : 'Privado' %>
                                        </span>
                                    </div>
                                </div>
                                
                                <% if (usuario.preferencias) { %>
                                <div class="bg-gray-50 rounded-lg p-4">
                                    <div class="flex justify-between items-center">
                                        <span class="text-sm font-medium text-gray-600">Notificaciones por Email</span>
                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium <%= usuario.preferencias.notificaciones_email ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                                            <i class="fas <%= usuario.preferencias.notificaciones_email ? 'fa-check' : 'fa-times' %> mr-1"></i>
                                            <%= usuario.preferencias.notificaciones_email ? 'Activadas' : 'Desactivadas' %>
                                        </span>
                                    </div>
                                </div>
                                
                                <div class="bg-gray-50 rounded-lg p-4">
                                    <div class="flex justify-between items-center">
                                        <span class="text-sm font-medium text-gray-600">Notificaciones de Cursos</span>
                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium <%= usuario.preferencias.notificaciones_cursos ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                                            <i class="fas <%= usuario.preferencias.notificaciones_cursos ? 'fa-check' : 'fa-times' %> mr-1"></i>
                                            <%= usuario.preferencias.notificaciones_cursos ? 'Activadas' : 'Desactivadas' %>
                                        </span>
                                    </div>
                                </div>
                                <% } %>
                                
                                <div class="bg-gray-50 rounded-lg p-4">
                                    <div class="flex justify-between items-center">
                                        <span class="text-sm font-medium text-gray-600">Tipo de Cuenta</span>
                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium <%= usuario.email === 'skilltrade_admin@gmail.com' ? 'bg-red-100 text-red-800' : 'bg-blue-100 text-blue-800' %>">
                                            <i class="fas <%= usuario.email === 'skilltrade_admin@gmail.com' ? 'fa-shield-alt' : 'fa-user' %> mr-1"></i>
                                            <%= usuario.email === 'skilltrade_admin@gmail.com' ? 'Administrador' : 'Usuario Regular' %>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Biografía -->
                <div class="mt-8">
                    <h3 class="text-lg font-bold text-gray-800 mb-4 flex items-center">
                        <i class="fas fa-quote-left text-green-600 mr-2"></i>
                        Biografía
                    </h3>
                    
                    <% if (usuario.biografia) { %>
                        <div class="bg-gradient-to-r from-green-50 to-blue-50 rounded-lg p-6 border border-green-100">
                            <p class="text-gray-700 leading-relaxed"><%= usuario.biografia %></p>
                        </div>
                    <% } else { %>
                        <div class="bg-gray-50 rounded-lg p-6 text-center">
                            <i class="fas fa-user-edit text-gray-400 text-3xl mb-3"></i>
                            <p class="text-gray-500">Este usuario no ha agregado una biografía</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
        
        <% } else { %>
        <!-- Usuario no encontrado -->
        <div class="bg-white rounded-xl card-shadow p-12 text-center">
            <i class="fas fa-user-slash text-gray-400 text-6xl mb-6"></i>
            <h2 class="text-2xl font-bold text-gray-800 mb-4">Usuario no encontrado</h2>
            <p class="text-gray-600 mb-8">El usuario que intentas ver no existe o ha sido eliminado.</p>
            <a href="/admin_usuarios" 
               class="inline-flex items-center px-6 py-3 bg-red-600 hover:bg-red-700 text-white font-semibold rounded-lg transition-colors">
                <i class="fas fa-arrow-left mr-2"></i>
                Volver a Usuarios
            </a>
        </div>
        <% } %>
    </div>

    <div class="py-8"></div>

    <script>
        // Pasar datos de sesión al JavaScript externo
        var signedIn = <%= locals.signedIn ? 'true' : 'false' %>;
        var token = '<%= locals.token || '' %>';
        var user = <%- locals.user ? JSON.stringify(locals.user) : 'null' %>;
    </script>
    <script src="/js/admin_ver_usuario.js"></script>
</body>
</html>
