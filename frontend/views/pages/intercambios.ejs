<% layout('layout') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  
  <!-- Header -->
  <section class="mb-8">
    <div class="flex items-start justify-between mb-4">
      <div>
        <h1 class="text-4xl font-bold text-[#151117] mb-2">Gestión de Intercambios</h1>
        <p class="text-[#6f6880]">Administra todas las solicitudes de intercambio, aprobaciones y rechazos</p>
      </div>
      <div class="flex items-center gap-2 px-4 py-2 rounded-lg bg-[#f5f2f8]">
        <svg class="w-5 h-5 text-[#5a1593]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
        </svg>
        <span class="font-semibold text-[#151117]"><%= (exchanges || []).length %></span>
        <span class="text-sm text-[#6f6880]">intercambios</span>
      </div>
    </div>

    <!-- Búsqueda y filtros -->
    <div class="bg-white rounded-xl shadow-sm border border-[#edeaf0] p-6">
      <!-- Búsqueda -->
      <div class="relative mb-4">
        <input 
          id="search" 
          class="w-full h-12 rounded-lg border border-[#edeaf0] pl-12 pr-4 focus:outline-none focus:ring-2 focus:ring-[#5a1593] focus:border-transparent transition-all" 
          placeholder="Buscar por usuario o curso..." 
        />
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 text-[#9a92ad] pointer-events-none" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 256 256">
          <path fill="currentColor" d="M229.66 218.34l-50.07-50.06a88.11 88.11 0 1 0-11.31 11.31l50.06 50.07a8 8 0 0 0 11.32-11.32ZM40 112a72 72 0 1 1 72 72a72.08 72.08 0 0 1-72-72Z"/>
        </svg>
      </div>

      <!-- Filtros -->
      <div class="flex flex-wrap gap-3">
        <div class="flex-1 min-w-[200px]">
          <label class="block text-sm font-medium text-[#6f6880] mb-1">Estado</label>
          <select 
            id="f-status" 
            class="w-full h-10 rounded-lg border border-[#edeaf0] px-3 focus:outline-none focus:ring-2 focus:ring-[#5a1593] focus:border-transparent transition-all"
          >
            <option value="">Todos los estados</option>
            <option value="pendiente">Pendiente</option>
            <option value="aceptado">Aprobado</option>
            <option value="rechazado">Rechazado</option>
            <option value="cancelado">Cancelado</option>
          </select>
        </div>

        <div class="flex-1 min-w-[200px]">
          <label class="block text-sm font-medium text-[#6f6880] mb-1">Curso</label>
          <select 
            id="f-curso" 
            class="w-full h-10 rounded-lg border border-[#edeaf0] px-3 focus:outline-none focus:ring-2 focus:ring-[#5a1593] focus:border-transparent transition-all"
          >
            <option value="">Todos los cursos</option>
            <% if (exchanges && exchanges.length > 0) { %>
              <% const cursos = new Set(); %>
              <% exchanges.forEach(x => { %>
                <% if (x.cursoEmisor?.titulo) cursos.add(x.cursoEmisor.titulo); %>
                <% if (x.cursoReceptor?.titulo) cursos.add(x.cursoReceptor.titulo); %>
              <% }); %>
              <% Array.from(cursos).sort().forEach(curso => { %>
                <option value="<%= curso %>"><%= curso %></option>
              <% }); %>
            <% } %>
          </select>
        </div>

        <div class="flex items-end">
          <button 
            id="clear-filters"
            class="h-10 px-4 rounded-lg bg-[#eee8f3] text-[#5a1593] font-medium hover:bg-[#e0d5ed] transition-colors text-sm"
          >
            Limpiar
          </button>
        </div>
      </div>

      <!-- Contador de resultados -->
      <div class="mt-4 pt-4 border-t border-[#edeaf0]">
        <p class="text-sm text-[#6f6880]">
          Mostrando <span id="results-count"><%= (exchanges || []).length %></span> de <%= (exchanges || []).length %> intercambios
        </p>
      </div>
    </div>
  </section>

  <!-- Tabla de intercambios -->
  <div class="bg-white rounded-xl shadow-sm border border-[#edeaf0] overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-[#f5f2f8] border-b border-[#edeaf0]">
          <tr>
            <th class="px-6 py-4 text-left font-semibold text-[#151117]">Usuario 1</th>
            <th class="px-6 py-4 text-left font-semibold text-[#151117]">Curso Ofrecido</th>
            <th class="px-6 py-4 text-left font-semibold text-[#151117]">Usuario 2</th>
            <th class="px-6 py-4 text-left font-semibold text-[#151117]">Curso Solicitado</th>
            <th class="px-6 py-4 text-left font-semibold text-[#151117]">Fecha</th>
            <th class="px-6 py-4 text-left font-semibold text-[#151117]">Estado</th>
            <th class="px-6 py-4 text-left font-semibold text-[#151117]">Acciones</th>
          </tr>
        </thead>
        <tbody id="rows">
          <% if (exchanges && exchanges.length > 0) { %>
            <% exchanges.forEach((x, index) => { %>
              <tr class="border-t border-[#edeaf0] hover:bg-gray-50 transition-colors" data-status="<%= x.estado || 'pendiente' %>">
                <!-- Usuario 1 -->
                <td class="px-6 py-4">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-gradient-to-br from-[#5a1593] to-[#8b4dbf] flex items-center justify-center text-white font-semibold text-sm">
                      <%= (x.emisor?.nombre || 'U').charAt(0).toUpperCase() %>
                    </div>
                    <div>
                      <p class="font-medium text-[#151117]"><%= x.emisor?.nombre || 'Usuario desconocido' %></p>
                      <p class="text-xs text-[#6f6880]"><%= x.emisor?.email || '-' %></p>
                    </div>
                  </div>
                </td>

                <!-- Curso 1 -->
                <td class="px-6 py-4">
                  <div class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-[#5a1593] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                    </svg>
                    <span class="text-[#5a1593] font-medium"><%= x.cursoEmisor?.titulo || 'Curso no especificado' %></span>
                  </div>
                </td>

                <!-- Usuario 2 -->
                <td class="px-6 py-4">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-gradient-to-br from-teal-500 to-teal-700 flex items-center justify-center text-white font-semibold text-sm">
                      <%= (x.receptor?.nombre || 'U').charAt(0).toUpperCase() %>
                    </div>
                    <div>
                      <p class="font-medium text-[#151117]"><%= x.receptor?.nombre || 'Usuario desconocido' %></p>
                      <p class="text-xs text-[#6f6880]"><%= x.receptor?.email || '-' %></p>
                    </div>
                  </div>
                </td>

                <!-- Curso 2 -->
                <td class="px-6 py-4">
                  <div class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-[#5a1593] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                    </svg>
                    <span class="text-[#5a1593] font-medium"><%= x.cursoReceptor?.titulo || 'Curso no especificado' %></span>
                  </div>
                </td>

                <!-- Fecha -->
                <td class="px-6 py-4">
                  <div class="flex items-center gap-2 text-[#6f6880]">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                    <%= new Date(x.fechaSolicitud || x.createdAt).toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                  </div>
                </td>

                <!-- Estado -->
                <td class="px-6 py-4">
                  <% 
                    const estado = x.estado || 'pendiente';
                    let colorClass = 'bg-yellow-100 text-yellow-800';
                    let icon = '⏳';
                    if (estado === 'aceptado') {
                      colorClass = 'bg-green-100 text-green-800';
                      icon = '✓';
                    } else if (estado === 'rechazado') {
                      colorClass = 'bg-red-100 text-red-800';
                      icon = '✕';
                    } else if (estado === 'cancelado') {
                      colorClass = 'bg-gray-100 text-gray-800';
                      icon = '⊘';
                    }
                  %>
                  <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold <%= colorClass %>">
                    <span><%= icon %></span>
                    <span class="capitalize"><%= estado %></span>
                  </span>
                </td>

                <!-- Acciones -->
                <td class="px-6 py-4">
                  <% if (estado === 'pendiente') { %>
                    <div class="flex items-center gap-2">
                      <form method="post" action="<%= API_BASE %>/api/exchanges/<%= x._id %>/aceptar" class="inline">
                        <button 
                          type="submit"
                          class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-green-50 text-green-700 text-xs font-medium hover:bg-green-100 transition-colors border border-green-200"
                          title="Aprobar intercambio"
                        >
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                          </svg>
                          Aprobar
                        </button>
                      </form>
                      <form method="post" action="<%= API_BASE %>/api/exchanges/<%= x._id %>/rechazar" class="inline">
                        <button 
                          type="submit"
                          class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-red-50 text-red-700 text-xs font-medium hover:bg-red-100 transition-colors border border-red-200"
                          title="Rechazar intercambio"
                        >
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                          </svg>
                          Rechazar
                        </button>
                      </form>
                    </div>
                  <% } else { %>
                    <span class="text-xs text-[#6f6880] italic">Sin acciones</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Sin resultados -->
    <% if (!exchanges || exchanges.length === 0) { %>
      <div class="p-12 text-center">
        <div class="w-24 h-24 bg-[#f5f2f8] rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-12 h-12 text-[#6f6880]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-[#151117] mb-3">No hay intercambios</h3>
        <p class="text-[#6f6880]">No se han realizado solicitudes de intercambio aún</p>
      </div>
    <% } %>

    <!-- Sin resultados de búsqueda -->
    <div id="no-results" class="hidden p-12 text-center">
      <div class="w-24 h-24 bg-[#f5f2f8] rounded-full flex items-center justify-center mx-auto mb-6">
        <svg class="w-12 h-12 text-[#6f6880]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </div>
      <h3 class="text-2xl font-bold text-[#151117] mb-3">No se encontraron resultados</h3>
      <p class="text-[#6f6880] mb-6">Intenta ajustar los filtros de búsqueda</p>
      <button 
        id="clear-filters-empty"
        class="inline-block py-3 px-8 rounded-lg bg-[#5a1593] text-white font-semibold hover:bg-[#4a1275] transition-colors"
      >
        Limpiar Filtros
      </button>
    </div>
  </div>
</div>

<script>
  const rows = Array.from(document.querySelectorAll('#rows tr'));
  const tbody = document.getElementById('rows');
  const noResults = document.getElementById('no-results');
  const q = document.getElementById('search');
  const status = document.getElementById('f-status');
  const curso = document.getElementById('f-curso');
  const clearBtn = document.getElementById('clear-filters');
  const clearBtnEmpty = document.getElementById('clear-filters-empty');
  const resultsCount = document.getElementById('results-count');

  function filter() {
    const text = (q.value || '').toLowerCase().trim();
    const s = (status.value || '').toLowerCase();
    const c = (curso.value || '').toLowerCase();
    let visibleCount = 0;

    rows.forEach(r => {
      const rowText = r.textContent.toLowerCase();
      const okText = !text || rowText.includes(text);
      const okStatus = !s || r.dataset.status === s;
      const okCurso = !c || rowText.includes(c);
      const isVisible = okText && okStatus && okCurso;
      
      r.style.display = isVisible ? '' : 'none';
      if (isVisible) visibleCount++;
    });

    // Actualizar contador y mostrar/ocultar mensaje de sin resultados
    resultsCount.textContent = visibleCount;
    
    if (visibleCount === 0 && rows.length > 0) {
      tbody.classList.add('hidden');
      noResults.classList.remove('hidden');
    } else {
      tbody.classList.remove('hidden');
      noResults.classList.add('hidden');
    }
  }

  function clearFilters() {
    q.value = '';
    status.value = '';
    curso.value = '';
    filter();
  }

  q.addEventListener('input', filter);
  status.addEventListener('change', filter);
  curso.addEventListener('change', filter);
  clearBtn.addEventListener('click', clearFilters);
  if (clearBtnEmpty) {
    clearBtnEmpty.addEventListener('click', clearFilters);
  }
</script>