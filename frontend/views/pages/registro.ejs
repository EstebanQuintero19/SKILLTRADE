<% layout('layout') %>

<div class="mx-auto max-w-lg bg-white rounded-2xl shadow-2xl p-10 mt-12 mb-12 border border-gray-100">
  <div class="text-center mb-10">
    <h1 class="text-4xl font-extrabold text-gray-900 tracking-tight">Crear cuenta</h1>
    <p class="text-lg text-gray-500 mt-3">Únete y comienza a disfrutar de todos los beneficios</p>
  </div>

  <form class="space-y-7" method="post" action="/registro" id="registerForm">
    <!-- Nombre completo -->
    <label class="block">
      <span class="text-base font-semibold text-gray-800">Nombre completo <span class="text-red-500">*</span></span>
      <input 
        class="w-full h-12 rounded-lg border border-gray-300 px-4 mt-2 focus:outline-none focus:ring-2 focus:ring-purple-700 focus:border-transparent transition placeholder-gray-400 text-base"
        type="text" 
        name="nombre" 
        id="nombre"
        placeholder="Juan Pérez"
        required 
        minlength="3"
      />
      <span class="text-xs text-red-600 hidden" id="nombreError"></span>
    </label>

    <!-- Correo electrónico -->
    <label class="block">
      <span class="text-base font-semibold text-gray-800">Correo electrónico <span class="text-red-500">*</span></span>
      <div class="relative mt-2">
        <input 
          class="w-full h-12 rounded-lg border border-gray-300 px-4 pr-12 focus:outline-none focus:ring-2 focus:ring-purple-700 focus:border-transparent transition placeholder-gray-400 text-base"
          type="email" 
          name="email" 
          id="email"
          placeholder="correo@ejemplo.com"
          required 
        />
        <svg class="absolute right-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400 pointer-events-none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
          <path fill="currentColor" d="M224 48H32a8 8 0 0 0-8 8v136a16 16 0 0 0 16 16h176a16 16 0 0 0 16-16V56a8 8 0 0 0-8-8Zm-96 85.15L52.57 64h150.86ZM98.71 128L40 181.81V74.19Zm11.84 10.85l12 11.05a8 8 0 0 0 10.82 0l12-11.05l58 53.15H52.57ZM157.29 128L216 74.18v107.64Z"/>
        </svg>
      </div>
      <span class="text-xs text-red-600 hidden" id="emailError"></span>
    </label>

    <!-- Contraseña -->
    <label class="block">
      <span class="text-base font-semibold text-gray-800">Contraseña <span class="text-red-500">*</span></span>
      <div class="relative mt-2">
        <input 
          class="w-full h-12 rounded-lg border border-gray-300 px-4 pr-12 focus:outline-none focus:ring-2 focus:ring-purple-700 focus:border-transparent transition placeholder-gray-400 text-base"
          type="password" 
          name="password" 
          id="password"
          placeholder="Mínimo 8 caracteres"
          required 
          minlength="8"
        />
        <button type="button" class="toggle-password absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-purple-700" data-target="password">
          <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
            <path fill="currentColor" d="M247.31 124.76c-.35-.79-8.82-19.58-27.65-38.41C194.57 61.26 162.88 48 128 48S61.43 61.26 36.34 86.35C17.51 105.18 9 124 8.69 124.76a8 8 0 0 0 0 6.5c.35.79 8.82 19.57 27.65 38.4C61.43 194.74 93.12 208 128 208s66.57-13.26 91.66-38.34c18.83-18.83 27.3-37.61 27.65-38.4a8 8 0 0 0 0-6.5ZM128 192c-30.78 0-57.67-11.19-79.93-33.25A133.47 133.47 0 0 1 25 128a133.33 133.33 0 0 1 23.07-30.75C70.33 75.19 97.22 64 128 64s57.67 11.19 79.93 33.25A133.46 133.46 0 0 1 231.05 128c-7.21 13.46-38.62 64-103.05 64Zm0-112a48 48 0 1 0 48 48a48.05 48.05 0 0 0-48-48Zm0 80a32 32 0 1 1 32-32a32 32 0 0 1-32 32Z"/>
          </svg>
        </button>
      </div>
      <div id="passwordStrength" class="hidden mt-2">
        <div class="flex gap-1 mb-1">
          <div class="h-1 flex-1 rounded-full bg-gray-200" id="strength1"></div>
          <div class="h-1 flex-1 rounded-full bg-gray-200" id="strength2"></div>
          <div class="h-1 flex-1 rounded-full bg-gray-200" id="strength3"></div>
          <div class="h-1 flex-1 rounded-full bg-gray-200" id="strength4"></div>
        </div>
        <p id="strengthText" class="text-xs text-gray-500"></p>
      </div>
      <span class="text-xs text-red-600 hidden" id="passwordError"></span>
    </label>

    <!-- Confirmar contraseña -->
    <label class="block">
      <span class="text-base font-semibold text-gray-800">Confirmar contraseña <span class="text-red-500">*</span></span>
      <div class="relative mt-2">
        <input 
          class="w-full h-12 rounded-lg border border-gray-300 px-4 pr-12 focus:outline-none focus:ring-2 focus:ring-purple-700 focus:border-transparent transition placeholder-gray-400 text-base"
          type="password" 
          name="confirmPassword" 
          id="confirmPassword"
          placeholder="Repite tu contraseña"
          required 
          minlength="8"
        />
        <button type="button" class="toggle-password absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-purple-700" data-target="confirmPassword">
          <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
            <path fill="currentColor" d="M247.31 124.76c-.35-.79-8.82-19.58-27.65-38.41C194.57 61.26 162.88 48 128 48S61.43 61.26 36.34 86.35C17.51 105.18 9 124 8.69 124.76a8 8 0 0 0 0 6.5c.35.79 8.82 19.57 27.65 38.4C61.43 194.74 93.12 208 128 208s66.57-13.26 91.66-38.34c18.83-18.83 27.3-37.61 27.65-38.4a8 8 0 0 0 0-6.5ZM128 192c-30.78 0-57.67-11.19-79.93-33.25A133.47 133.47 0 0 1 25 128a133.33 133.33 0 0 1 23.07-30.75C70.33 75.19 97.22 64 128 64s57.67 11.19 79.93 33.25A133.46 133.46 0 0 1 231.05 128c-7.21 13.46-38.62 64-103.05 64Zm0-112a48 48 0 1 0 48 48a48.05 48.05 0 0 0-48-48Zm0 80a32 32 0 1 1 32-32a32 32 0 0 1-32 32Z"/>
          </svg>
        </button>
      </div>
      <span class="text-xs text-red-600 hidden" id="confirmError"></span>
    </label>

    <!-- Teléfono -->
    <label class="block">
      <span class="text-base font-semibold text-gray-800">Teléfono</span>
      <div class="relative mt-2">
        <input 
          class="w-full h-12 rounded-lg border border-gray-300 px-4 pr-12 focus:outline-none focus:ring-2 focus:ring-purple-700 focus:border-transparent transition placeholder-gray-400 text-base"
          type="tel" 
          name="telefono" 
          id="telefono"
          placeholder="+57 300 123 4567"
          pattern="[\+]?[0-9\s\-]+"
        />
        <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-5 h-5 text-[#9a92ad]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
          <path fill="currentColor" d="M222.37 158.46l-47.11-21.11l-.13-.06a16 16 0 0 0-15.17 1.4a8.12 8.12 0 0 0-.75.56L134.87 160c-15.42-7.49-31.34-23.29-38.83-38.51l20.78-24.71c.2-.25.39-.5.57-.77a16 16 0 0 0 1.32-15.06v-.12L97.54 33.64a16 16 0 0 0-16.62-9.52A56.26 56.26 0 0 0 32 80c0 79.4 64.6 144 144 144a56.26 56.26 0 0 0 55.88-48.92a16 16 0 0 0-9.51-16.62Z"/>
        </svg>
      </div>
      <span class="text-xs text-[#6f6880]">Opcional - para recuperar tu cuenta</span>
    </label>

    <!-- Biografía -->
    <label class="block">
      <span class="text-base font-semibold text-gray-800">Biografía</span>
      <textarea 
        class="w-full rounded-lg border border-gray-300 p-3 mt-2 focus:outline-none focus:ring-2 focus:ring-purple-700 focus:border-transparent resize-none text-base" 
        name="biografia" 
        id="biografia"
        rows="3"
        maxlength="300"
        placeholder="Cuéntanos algo sobre ti (opcional)"
      ></textarea>
      <div class="flex justify-between items-center mt-1">
        <span class="text-xs text-[#6f6880]">Opcional</span>
        <span id="bioCounter" class="text-xs text-[#9a92ad]">0/300</span>
      </div>
    </label>

    <!-- Términos y condiciones -->
    <label class="flex items-start gap-2 cursor-pointer">
      <input 
        type="checkbox" 
        name="acceptTerms" 
        id="acceptTerms"
        class="mt-1 w-4 h-4 rounded border-gray-300 text-purple-700 focus:ring-2 focus:ring-purple-700" 
        required 
      />
      <span class="text-sm text-[#6f6880]">
        Acepto los <a href="/terminos" class="text-purple-700 hover:underline">términos y condiciones</a> y la <a href="/privacidad" class="text-purple-700 hover:underline">política de privacidad</a>
      </span>
    </label>

    <!-- Botón de registro -->
    <button 
      class="w-full h-12 px-4 rounded-lg bg-purple-700 text-white font-semibold text-lg hover:bg-purple-800 transition-colors disabled:opacity-50 disabled:cursor-not-allowed shadow-md"
      type="submit"
      id="submitBtn"
    >
      Crear mi cuenta
    </button>

    <!-- Link a login -->
    <p class="text-center text-sm text-[#6f6880] mt-2">
      ¿Ya tienes cuenta? <a href="/login" class="text-purple-700 font-semibold hover:underline">Inicia sesión</a>
    </p>
  </form>

  <!-- Opciones de registro social (opcional) -->
  <div class="mt-8">
    <div class="relative">
      <div class="absolute inset-0 flex items-center">
        <div class="w-full border-t border-gray-200"></div>
      </div>
      <div class="relative flex justify-center text-sm">
        <span class="px-3 bg-white text-[#6f6880]">O regístrate con</span>
      </div>
    </div>

    <div class="mt-5 grid grid-cols-2 gap-4">
      <button type="button" class="h-11 px-4 rounded-lg border border-gray-200 text-gray-800 text-base font-semibold hover:bg-gray-50 transition-colors flex items-center justify-center gap-2 shadow-sm">
        <svg class="w-5 h-5" viewBox="0 0 24 24">
          <path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="currentColor" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="currentColor" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
          <path fill="currentColor" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
        Google
      </button>
      <button type="button" class="h-11 px-4 rounded-lg border border-gray-200 text-gray-800 text-base font-semibold hover:bg-gray-50 transition-colors flex items-center justify-center gap-2 shadow-sm">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2C6.477 2 2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.879V14.89h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.989C18.343 21.129 22 16.99 22 12c0-5.523-4.477-10-10-10z"/>
        </svg>
        Facebook
      </button>
    </div>
  </div>
</div>

<script>
  // ...tu script permanece igual...
</script>
