<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Crear Cuenta - SkillTrade</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body class="bg-gray-50 min-h-screen">

<div class="min-h-screen flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-md">
    <div class="bg-white rounded-2xl shadow-xl border border-gray-200 p-8">
      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Crear cuenta</h1>
        <p class="text-gray-600">Únete a SkillTrade y comienza a aprender</p>
      </div>
      
      <!-- Mensaje de error -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="mb-6 rounded-lg bg-red-50 border border-red-200 p-4 flex items-start gap-3">
          <svg class="w-5 h-5 text-red-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <div>
            <p class="text-sm font-medium text-red-800">Error al crear cuenta</p>
            <p class="text-sm text-red-700 mt-1"><%= error %></p>
          </div>
        </div>
      <% } %>
      
      <form class="space-y-4" method="post" action="/registro">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Nombre completo</label>
          <input class="w-full h-12 rounded-lg border border-gray-300 px-4 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent" type="text" name="nombre" required />
        </div>
        
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Correo electrónico</label>
          <input class="w-full h-12 rounded-lg border border-gray-300 px-4 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent" type="email" name="email" required />
        </div>
        
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Contraseña</label>
          <div class="relative">
            <input 
              id="password" 
              class="w-full h-12 rounded-lg border border-gray-300 px-4 pr-12 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent" 
              type="password" 
              name="password" 
              minlength="6" 
              required 
            />
            <button 
              type="button" 
              id="togglePassword" 
              class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600"
            >
              <svg id="eyeIcon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
              </svg>
            </button>
          </div>
          <p class="text-xs text-gray-500 mt-1">Mínimo 6 caracteres</p>
        </div>
        
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Confirmar contraseña</label>
          <div class="relative">
            <input 
              id="confirmPassword" 
              class="w-full h-12 rounded-lg border border-gray-300 px-4 pr-12 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent" 
              type="password" 
              name="confirmPassword" 
              required 
            />
            <button 
              type="button" 
              id="toggleConfirmPassword" 
              class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600"
            >
              <svg id="eyeIconConfirm" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
              </svg>
            </button>
          </div>
          <div id="passwordMatch" class="text-xs mt-1 hidden">
            <span id="matchMessage"></span>
          </div>
        </div>
        
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Biografía (opcional)</label>
          <textarea class="w-full rounded-lg border border-gray-300 p-4 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent" name="biografia" rows="3" placeholder="Cuéntanos un poco sobre ti..."></textarea>
        </div>
        
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Teléfono (opcional)</label>
          <input class="w-full h-12 rounded-lg border border-gray-300 px-4 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent" type="text" name="telefono" />
        </div>
        
        <!-- CAPTCHA -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">
            Verificación de seguridad
            <span class="text-red-500">*</span>
          </label>
          <div class="bg-gray-50 border border-gray-300 rounded-lg p-4 mb-3">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span class="text-sm font-medium text-gray-700">Resuelve esta operación:</span>
              </div>
              <button type="button" id="refreshCaptcha" class="text-purple-600 hover:text-purple-700 text-sm font-medium">
                Cambiar
              </button>
            </div>
            <div class="mt-2">
              <span id="captchaPregunta" class="text-lg font-mono bg-white px-3 py-2 rounded border inline-block min-w-[120px] text-center">
                Cargando...
              </span>
            </div>
          </div>
          <input 
            id="captchaRespuesta"
            class="w-full h-12 rounded-lg border border-gray-300 px-4 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent" 
            type="number" 
            name="captcha_respuesta" 
            placeholder="Ingresa tu respuesta"
            required 
          />
          <p class="text-xs text-gray-500 mt-1">Resuelve la operación matemática para continuar</p>
        </div>
        
        <button id="submitBtn" class="w-full h-12 rounded-lg bg-purple-600 text-white font-semibold hover:bg-purple-700 transition-colors disabled:bg-gray-400 disabled:cursor-not-allowed" type="submit">
          Crear Cuenta
        </button>
      </form>
      
      <div class="mt-6 pt-6 border-t border-gray-200 text-center">
        <p class="text-sm text-gray-600">
          ¿Ya tienes cuenta? 
          <a href="/login" class="text-purple-600 font-semibold hover:text-purple-700">Iniciar sesión</a>
        </p>
      </div>
    </div>
  </div>
</div>

<script src="/js/registro.js"></script>

</body>
</html>

