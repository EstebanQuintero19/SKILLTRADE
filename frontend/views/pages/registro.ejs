<% layout('layout') %>

<div class="mx-auto max-w-md">
  <h1 class="text-2xl font-extrabold text-[#151117]">Crear cuenta</h1>
  <form class="mt-4 space-y-3" method="post" action="/registro">
    <label class="block">
      <span class="text-sm">Nombre completo</span>
      <input class="w-full h-10 rounded-lg border border-[#edeaf0] px-3" type="text" name="nombre" required />
    </label>
    <label class="block">
      <span class="text-sm">Correo electrónico</span>
      <input class="w-full h-10 rounded-lg border border-[#edeaf0] px-3" type="email" name="email" required />
    </label>
    <label class="block">
      <span class="text-sm">Contraseña</span>
      <input class="w-full h-10 rounded-lg border border-[#edeaf0] px-3" type="password" name="password" required />
    </label>
    <label class="block">
      <span class="text-sm">Biografía (opcional)</span>
      <textarea class="w-full rounded-lg border border-[#edeaf0] p-2" name="biografia" rows="3"></textarea>
    </label>
    <label class="block">
      <span class="text-sm">Teléfono (opcional)</span>
      <input class="w-full h-10 rounded-lg border border-[#edeaf0] px-3" type="text" name="telefono" />
    </label>
    <button class="h-10 px-4 rounded-lg bg-[#5a1593] text-white font-semibold" type="submit">Registrarme</button>
  </form>
</div>

