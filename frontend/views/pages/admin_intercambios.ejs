<!--
/**
 * GESTIÓN DE INTERCAMBIOS ADMIN - SkillTrade Frontend
 * @author SkillTrade Team
 * @version 1.0.0
 * 
 * DESCRIPCIÓN:
 * Página de administración para gestionar todos los intercambios de la plataforma.
 * Permite ver, aprobar, rechazar y cancelar intercambios con tabla paginada.
 * 
 * FUNCIONALIDADES:
 * - Listado paginado de todos los intercambios (5 por página)
 * - Información detallada: usuarios, cursos, estado, duración
 * - Acciones: aprobar, rechazar, cancelar intercambios
 * - Breadcrumb de navegación admin
 * - Tabla responsive con diseño moderno
 * 
 * VARIABLES EJS:
 * - title: Título de la página
 * - intercambios: Array de intercambios paginados
 * - paginacion: Objeto con información de paginación
 */
-->
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - SkillTrade</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        .card-shadow { box-shadow: 0 4px 20px rgba(139, 69, 19, 0.1); }
        .admin-gradient { background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%); }
    </style>
</head>
<body class="bg-gray-50">
    <%- include('../partials/header') %>
    
    <div class="min-h-screen bg-gray-50">
        <!--HEADER - Breadcrumb y título de sección-->
        <div class="admin-gradient text-white py-12">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex items-center justify-between">
                    <div>
                        <nav class="flex items-center space-x-2 text-red-200 mb-4">
                            <a href="/admin" class="hover:text-white">Admin</a>
                            <i class="fas fa-chevron-right text-xs"></i>
                            <span class="text-white">Intercambios</span>
                        </nav>
                        <h1 class="text-3xl font-bold flex items-center">
                            <i class="fas fa-exchange-alt mr-3"></i>
                            Gestión de Intercambios
                        </h1>
                        <p class="text-red-100 mt-2">Administra todos los intercambios de la plataforma</p>
                    </div>
                    <div class="text-center">
                        <div class="text-2xl font-bold"><%= paginacion.totalElementos || 0 %></div>
                        <div class="text-red-200">Total Intercambios</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-6">
            <!-- Tabla de Intercambios -->
            <div class="bg-white rounded-xl card-shadow overflow-hidden">
                <div class="bg-gradient-to-r from-orange-600 to-red-600 px-6 py-4">
                    <h2 class="text-xl font-bold text-white flex items-center">
                        <i class="fas fa-list mr-2"></i>
                        Lista de Intercambios
                        <span class="ml-auto text-orange-100">
                            Página <%= paginacion.paginaActual || 1 %> de <%= paginacion.totalPaginas || 1 %>
                        </span>
                    </h2>
                </div>

                <% if (intercambios && intercambios.length > 0) { %>
                    <div class="overflow-x-auto">
                        <table class="w-full">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        <i class="fas fa-handshake mr-1"></i> ID
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        <i class="fas fa-user mr-1"></i> Solicitante
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        <i class="fas fa-user-check mr-1"></i> Receptor
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        <i class="fas fa-exchange-alt mr-1"></i> Cursos
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        <i class="fas fa-clock mr-1"></i> Duración
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        <i class="fas fa-info-circle mr-1"></i> Estado
                                    </th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        <i class="fas fa-calendar mr-1"></i> Fecha
                                    </th>
                                    <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        <i class="fas fa-cogs mr-1"></i> Acciones
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200">
                                <% intercambios.forEach((intercambio, index) => { %>
                                    <tr class="hover:bg-gray-50 transition-colors">
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <div class="text-sm font-medium text-gray-900">
                                                #<%= intercambio._id.toString().slice(-6).toUpperCase() %>
                                            </div>
                                        </td>
                                        <td class="px-6 py-4">
                                            <div class="flex items-center">
                                                <div class="flex-shrink-0 h-8 w-8">
                                                    <div class="h-8 w-8 rounded-full bg-gradient-to-br from-teal-400 to-blue-500 flex items-center justify-center">
                                                        <span class="text-white text-xs font-medium">
                                                            <%= (intercambio.usuarioSolicitante?.nombre || 'Usuario').charAt(0).toUpperCase() %>
                                                        </span>
                                                    </div>
                                                </div>
                                                <div class="ml-3">
                                                    <div class="text-sm font-medium text-gray-900">
                                                        <%= intercambio.usuarioSolicitante?.nombre || 'Sin nombre' %>
                                                    </div>
                                                    <div class="text-sm text-gray-500">
                                                        <%= intercambio.usuarioSolicitante?.email || 'Sin email' %>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-6 py-4">
                                            <div class="flex items-center">
                                                <div class="flex-shrink-0 h-8 w-8">
                                                    <div class="h-8 w-8 rounded-full bg-gradient-to-br from-purple-400 to-pink-500 flex items-center justify-center">
                                                        <span class="text-white text-xs font-medium">
                                                            <%= (intercambio.usuarioReceptor?.nombre || 'Usuario').charAt(0).toUpperCase() %>
                                                        </span>
                                                    </div>
                                                </div>
                                                <div class="ml-3">
                                                    <div class="text-sm font-medium text-gray-900">
                                                        <%= intercambio.usuarioReceptor?.nombre || 'Sin nombre' %>
                                                    </div>
                                                    <div class="text-sm text-gray-500">
                                                        <%= intercambio.usuarioReceptor?.email || 'Sin email' %>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-6 py-4">
                                            <div class="space-y-2">
                                                <div class="flex items-center text-xs">
                                                    <i class="fas fa-arrow-right text-teal-500 mr-2"></i>
                                                    <span class="truncate max-w-xs">
                                                        <%= intercambio.cursoSolicitante?.titulo || 'Curso eliminado' %>
                                                    </span>
                                                </div>
                                                <div class="flex items-center text-xs">
                                                    <i class="fas fa-arrow-left text-purple-500 mr-2"></i>
                                                    <span class="truncate max-w-xs">
                                                        <%= intercambio.cursoReceptor?.titulo || 'Curso eliminado' %>
                                                    </span>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                                <i class="fas fa-calendar-alt mr-1"></i>
                                                <%= intercambio.duracion || 'No especificada' %>
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <% if (intercambio.estado === 'pendiente') { %>
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                                    <i class="fas fa-clock mr-1"></i>
                                                    Pendiente
                                                </span>
                                            <% } else if (intercambio.estado === 'aceptado') { %>
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                    <i class="fas fa-check-circle mr-1"></i>
                                                    Aceptado
                                                </span>
                                            <% } else if (intercambio.estado === 'rechazado') { %>
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                                    <i class="fas fa-times-circle mr-1"></i>
                                                    Rechazado
                                                </span>
                                            <% } else if (intercambio.estado === 'activo') { %>
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                                    <i class="fas fa-sync mr-1"></i>
                                                    Activo
                                                </span>
                                            <% } else { %>
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                                    <i class="fas fa-question mr-1"></i>
                                                    <%= intercambio.estado || 'Desconocido' %>
                                                </span>
                                            <% } %>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                            <%= new Date(intercambio.fechaSolicitud).toLocaleDateString('es-ES') %>
                                            <div class="text-xs text-gray-400">
                                                <%= new Date(intercambio.fechaSolicitud).toLocaleTimeString('es-ES') %>
                                            </div>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-center">
                                            <div class="flex items-center justify-center space-x-2">
                                                <button onclick="verDetalleIntercambio('<%= intercambio._id %>')"
                                                        class="inline-flex items-center px-2 py-1 border border-transparent text-xs font-medium rounded text-blue-600 bg-blue-100 hover:bg-blue-200 transition-colors"
                                                        title="Ver detalle">
                                                    <i class="fas fa-eye"></i>
                                                </button>
                                                <% if (intercambio.estado === 'pendiente') { %>
                                                    <button onclick="aprobarIntercambio('<%= intercambio._id %>')"
                                                            class="inline-flex items-center px-2 py-1 border border-transparent text-xs font-medium rounded text-green-600 bg-green-100 hover:bg-green-200 transition-colors"
                                                            title="Aprobar">
                                                        <i class="fas fa-check"></i>
                                                    </button>
                                                    <button onclick="rechazarIntercambio('<%= intercambio._id %>')"
                                                            class="inline-flex items-center px-2 py-1 border border-transparent text-xs font-medium rounded text-red-600 bg-red-100 hover:bg-red-200 transition-colors"
                                                            title="Rechazar">
                                                        <i class="fas fa-times"></i>
                                                    </button>
                                                <% } %>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Paginación -->
                    <% if (paginacion.totalPaginas > 1) { %>
                        <div class="bg-white px-4 py-3 border-t border-gray-200 sm:px-6">
                            <div class="flex items-center justify-between">
                                <div class="flex-1 flex justify-between sm:hidden">
                                    <% if (paginacion.paginaActual > 1) { %>
                                        <a href="?page=<%= paginacion.paginaActual - 1 %>" class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                                            Anterior
                                        </a>
                                    <% } %>
                                    <% if (paginacion.paginaActual < paginacion.totalPaginas) { %>
                                        <a href="?page=<%= paginacion.paginaActual + 1 %>" class="ml-3 relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                                            Siguiente
                                        </a>
                                    <% } %>
                                </div>
                                <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
                                    <div>
                                        <p class="text-sm text-gray-700">
                                            Mostrando
                                            <span class="font-medium"><%= ((paginacion.paginaActual - 1) * 5) + 1 %></span>
                                            a
                                            <span class="font-medium"><%= Math.min(paginacion.paginaActual * 5, paginacion.totalElementos) %></span>
                                            de
                                            <span class="font-medium"><%= paginacion.totalElementos %></span>
                                            intercambios
                                        </p>
                                    </div>
                                    <div>
                                        <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px">
                                            <% if (paginacion.paginaActual > 1) { %>
                                                <a href="?page=<%= paginacion.paginaActual - 1 %>" class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50">
                                                    <i class="fas fa-chevron-left"></i>
                                                </a>
                                            <% } %>
                                            
                                            <% for (let i = 1; i <= paginacion.totalPaginas; i++) { %>
                                                <% if (i === paginacion.paginaActual) { %>
                                                    <span class="relative inline-flex items-center px-4 py-2 border border-red-500 bg-red-50 text-sm font-medium text-red-600">
                                                        <%= i %>
                                                    </span>
                                                <% } else { %>
                                                    <a href="?page=<%= i %>" class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50">
                                                        <%= i %>
                                                    </a>
                                                <% } %>
                                            <% } %>
                                            
                                            <% if (paginacion.paginaActual < paginacion.totalPaginas) { %>
                                                <a href="?page=<%= paginacion.paginaActual + 1 %>" class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50">
                                                    <i class="fas fa-chevron-right"></i>
                                                </a>
                                            <% } %>
                                        </nav>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% } %>
                <% } else { %>
                    <div class="text-center py-12">
                        <i class="fas fa-exchange-alt text-gray-400 text-4xl mb-4"></i>
                        <h3 class="text-lg font-medium text-gray-900 mb-2">No hay intercambios</h3>
                        <p class="text-gray-500">No se encontraron intercambios en la plataforma.</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <div class="py-8"></div>

    <script>
        function verDetalleIntercambio(intercambioId) {
            // Redirigir a página de detalle de intercambio
            window.location.href = `/admin_intercambio_detalle/${intercambioId}`;
        }

        function aprobarIntercambio(intercambioId) {
            if (confirm('¿Estás seguro de que deseas aprobar este intercambio?')) {
                fetch(`/api/admin/intercambios/${intercambioId}/aprobar`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-API-Key': '<%= locals.token || "" %>',
                        'Authorization': 'Bearer <%= locals.token || "" %>'
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('Intercambio aprobado exitosamente');
                        window.location.reload();
                    } else {
                        alert('Error al aprobar intercambio: ' + (data.message || 'Error desconocido'));
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error al aprobar intercambio');
                });
            }
        }

        function rechazarIntercambio(intercambioId) {
            const motivo = prompt('¿Cuál es el motivo del rechazo? (opcional)');
            if (motivo !== null) { // null significa que canceló
                fetch(`/api/admin/intercambios/${intercambioId}/rechazar`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-API-Key': '<%= locals.token || "" %>',
                        'Authorization': 'Bearer <%= locals.token || "" %>'
                    },
                    body: JSON.stringify({ motivo: motivo })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('Intercambio rechazado exitosamente');
                        window.location.reload();
                    } else {
                        alert('Error al rechazar intercambio: ' + (data.message || 'Error desconocido'));
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error al rechazar intercambio');
                });
            }
        }
    </script>
</body>
</html>
