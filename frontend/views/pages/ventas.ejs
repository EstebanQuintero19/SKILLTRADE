<% layout('layout') %>

<section class="mb-8">
  <h1 class="text-3xl font-bold text-gray-900 tracking-tight">Sales Overview</h1>
  <p class="text-base text-gray-500 mt-1">Manage and visualize sales transactions, including user, courses, amount, and date.</p>
  <div class="mt-4 relative max-w-md">
    <input
      id="q"
      class="w-full h-12 rounded-lg border border-gray-200 pl-12 pr-4 bg-white focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition"
      placeholder="Search transactions"
    />
    <svg class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 256 256"><path fill="currentColor" d="M229.66 218.34l-50.07-50.06a88.11 88.11 0 1 0-11.31 11.31l50.06 50.07a8 8 0 0 0 11.32-11.32ZM40 112a72 72 0 1 1 72 72a72.08 72.08 0 0 1-72-72Z"/></svg>
  </div>
</section>

<div class="overflow-x-auto rounded-xl border border-gray-200 bg-white shadow-sm">
  <table class="w-full text-sm text-left">
    <thead class="bg-gray-50 text-gray-500 uppercase tracking-wider">
      <tr>
        <th class="px-6 py-3">Transaction ID</th>
        <th class="px-6 py-3">User</th>
        <th class="px-6 py-3">Course</th>
        <th class="px-6 py-3">Amount</th>
        <th class="px-6 py-3">Date</th>
      </tr>
    </thead>
    <tbody id="rows" class="divide-y divide-gray-100">
      <% (ventas||[]).forEach(v => { %>
        <tr class="hover:bg-purple-50 transition">
          <td class="px-6 py-4 font-mono text-xs text-gray-700">#<%= v._id %></td>
          <td class="px-6 py-4 text-gray-900"><%= v.usuario?.nombre || '-' %></td>
          <td class="px-6 py-4 text-purple-700 font-semibold"><%= v.curso?.titulo || '-' %></td>
          <td class="px-6 py-4 text-green-600 font-bold">$<%= Number(v.monto||v.precio||0).toFixed(2) %></td>
          <td class="px-6 py-4 text-gray-500"><%= (new Date(v.fecha||v.createdAt)).toISOString().slice(0,10) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<section class="grid md:grid-cols-2 gap-6 mt-8">
  <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm flex flex-col items-start">
    <h3 class="text-gray-500 text-sm font-medium">Total Sales</h3>
    <p class="text-3xl font-extrabold text-gray-900 mt-2">$<%= Number(summary?.total||0).toFixed(2) %></p>
  </div>
  <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm flex flex-col items-start">
    <h3 class="text-gray-500 text-sm font-medium">Average Transaction Amount</h3>
    <p class="text-3xl font-extrabold text-gray-900 mt-2">$<%= Number(summary?.promedio||0).toFixed(2) %></p>
  </div>
  <div class="md:col-span-2 rounded-xl border border-dashed border-gray-300 bg-gray-50 p-6 text-gray-400 text-center mt-2">
    Charts coming soon.
  </div>
</section>

<script>
  const q = document.getElementById('q');
  const rows = Array.from(document.querySelectorAll('#rows tr'));
  q.addEventListener('input',()=>{
    const t=(q.value||'').toLowerCase();
    rows.forEach(r=>{r.style.display = !t || r.textContent.toLowerCase().includes(t) ? '' : 'none';});
  });
</script>
