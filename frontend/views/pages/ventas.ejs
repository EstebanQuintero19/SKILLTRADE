<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ventas - SkillTrade</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-gray-50 min-h-screen">

<section class="mb-4">
  <h1 class="text-2xl font-extrabold text-[#151117]">Sales Overview</h1>
  <p class="text-sm text-[#6f6880]">Manage and visualize sales transactions, including user, courses, amount, and date.</p>
  <div class="mt-3 relative">
    <input id="q" class="w-full h-11 rounded-lg border border-[#edeaf0] pl-10 pr-3" placeholder="Search transactions" />
    <svg class="absolute left-3 top-1/2 -translate-y-1/2 text-[#9a92ad]" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 256 256"><path fill="currentColor" d="M229.66 218.34l-50.07-50.06a88.11 88.11 0 1 0-11.31 11.31l50.06 50.07a8 8 0 0 0 11.32-11.32ZM40 112a72 72 0 1 1 72 72a72.08 72.08 0 0 1-72-72Z"/></svg>
  </div>
</section>

<div class="overflow-x-auto rounded-lg border border-[#edeaf0]">
  <table class="w-full text-sm">
    <thead class="bg-[#f5f2f8] text-[#6f6880]">
      <tr>
        <th class="px-4 py-2 text-left">Transaction ID</th>
        <th class="px-4 py-2 text-left">User</th>
        <th class="px-4 py-2 text-left">Course</th>
        <th class="px-4 py-2 text-left">Amount</th>
        <th class="px-4 py-2 text-left">Date</th>
      </tr>
    </thead>
    <tbody id="rows">
      <% (ventas||[]).forEach(v => { %>
        <tr class="border-t border-[#edeaf0]"><td class="px-4 py-3">#<%= v._id %></td><td class="px-4 py-3"><%= v.usuario?.nombre || '-' %></td><td class="px-4 py-3 text-[#5a1593]"><%= v.curso?.titulo || '-' %></td><td class="px-4 py-3">$<%= Number(v.monto||v.precio||0).toFixed(2) %></td><td class="px-4 py-3"><%= (new Date(v.fecha||v.createdAt)).toISOString().slice(0,10) %></td></tr>
      <% }) %>
    </tbody>
  </table>
</div>

<section class="grid md:grid-cols-2 gap-4 mt-6">
  <div class="rounded-lg border border-[#edeaf0] p-4">
    <h3 class="text-[#6f6880] text-sm">Total Sales</h3>
    <p class="text-2xl font-extrabold">$<%= Number(summary?.total||0).toFixed(2) %></p>
  </div>
  <div class="rounded-lg border border-[#edeaf0] p-4">
    <h3 class="text-[#6f6880] text-sm">Average Transaction Amount</h3>
    <p class="text-2xl font-extrabold">$<%= Number(summary?.promedio||0).toFixed(2) %></p>
  </div>
  <!-- Placeholder mini charts -->
  <div class="md:col-span-2 rounded-lg border border-[#edeaf0] p-4 text-[#6f6880]">Charts coming soon.</div>
  </section>

<script>
  const q = document.getElementById('q');
  const rows = Array.from(document.querySelectorAll('#rows tr'));
  q.addEventListener('input',()=>{
    const t=(q.value||'').toLowerCase();
    rows.forEach(r=>{r.style.display = !t || r.textContent.toLowerCase().includes(t) ? '' : 'none';});
  });
</script>

</body>
</html>

