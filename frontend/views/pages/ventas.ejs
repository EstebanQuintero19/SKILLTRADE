<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ventas - SkillTrade</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
    .gradient-bg { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
    .card-shadow { box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04); }
  </style>
</head>
<body class="bg-gradient-to-br from-gray-50 to-gray-100 min-h-screen">

<%- include('../partials/header') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  
  <!-- Header con estadísticas -->  
  <section class="mb-8">
    <div class="flex items-start justify-between mb-6">
      <div>
        <h1 class="text-4xl font-bold text-gray-800 mb-2">
          <i class="fas fa-chart-line text-purple-600 mr-3"></i>
          Resumen de Ventas
        </h1>
        <p class="text-gray-600 text-lg">Administra y visualiza todas las transacciones de ventas de cursos</p>
      </div>
      <div class="flex items-center gap-2 px-4 py-2 rounded-lg bg-purple-100">
        <i class="fas fa-dollar-sign text-purple-600"></i>
        <span class="font-semibold text-gray-800"><%= (ventas || []).length %></span>
        <span class="text-sm text-gray-600">transacciones</span>
      </div>
    </div>

    <!-- Tarjetas de estadísticas -->  
    <div class="grid md:grid-cols-3 gap-6 mb-8">
      <div class="bg-white rounded-xl card-shadow p-6 border-l-4 border-green-500">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="text-gray-600 text-sm font-medium mb-1">Ventas Totales</h3>
            <p class="text-3xl font-bold text-gray-800">$<%= Number(summary?.total||0).toLocaleString() %></p>
          </div>
          <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center">
            <i class="fas fa-coins text-green-600 text-xl"></i>
          </div>
        </div>
      </div>
      
      <div class="bg-white rounded-xl card-shadow p-6 border-l-4 border-blue-500">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="text-gray-600 text-sm font-medium mb-1">Promedio por Venta</h3>
            <p class="text-3xl font-bold text-gray-800">$<%= Number(summary?.promedio||0).toLocaleString() %></p>
          </div>
          <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
            <i class="fas fa-chart-bar text-blue-600 text-xl"></i>
          </div>
        </div>
      </div>
      
      <div class="bg-white rounded-xl card-shadow p-6 border-l-4 border-purple-500">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="text-gray-600 text-sm font-medium mb-1">Total Transacciones</h3>
            <p class="text-3xl font-bold text-gray-800"><%= (ventas || []).length %></p>
          </div>
          <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center">
            <i class="fas fa-receipt text-purple-600 text-xl"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- Búsqueda -->
    <div class="bg-white rounded-xl card-shadow p-6">
      <div class="relative">
        <input 
          id="q" 
          class="w-full h-12 rounded-lg border border-gray-300 pl-12 pr-4 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all" 
          placeholder="Buscar transacciones por usuario, curso o ID..." 
        />
        <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
      </div>
    </div>
  </section>

  <!-- Tabla de transacciones -->
  <div class="bg-white rounded-xl card-shadow overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead class="bg-gradient-to-r from-purple-50 to-blue-50 border-b border-gray-200">
          <tr>
            <th class="px-6 py-4 text-left font-semibold text-gray-800">
              <i class="fas fa-hashtag text-gray-500 mr-2"></i>
              ID Transacción
            </th>
            <th class="px-6 py-4 text-left font-semibold text-gray-800">
              <i class="fas fa-user text-gray-500 mr-2"></i>
              Usuario
            </th>
            <th class="px-6 py-4 text-left font-semibold text-gray-800">
              <i class="fas fa-book text-gray-500 mr-2"></i>
              Curso
            </th>
            <th class="px-6 py-4 text-left font-semibold text-gray-800">
              <i class="fas fa-dollar-sign text-gray-500 mr-2"></i>
              Monto
            </th>
            <th class="px-6 py-4 text-left font-semibold text-gray-800">
              <i class="fas fa-calendar text-gray-500 mr-2"></i>
              Fecha
            </th>
          </tr>
        </thead>
        <tbody id="rows">
          <% if (ventas && ventas.length > 0) { %>
            <% ventas.forEach((v, index) => { %>
              <tr class="border-t border-gray-100 hover:bg-gray-50 transition-colors">
                <!-- ID Transacción -->
                <td class="px-6 py-4">
                  <div class="flex items-center">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                      #<%= (v._id || '').toString().slice(-8) %>
                    </span>
                  </div>
                </td>
                
                <!-- Usuario -->
                <td class="px-6 py-4">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-gradient-to-br from-purple-500 to-purple-700 flex items-center justify-center text-white font-semibold text-sm">
                      <%= (v.usuario?.nombre || 'U').charAt(0).toUpperCase() %>
                    </div>
                    <div>
                      <p class="font-medium text-gray-800"><%= v.usuario?.nombre || 'Usuario desconocido' %></p>
                      <p class="text-xs text-gray-500"><%= v.usuario?.email || '-' %></p>
                    </div>
                  </div>
                </td>
                
                <!-- Curso -->
                <td class="px-6 py-4">
                  <div class="flex items-center gap-2">
                    <div class="w-8 h-8 bg-purple-100 rounded-lg flex items-center justify-center">
                      <i class="fas fa-graduation-cap text-purple-600 text-sm"></i>
                    </div>
                    <div>
                      <p class="font-medium text-purple-600"><%= v.curso?.titulo || 'Curso no especificado' %></p>
                      <p class="text-xs text-gray-500"><%= v.curso?.categoria || '-' %></p>
                    </div>
                  </div>
                </td>
                
                <!-- Monto -->
                <td class="px-6 py-4">
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-green-100 text-green-800">
                    <i class="fas fa-dollar-sign mr-1"></i>
                    <%= Number(v.monto||v.precio||0).toLocaleString() %>
                  </span>
                </td>
                
                <!-- Fecha -->
                <td class="px-6 py-4">
                  <div class="flex items-center gap-2 text-gray-600">
                    <i class="fas fa-clock text-gray-400"></i>
                    <span class="text-sm"><%= new Date(v.fecha||v.createdAt).toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
    
    <!-- Sin resultados -->
    <% if (!ventas || ventas.length === 0) { %>
      <div class="p-12 text-center">
        <div class="w-24 h-24 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-6">
          <i class="fas fa-chart-line text-purple-600 text-3xl"></i>
        </div>
        <h3 class="text-2xl font-bold text-gray-800 mb-3">No hay ventas registradas</h3>
        <p class="text-gray-600">Aún no se han realizado transacciones de venta</p>
      </div>
    <% } %>
  </div>

  <!-- Sección de gráficos futuros -->
  <div class="mt-8 bg-white rounded-xl card-shadow p-8">
    <div class="text-center">
      <div class="w-20 h-20 bg-gradient-to-br from-purple-100 to-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
        <i class="fas fa-chart-pie text-purple-600 text-2xl"></i>
      </div>
      <h3 class="text-xl font-bold text-gray-800 mb-2">Análisis Avanzado</h3>
      <p class="text-gray-600 mb-4">Gráficos detallados y métricas avanzadas próximamente</p>
      <div class="inline-flex items-center px-4 py-2 bg-purple-100 text-purple-700 rounded-lg text-sm font-medium">
        <i class="fas fa-clock mr-2"></i>
        Próximamente
      </div>
    </div>
  </div>
</div>

<script>
  const q = document.getElementById('q');
  const rows = Array.from(document.querySelectorAll('#rows tr'));
  
  q.addEventListener('input', () => {
    const searchTerm = (q.value || '').toLowerCase().trim();
    let visibleCount = 0;
    
    rows.forEach(row => {
      const rowText = row.textContent.toLowerCase();
      const isVisible = !searchTerm || rowText.includes(searchTerm);
      row.style.display = isVisible ? '' : 'none';
      if (isVisible) visibleCount++;
    });
    
    // Mostrar contador de resultados
    console.log(`Mostrando ${visibleCount} de ${rows.length} transacciones`);
  });
</script>

</body>
</html>

