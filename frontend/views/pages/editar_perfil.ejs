<% layout('layout') %>

<div class="max-w-4xl mx-auto px-4 sm:px-8 py-10">
  <!-- Header -->
  <div class="mb-10">
    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-3">
      <a href="/perfil" class="hover:text-purple-700 transition-colors">Mi Perfil</a>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
      <span class="text-gray-900 font-semibold">Editar Perfil</span>
    </nav>
    <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900">Editar Perfil</h1>
    <p class="text-gray-500 mt-2">Actualiza tu información personal</p>
  </div>

  <div class="grid lg:grid-cols-3 gap-8">
    <!-- Sidebar - Avatar y datos básicos -->
    <aside class="lg:col-span-1">
      <div class="bg-white rounded-2xl shadow border border-gray-100 p-8 sticky top-4">
        <!-- Avatar -->
        <div class="text-center mb-8">
          <div class="relative inline-block">
            <div class="w-32 h-32 rounded-full bg-gradient-to-br from-purple-700 to-purple-400 flex items-center justify-center text-white text-5xl font-bold shadow-lg border-4 border-white">
              <%= (usuario?.nombre || 'U').charAt(0).toUpperCase() %>
            </div>
            <button 
              type="button"
              class="absolute bottom-2 right-2 w-10 h-10 bg-white rounded-full shadow border flex items-center justify-center hover:bg-gray-100 transition"
              title="Cambiar foto"
            >
              <svg class="w-5 h-5 text-purple-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </button>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mt-5"><%= usuario?.nombre || 'Usuario' %></h3>
          <p class="text-sm text-gray-500"><%= usuario?.email || '' %></p>
        </div>

        <!-- Estadísticas -->
        <div class="space-y-4 pt-6 border-t border-gray-100">
          <div class="flex items-center justify-between text-sm">
            <span class="text-gray-500">Miembro desde</span>
            <span class="font-semibold text-gray-900">
              <%= usuario?.createdAt ? new Date(usuario.createdAt).toLocaleDateString('es-ES', { year: 'numeric', month: 'short' }) : 'N/A' %>
            </span>
          </div>
          <div class="flex items-center justify-between text-sm">
            <span class="text-gray-500">Rol</span>
            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-semibold bg-purple-50 text-purple-700 capitalize">
              <%= usuario?.rol || 'estudiante' %>
            </span>
          </div>
        </div>
      </div>
    </aside>

    <!-- Formulario principal -->
    <section class="lg:col-span-2">
      <form method="post" action="/perfil/editar" enctype="application/x-www-form-urlencoded" class="space-y-8">
        
        <!-- Información personal -->
        <div class="bg-white rounded-2xl shadow border border-gray-100 p-8">
          <h2 class="text-lg font-bold text-gray-900 mb-6 flex items-center gap-3">
            <span class="w-9 h-9 bg-purple-700 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
            </span>
            Información Personal
          </h2>

          <div class="space-y-5">
            <!-- Nombre -->
            <div>
              <label class="block text-sm font-medium text-gray-900 mb-2">
                Nombre completo <span class="text-red-500">*</span>
              </label>
              <input 
                class="w-full h-12 rounded-lg border border-gray-200 px-4 focus:outline-none focus:ring-2 focus:ring-purple-700 focus:border-transparent transition" 
                name="nombre" 
                value="<%= usuario?.nombre %>" 
                placeholder="Tu nombre completo"
                required 
              />
            </div>

            <!-- Email (solo lectura) -->
            <div>
              <label class="block text-sm font-medium text-gray-900 mb-2">
                Correo electrónico
              </label>
              <input 
                class="w-full h-12 rounded-lg border border-gray-200 px-4 bg-gray-50 text-gray-400 cursor-not-allowed" 
                value="<%= usuario?.email || '' %>" 
                disabled
              />
              <p class="text-xs text-gray-400 mt-1">El correo no se puede modificar</p>
            </div>

            <!-- Teléfono -->
            <div>
              <label class="block text-sm font-medium text-gray-900 mb-2">
                Teléfono
              </label>
              <div class="relative">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">📱</span>
                <input 
                  class="w-full h-12 rounded-lg border border-gray-200 pl-12 pr-4 focus:outline-none focus:ring-2 focus:ring-purple-700 focus:border-transparent transition" 
                  name="telefono" 
                  type="tel"
                  value="<%= usuario?.telefono || '' %>" 
                  placeholder="+57 300 123 4567"
                />
              </div>
            </div>
          </div>
        </div>

        <!-- Biografía -->
        <div class="bg-white rounded-2xl shadow border border-gray-100 p-8">
          <h2 class="text-lg font-bold text-gray-900 mb-6 flex items-center gap-3">
            <span class="w-9 h-9 bg-purple-700 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
              </svg>
            </span>
            Acerca de Ti
          </h2>

          <div>
            <label class="block text-sm font-medium text-gray-900 mb-2">
              Biografía
            </label>
            <textarea 
              class="w-full rounded-lg border border-gray-200 p-3 focus:outline-none focus:ring-2 focus:ring-purple-700 focus:border-transparent transition resize-none" 
              name="biografia" 
              rows="6"
              placeholder="Cuéntanos sobre ti, tus intereses, experiencia o cualquier cosa que quieras compartir..."
            ><%= usuario?.biografia || '' %></textarea>
            <p class="text-xs text-gray-400 mt-1">
              <span id="bio-count">0</span> caracteres
            </p>
          </div>
        </div>

        <!-- Preferencias -->
        <div class="bg-white rounded-2xl shadow border border-gray-100 p-8">
          <h2 class="text-lg font-bold text-gray-900 mb-6 flex items-center gap-3">
            <span class="w-9 h-9 bg-purple-700 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
              </svg>
            </span>
            Notificaciones
          </h2>

          <div class="space-y-4">
            <label class="flex items-center justify-between p-4 rounded-lg border border-gray-200 hover:bg-gray-50 cursor-pointer transition">
              <div class="flex items-center gap-3">
                <span class="w-10 h-10 bg-purple-50 rounded-lg flex items-center justify-center">
                  <svg class="w-5 h-5 text-purple-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </span>
                <div>
                  <p class="font-medium text-gray-900">Notificaciones por email</p>
                  <p class="text-xs text-gray-500">Recibe actualizaciones en tu correo</p>
                </div>
              </div>
              <input type="checkbox" class="w-5 h-5 text-purple-700 rounded focus:ring-purple-700 accent-purple-700" checked>
            </label>

            <label class="flex items-center justify-between p-4 rounded-lg border border-gray-200 hover:bg-gray-50 cursor-pointer transition">
              <div class="flex items-center gap-3">
                <span class="w-10 h-10 bg-purple-50 rounded-lg flex items-center justify-center">
                  <svg class="w-5 h-5 text-purple-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                  </svg>
                </span>
                <div>
                  <p class="font-medium text-gray-900">Novedades de cursos</p>
                  <p class="text-xs text-gray-500">Entérate de nuevos cursos disponibles</p>
                </div>
              </div>
              <input type="checkbox" class="w-5 h-5 text-purple-700 rounded focus:ring-purple-700 accent-purple-700" checked>
            </label>
          </div>
        </div>

        <!-- Botones de acción -->
        <div class="bg-white rounded-2xl shadow border border-gray-100 p-8">
          <div class="flex flex-wrap gap-4">
            <button 
              class="flex-1 sm:flex-none py-3 px-6 rounded-lg bg-purple-700 text-white font-semibold hover:bg-purple-800 transition shadow flex items-center justify-center gap-2" 
              type="submit"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Guardar Cambios
            </button>

            <a 
              href="/perfil" 
              class="flex-1 sm:flex-none py-3 px-6 rounded-lg bg-purple-50 text-purple-700 font-semibold hover:bg-purple-100 transition text-center flex items-center justify-center gap-2"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
              Cancelar
            </a>
          </div>
        </div>
      </form>
    </section>
  </div>
</div>

<script>
  // Contador de caracteres para biografía
  const bioTextarea = document.querySelector('textarea[name="biografia"]');
  const bioCount = document.getElementById('bio-count');
  
  if (bioTextarea && bioCount) {
    const updateCount = () => {
      bioCount.textContent = bioTextarea.value.length;
    };
    bioTextarea.addEventListener('input', updateCount);
    updateCount();
  }
</script>
