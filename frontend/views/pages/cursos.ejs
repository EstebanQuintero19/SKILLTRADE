<% layout('layout') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-4xl font-bold text-[#151117] mb-2">Explorar Cursos</h1>
    <p class="text-[#6f6880]">Descubre y aprende con nuestros cursos especializados</p>
  </div>

  <!-- Barra de búsqueda y filtros -->
  <div class="bg-white rounded-xl shadow-sm border border-[#edeaf0] p-6 mb-8">
    <!-- Búsqueda -->
    <div class="relative mb-4">
      <input 
        id="q" 
        name="q" 
        value="<%= q || '' %>" 
        class="w-full h-12 rounded-lg border border-[#edeaf0] pl-12 pr-4 focus:outline-none focus:ring-2 focus:ring-[#5a1593] focus:border-transparent transition-all" 
        placeholder="Buscar cursos por título o palabra clave..." 
      />
      <svg class="absolute left-4 top-1/2 -translate-y-1/2 text-[#9a92ad] pointer-events-none" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 256 256">
        <path fill="currentColor" d="M229.66 218.34l-50.07-50.06a88.11 88.11 0 1 0-11.31 11.31l50.06 50.07a8 8 0 0 0 11.32-11.32ZM40 112a72 72 0 1 1 72 72a72.08 72.08 0 0 1-72-72Z"/>
      </svg>
    </div>

    <!-- Filtros -->
    <div class="flex flex-wrap gap-3">
      <div class="flex-1 min-w-[200px]">
        <label class="block text-sm font-medium text-[#6f6880] mb-1">Categoría</label>
        <select id="f-categoria" class="w-full h-10 rounded-lg border border-[#edeaf0] px-3 focus:outline-none focus:ring-2 focus:ring-[#5a1593] focus:border-transparent transition-all">
          <option value="">Todas las categorías</option>
          <% const cats = new Set(); (cursos||[]).forEach(c => (c.categoria||[]).forEach(x=>cats.add(x))); Array.from(cats).forEach(x=>{ %>
            <option value="<%= x %>"><%= x %></option>
          <% }) %>
        </select>
      </div>

      <div class="flex-1 min-w-[200px]">
        <label class="block text-sm font-medium text-[#6f6880] mb-1">Nivel</label>
        <select id="f-nivel" class="w-full h-10 rounded-lg border border-[#edeaf0] px-3 focus:outline-none focus:ring-2 focus:ring-[#5a1593] focus:border-transparent transition-all">
          <option value="">Todos los niveles</option>
          <option value="basico">Básico</option>
          <option value="intermedio">Intermedio</option>
          <option value="avanzado">Avanzado</option>
        </select>
      </div>

      <div class="flex items-end">
        <button 
          id="clear-filters"
          class="h-10 px-4 rounded-lg bg-[#eee8f3] text-[#5a1593] font-medium hover:bg-[#e0d5ed] transition-colors text-sm"
        >
          Limpiar filtros
        </button>
      </div>
    </div>

    <!-- Contador de resultados -->
    <div class="mt-4 pt-4 border-t border-[#edeaf0]">
      <p class="text-sm text-[#6f6880]">
        <span id="results-count"><%= (cursos || []).length %></span> cursos encontrados
      </p>
    </div>
  </div>

  <!-- Grid de cursos -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" id="grid">
    <% (cursos || []).forEach(c => { %>
      <article 
        class="course-card group bg-white rounded-xl overflow-hidden shadow-sm border border-[#edeaf0] hover:shadow-lg transition-all duration-300" 
        data-categorias="<%= (c.categoria||[]).join(',') %>" 
        data-nivel="<%= c.nivel || '' %>" 
        data-title="<%= (c.titulo||'').toLowerCase() %>"
      >
        <a href="/curso/<%= c._id %>" class="block">
          <!-- Imagen del curso -->
          <div class="relative w-full aspect-video bg-cover bg-center overflow-hidden" style="background-image:url('<%= c.imagen || 'https://via.placeholder.com/640x360' %>')">
            <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <% if (c.nivel) { %>
              <span class="absolute top-3 right-3 px-2 py-1 rounded-full text-xs font-semibold bg-white/90 backdrop-blur text-[#5a1593] capitalize">
                <%= c.nivel %>
              </span>
            <% } %>
          </div>

          <!-- Contenido -->
          <div class="p-4">
            <!-- Categorías -->
            <% if (c.categoria && c.categoria.length > 0) { %>
              <div class="flex flex-wrap gap-1 mb-2">
                <% c.categoria.slice(0, 2).forEach(cat => { %>
                  <span class="inline-block px-2 py-0.5 rounded text-xs font-medium bg-[#f5f2f8] text-[#5a1593]">
                    <%= cat %>
                  </span>
                <% }) %>
                <% if (c.categoria.length > 2) { %>
                  <span class="inline-block px-2 py-0.5 rounded text-xs font-medium bg-[#f5f2f8] text-[#6f6880]">
                    +<%= c.categoria.length - 2 %>
                  </span>
                <% } %>
              </div>
            <% } %>

            <!-- Título -->
            <h3 class="font-bold text-[#151117] mb-2 group-hover:text-[#5a1593] transition-colors line-clamp-2 min-h-[3rem]">
              <%= c.titulo %>
            </h3>

            <!-- Descripción -->
            <p class="text-sm text-[#6f6880] line-clamp-2 mb-3 min-h-[2.5rem]">
              <%= c.descripcion %>
            </p>

            <!-- Footer -->
            <div class="flex items-center justify-between pt-3 border-t border-[#edeaf0]">
              <div class="flex items-center gap-1 text-xs text-[#6f6880]">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                </svg>
                <span>Curso online</span>
              </div>
              <% if (c.precio !== undefined && c.precio !== null) { %>
                <span class="text-lg font-bold text-[#5a1593]">
                  $<%= Number(c.precio).toFixed(2) %>
                </span>
              <% } %>
            </div>
          </div>
        </a>
      </article>
    <% }) %>
  </div>

  <!-- Mensaje sin resultados -->
  <div id="no-results" class="hidden bg-white rounded-xl shadow-sm border border-[#edeaf0] p-12 text-center">
    <div class="max-w-md mx-auto">
      <div class="w-24 h-24 bg-[#f5f2f8] rounded-full flex items-center justify-center mx-auto mb-6">
        <svg class="w-12 h-12 text-[#6f6880]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </div>
      <h3 class="text-2xl font-bold text-[#151117] mb-3">No se encontraron cursos</h3>
      <p class="text-[#6f6880] mb-6">Intenta ajustar los filtros o buscar con otros términos</p>
      <button 
        id="clear-filters-empty"
        class="inline-block py-3 px-8 rounded-lg bg-[#5a1593] text-white font-semibold hover:bg-[#4a1275] transition-colors"
      >
        Limpiar Filtros
      </button>
    </div>
  </div>
</div>

<script>
  const qEl = document.getElementById('q');
  const catEl = document.getElementById('f-categoria');
  const nivelEl = document.getElementById('f-nivel');
  const clearBtn = document.getElementById('clear-filters');
  const clearBtnEmpty = document.getElementById('clear-filters-empty');
  const gridEl = document.getElementById('grid');
  const noResultsEl = document.getElementById('no-results');
  const resultsCount = document.getElementById('results-count');
  const cards = Array.from(document.querySelectorAll('.course-card'));

  function applyFilters(){
    const q = (qEl.value||'').toLowerCase().trim();
    const cat = catEl.value;
    const nivel = nivelEl.value;
    let visibleCount = 0;

    cards.forEach(card => {
      const matchesQ = !q || card.dataset.title.includes(q);
      const matchesCat = !cat || (card.dataset.categorias||'').split(',').includes(cat);
      const matchesNivel = !nivel || (card.dataset.nivel===nivel);
      const isVisible = matchesQ && matchesCat && matchesNivel;
      
      card.style.display = isVisible ? '' : 'none';
      if (isVisible) visibleCount++;
    });

    // Actualizar contador y mostrar/ocultar mensaje de sin resultados
    resultsCount.textContent = visibleCount;
    if (visibleCount === 0) {
      gridEl.classList.add('hidden');
      noResultsEl.classList.remove('hidden');
    } else {
      gridEl.classList.remove('hidden');
      noResultsEl.classList.add('hidden');
    }
  }

  function clearFilters() {
    qEl.value = '';
    catEl.value = '';
    nivelEl.value = '';
    applyFilters();
  }

  qEl.addEventListener('input', applyFilters);
  catEl.addEventListener('change', applyFilters);
  nivelEl.addEventListener('change', applyFilters);
  clearBtn.addEventListener('click', clearFilters);
  clearBtnEmpty.addEventListener('click', clearFilters);
</script>