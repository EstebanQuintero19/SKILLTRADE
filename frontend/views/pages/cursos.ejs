<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cursos - SkillTrade</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/cursos.css">
</head>
<body class="bg-gradient-to-br from-gray-50 to-gray-100 min-h-screen">

<%- include('../partials/header') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  
  <!-- Hero Section -->
  <section class="mb-12">
    <div class="gradient-bg rounded-2xl p-8 md:p-12 text-white relative overflow-hidden">
      <!-- Decorative elements -->
      <div class="absolute top-0 right-0 w-64 h-64 bg-white/10 rounded-full -translate-y-32 translate-x-32"></div>
      <div class="absolute bottom-0 left-0 w-48 h-48 bg-white/5 rounded-full translate-y-24 -translate-x-24"></div>
      
      <div class="relative z-10">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between">
          <div class="mb-6 md:mb-0">
            <h1 class="text-4xl md:text-5xl font-bold mb-4">
              <i class="fas fa-graduation-cap mr-4"></i>
              Explorar Cursos
            </h1>
            <p class="text-xl text-purple-100 mb-6 max-w-2xl">
              Descubre conocimientos increíbles y acelera tu crecimiento profesional con nuestros cursos especializados
            </p>
            
            <!-- Estadísticas rápidas -->
            <div class="flex flex-wrap gap-6">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 bg-white/20 rounded-lg flex items-center justify-center">
                  <i class="fas fa-book text-sm"></i>
                </div>
                <div>
                  <div class="font-semibold"><%= paginacion?.totalElementos || 0 %></div>
                  <div class="text-xs text-purple-200">Cursos</div>
                </div>
              </div>
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 bg-white/20 rounded-lg flex items-center justify-center">
                  <i class="fas fa-users text-sm"></i>
                </div>
                <div>
                  <div class="font-semibold">
                    <% if (estadisticas?.totalUsuarios) { %>
                      <% if (estadisticas.totalUsuarios >= 1000) { %>
                        <%= (estadisticas.totalUsuarios / 1000).toFixed(1) %>K+
                      <% } else { %>
                        <%= estadisticas.totalUsuarios %>
                      <% } %>
                    <% } else { %>
                      0
                    <% } %>
                  </div>
                  <div class="text-xs text-purple-200">Estudiantes</div>
                </div>
              </div>
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 bg-white/20 rounded-lg flex items-center justify-center">
                  <i class="fas fa-star text-sm"></i>
                </div>
                <div>
                  <div class="font-semibold"><%= estadisticas?.calificacionPromedio || '4.9' %></div>
                  <div class="text-xs text-purple-200">Calificación</div>
                </div>
              </div>
            </div>
          </div>
          
          <% if (locals.signedIn) { %>
          <div class="flex-shrink-0 flex gap-4">
            <a href="/cursos/crear" 
               class="inline-flex items-center px-8 py-4 bg-white text-purple-600 font-bold rounded-xl hover:bg-gray-50 transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-1">
              <i class="fas fa-plus mr-3"></i>
              Crear Curso
            </a>
            <button onclick="abrirModalIntercambio()" 
                    class="inline-flex items-center px-8 py-4 bg-teal-500 text-white font-bold rounded-xl hover:bg-teal-600 transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-1">
              <i class="fas fa-exchange-alt mr-3"></i>
              Nuevo Intercambio
            </button>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </section>

  <!-- Filtros y Búsqueda -->
  <section class="mb-8">
    <div class="bg-white rounded-2xl card-shadow p-6">
      <!-- Formulario de búsqueda -->
      <form method="GET" action="/cursos" class="mb-6">
        <div class="relative">
          <input 
            name="q" 
            value="<%= q || '' %>" 
            class="w-full h-14 rounded-xl border border-gray-300 pl-14 pr-4 text-lg focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all" 
            placeholder="Buscar cursos por título, categoría o instructor..." 
          />
          <i class="fas fa-search absolute left-5 top-1/2 transform -translate-y-1/2 text-gray-400 text-lg"></i>
          <!-- Mantener otros filtros en la búsqueda -->
          <% if (categoria) { %><input type="hidden" name="categoria" value="<%= categoria %>"><% } %>
          <% if (nivel) { %><input type="hidden" name="nivel" value="<%= nivel %>"><% } %>
          <% if (precioMin) { %><input type="hidden" name="precioMin" value="<%= precioMin %>"><% } %>
          <% if (precioMax) { %><input type="hidden" name="precioMax" value="<%= precioMax %>"><% } %>
        </div>
      </form>

      <!-- Filtros rápidos -->
      <div class="flex flex-wrap gap-3">
        <a href="/cursos<%= q ? '?q=' + encodeURIComponent(q) : '' %>" 
           class="px-4 py-2 rounded-lg border transition-all <%= !categoria ? 'filter-active' : 'border-gray-300 text-gray-700 hover:border-purple-500 hover:text-purple-600' %>">
          <i class="fas fa-th-large mr-2"></i>
          Todos
        </a>
        <a href="/cursos?categoria=programacion<%= q ? '&q=' + encodeURIComponent(q) : '' %>" 
           class="px-4 py-2 rounded-lg border transition-all <%= categoria === 'programacion' ? 'filter-active' : 'border-gray-300 text-gray-700 hover:border-purple-500 hover:text-purple-600' %>">
          <i class="fas fa-code mr-2"></i>
          Programación
        </a>
        <a href="/cursos?categoria=diseno<%= q ? '&q=' + encodeURIComponent(q) : '' %>" 
           class="px-4 py-2 rounded-lg border transition-all <%= categoria === 'diseno' ? 'filter-active' : 'border-gray-300 text-gray-700 hover:border-purple-500 hover:text-purple-600' %>">
          <i class="fas fa-palette mr-2"></i>
          Diseño
        </a>
        <a href="/cursos?categoria=marketing<%= q ? '&q=' + encodeURIComponent(q) : '' %>" 
           class="px-4 py-2 rounded-lg border transition-all <%= categoria === 'marketing' ? 'filter-active' : 'border-gray-300 text-gray-700 hover:border-purple-500 hover:text-purple-600' %>">
          <i class="fas fa-bullhorn mr-2"></i>
          Marketing
        </a>
        <a href="/cursos?categoria=negocios<%= q ? '&q=' + encodeURIComponent(q) : '' %>" 
           class="px-4 py-2 rounded-lg border transition-all <%= categoria === 'negocios' ? 'filter-active' : 'border-gray-300 text-gray-700 hover:border-purple-500 hover:text-purple-600' %>">
          <i class="fas fa-briefcase mr-2"></i>
          Negocios
        </a>
        <a href="/cursos?precioMax=0<%= q ? '&q=' + encodeURIComponent(q) : '' %><%= categoria ? '&categoria=' + categoria : '' %>" 
           class="px-4 py-2 rounded-lg border transition-all <%= precioMax === '0' ? 'filter-active' : 'border-gray-300 text-gray-700 hover:border-purple-500 hover:text-purple-600' %>">
          <i class="fas fa-gift mr-2"></i>
          Gratis
        </a>
      </div>

      <!-- Contador de resultados y paginación info -->
      <div class="mt-4 pt-4 border-t border-gray-200 flex justify-between items-center">
        <p class="text-sm text-gray-600">
          Mostrando <span class="font-semibold text-purple-600"><%= paginacion.elementosPorPagina * (paginacion.pagina - 1) + 1 %></span> - 
          <span class="font-semibold text-purple-600"><%= Math.min(paginacion.elementosPorPagina * paginacion.pagina, paginacion.totalElementos) %></span> 
          de <span class="font-semibold text-purple-600"><%= paginacion.totalElementos %></span> cursos
        </p>
        <% if (paginacion.totalPaginas > 1) { %>
        <p class="text-sm text-gray-500">
          Página <%= paginacion.pagina %> de <%= paginacion.totalPaginas %>
        </p>
        <% } %>
      </div>
    </div>
  </section>

  <!-- Lista de cursos -->
  <section>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% if (cursos && cursos.length > 0) { %>
        <% cursos.forEach((curso, index) => { %>
          <div class="course-card bg-white rounded-2xl card-shadow overflow-hidden animate-fade-in" 
               style="animation-delay: <%= (index * 0.1) %>s;"
               data-categories="<%= (curso.categoria || []).join(',').toLowerCase() %>"
               data-price="<%= curso.precio || 0 %>"
               data-title="<%= curso.titulo.toLowerCase() %>">
            
            <!-- Imagen del curso -->
            <div class="relative aspect-video overflow-hidden">
              <% if (curso.imagen && curso.imagen !== '/images/placeholder-course.jpg') { %>
                <img src="<%= curso.imagen %>" alt="<%= curso.titulo %>" class="w-full h-full object-cover">
              <% } else { %>
                <div class="w-full h-full gradient-bg flex items-center justify-center">
                  <i class="fas fa-graduation-cap text-white text-4xl"></i>
                </div>
              <% } %>
              
              <!-- Overlay con información -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
              
              <!-- Badges -->
              <div class="absolute top-4 left-4 flex gap-2">
                <span class="px-3 py-1 rounded-full text-xs font-semibold bg-white/90 backdrop-blur text-purple-600">
                  <%= curso.nivel || 'Principiante' %>
                </span>
                <% if (curso.precio === 0) { %>
                <span class="px-3 py-1 rounded-full text-xs font-semibold bg-green-500 text-white">
                  GRATIS
                </span>
                <% } %>
              </div>

              <!-- Botón de favorito y rating -->
              <div class="absolute top-4 right-4 flex gap-2">
                <% if (user) { %>
                <button onclick="toggleFavorito('<%= curso._id %>')" class="favorite-btn p-2 rounded-full bg-white/90 backdrop-blur hover:bg-white transition-colors" title="Agregar a favoritos">
                  <i class="fas fa-heart text-gray-400 hover:text-red-500 transition-colors"></i>
                </button>
                <% } %>
                <div class="flex items-center gap-1 px-2 py-1 rounded-full bg-white/90 backdrop-blur">
                  <i class="fas fa-star text-yellow-400 text-xs"></i>
                  <span class="text-xs font-semibold text-gray-800">
                    <%= curso.estadisticas?.calificacionPromedio ? curso.estadisticas.calificacionPromedio.toFixed(1) : '0.0' %>
                  </span>
                </div>
              </div>

              <!-- Precio en la esquina inferior -->
              <div class="absolute bottom-4 right-4">
                <div class="px-3 py-2 rounded-lg bg-white/95 backdrop-blur">
                  <div class="text-lg font-bold text-gray-800">
                    <% if (curso.precio && curso.precio > 0) { %>
                      $<%= Number(curso.precio).toLocaleString() %>
                    <% } else { %>
                      <span class="text-green-600">Gratis</span>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>

            <!-- Contenido -->
            <div class="p-6">
              <!-- Título -->
              <h3 class="text-xl font-bold text-gray-800 mb-3 line-clamp-2 hover:text-purple-600 transition-colors">
                <%= curso.titulo %>
              </h3>
              
              <!-- Descripción -->
              <p class="text-gray-600 text-sm mb-4 line-clamp-3 leading-relaxed">
                <%= curso.descripcion %>
              </p>

              <!-- Categorías -->
              <div class="flex flex-wrap gap-2 mb-4">
                <% if (curso.categoria && Array.isArray(curso.categoria)) { %>
                  <% curso.categoria.slice(0, 3).forEach(cat => { %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-purple-100 text-purple-700">
                      <i class="fas fa-tag mr-1"></i>
                      <%= cat %>
                    </span>
                  <% }) %>
                <% } %>
              </div>

              <!-- Información adicional -->
              <div class="flex items-center justify-between text-sm text-gray-500 mb-4">
                <div class="flex items-center gap-4">
                  <div class="flex items-center gap-1">
                    <i class="fas fa-clock"></i>
                    <span>
                      <% if (curso.horasTotales && curso.horasTotales > 0) { %>
                        <%= curso.horasTotales %> horas
                      <% } else { %>
                        Sin lecciones
                      <% } %>
                    </span>
                  </div>
                  <div class="flex items-center gap-1">
                    <i class="fas fa-users"></i>
                    <span>
                      <%= curso.numeroEstudiantes || 1 %> 
                      <%= (curso.numeroEstudiantes || 1) === 1 ? 'estudiante' : 'estudiantes' %>
                    </span>
                  </div>
                </div>
              </div>

              <!-- Botones de acción -->
              <div class="flex gap-3">
                <a href="/cursos/<%= curso._id %>" 
                   class="flex-1 inline-flex items-center justify-center px-4 py-3 gradient-bg text-white font-semibold rounded-xl hover:opacity-90 transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5">
                  <i class="fas fa-play mr-2"></i>
                  Ver Curso
                </a>
                
                <!-- Botón agregar al carrito (solo para cursos de pago) -->
                <% if (curso.precio && curso.precio > 0) { %>
                  <% if (locals.signedIn) { %>
                  <button onclick="agregarAlCarrito('<%= curso._id %>')" 
                          class="px-4 py-3 bg-green-500 text-white rounded-xl hover:bg-green-600 transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5"
                          title="Agregar al carrito">
                    <i class="fas fa-shopping-cart"></i>
                  </button>
                  <% } else { %>
                  <a href="/login" 
                     class="px-4 py-3 bg-orange-500 text-white rounded-xl hover:bg-orange-600 transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5"
                     title="Iniciar sesión para comprar">
                    <i class="fas fa-sign-in-alt"></i>
                  </a>
                  <% } %>
                <% } %>
                
                <button class="px-4 py-3 border border-gray-300 text-gray-600 rounded-xl hover:border-purple-500 hover:text-purple-600 transition-all">
                  <i class="fas fa-heart"></i>
                </button>
              </div>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>

    <!-- Estado vacío mejorado -->
    <% if (!cursos || cursos.length === 0) { %>
      <div class="text-center py-20">
        <div class="w-32 h-32 gradient-bg rounded-full flex items-center justify-center mx-auto mb-8 shadow-lg">
          <i class="fas fa-graduation-cap text-white text-5xl"></i>
        </div>
        <h3 class="text-3xl font-bold text-gray-800 mb-4">¡Próximamente cursos increíbles!</h3>
        <p class="text-gray-600 mb-8 max-w-md mx-auto text-lg">
          Estamos preparando contenido educativo de alta calidad para ti. Mientras tanto, ¿por qué no creas el primer curso?
        </p>
        <% if (locals.signedIn) { %>
        <a href="/cursos/crear" 
           class="inline-flex items-center px-8 py-4 gradient-bg text-white font-bold rounded-xl hover:opacity-90 transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-1">
          <i class="fas fa-plus mr-3"></i>
          Crear el Primer Curso
        </a>
        <% } else { %>
        <a href="/login" 
           class="inline-flex items-center px-8 py-4 gradient-bg text-white font-bold rounded-xl hover:opacity-90 transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-1">
          <i class="fas fa-sign-in-alt mr-3"></i>
          Iniciar Sesión para Crear
        </a>
        <% } %>
      </div>
    <% } %>

    <!-- Paginación -->
    <% if (paginacion.totalPaginas > 1) { %>
    <div class="mt-12 flex justify-center">
      <nav class="bg-white rounded-2xl card-shadow p-4">
        <div class="flex items-center space-x-2">
          <!-- Botón anterior -->
          <% if (paginacion.pagina > 1) { %>
            <% 
              const prevParams = new URLSearchParams();
              if (q) prevParams.append('q', q);
              if (categoria) prevParams.append('categoria', categoria);
              if (nivel) prevParams.append('nivel', nivel);
              if (precioMin) prevParams.append('precioMin', precioMin);
              if (precioMax) prevParams.append('precioMax', precioMax);
              prevParams.append('page', (paginacion.pagina - 1).toString());
            %>
            <a href="/cursos?<%= prevParams.toString() %>" 
               class="px-4 py-2 rounded-lg border border-gray-300 text-gray-700 hover:border-purple-500 hover:text-purple-600 transition-all flex items-center">
              <i class="fas fa-chevron-left mr-2"></i>
              Anterior
            </a>
          <% } else { %>
            <span class="px-4 py-2 rounded-lg border border-gray-200 text-gray-400 cursor-not-allowed flex items-center">
              <i class="fas fa-chevron-left mr-2"></i>
              Anterior
            </span>
          <% } %>
          
          <!-- Números de página -->
          <% 
            const startPage = Math.max(1, paginacion.pagina - 2);
            const endPage = Math.min(paginacion.totalPaginas, paginacion.pagina + 2);
          %>
          
          <% if (startPage > 1) { %>
            <% 
              const firstParams = new URLSearchParams();
              if (q) firstParams.append('q', q);
              if (categoria) firstParams.append('categoria', categoria);
              if (nivel) firstParams.append('nivel', nivel);
              if (precioMin) firstParams.append('precioMin', precioMin);
              if (precioMax) firstParams.append('precioMax', precioMax);
              firstParams.append('page', '1');
            %>
            <a href="/cursos?<%= firstParams.toString() %>" 
               class="px-3 py-2 rounded-lg border border-gray-300 text-gray-700 hover:border-purple-500 hover:text-purple-600 transition-all">1</a>
            <% if (startPage > 2) { %>
              <span class="px-2 text-gray-400">...</span>
            <% } %>
          <% } %>
          
          <% for (let i = startPage; i <= endPage; i++) { %>
            <% if (i === paginacion.pagina) { %>
              <span class="px-3 py-2 rounded-lg filter-active font-semibold"><%= i %></span>
            <% } else { %>
              <% 
                const pageParams = new URLSearchParams();
                if (q) pageParams.append('q', q);
                if (categoria) pageParams.append('categoria', categoria);
                if (nivel) pageParams.append('nivel', nivel);
                if (precioMin) pageParams.append('precioMin', precioMin);
                if (precioMax) pageParams.append('precioMax', precioMax);
                pageParams.append('page', i.toString());
              %>
              <a href="/cursos?<%= pageParams.toString() %>" 
                 class="px-3 py-2 rounded-lg border border-gray-300 text-gray-700 hover:border-purple-500 hover:text-purple-600 transition-all"><%= i %></a>
            <% } %>
          <% } %>
          
          <% if (endPage < paginacion.totalPaginas) { %>
            <% if (endPage < paginacion.totalPaginas - 1) { %>
              <span class="px-2 text-gray-400">...</span>
            <% } %>
            <% 
              const lastParams = new URLSearchParams();
              if (q) lastParams.append('q', q);
              if (categoria) lastParams.append('categoria', categoria);
              if (nivel) lastParams.append('nivel', nivel);
              if (precioMin) lastParams.append('precioMin', precioMin);
              if (precioMax) lastParams.append('precioMax', precioMax);
              lastParams.append('page', paginacion.totalPaginas.toString());
            %>
            <a href="/cursos?<%= lastParams.toString() %>" 
               class="px-3 py-2 rounded-lg border border-gray-300 text-gray-700 hover:border-purple-500 hover:text-purple-600 transition-all"><%= paginacion.totalPaginas %></a>
          <% } %>
          
          <!-- Botón siguiente -->
          <% if (paginacion.pagina < paginacion.totalPaginas) { %>
            <% 
              const nextParams = new URLSearchParams();
              if (q) nextParams.append('q', q);
              if (categoria) nextParams.append('categoria', categoria);
              if (nivel) nextParams.append('nivel', nivel);
              if (precioMin) nextParams.append('precioMin', precioMin);
              if (precioMax) nextParams.append('precioMax', precioMax);
              nextParams.append('page', (paginacion.pagina + 1).toString());
            %>
            <a href="/cursos?<%= nextParams.toString() %>" 
               class="px-4 py-2 rounded-lg border border-gray-300 text-gray-700 hover:border-purple-500 hover:text-purple-600 transition-all flex items-center">
              Siguiente
              <i class="fas fa-chevron-right ml-2"></i>
            </a>
          <% } else { %>
            <span class="px-4 py-2 rounded-lg border border-gray-200 text-gray-400 cursor-not-allowed flex items-center">
              Siguiente
              <i class="fas fa-chevron-right ml-2"></i>
            </span>
          <% } %>
        </div>
      </nav>
    </div>
    <% } %>
  </section>
</div>

<script>
  // Datos de sesión disponibles para JavaScript
  window.sessionData = {
    signedIn: <%= locals.signedIn ? 'true' : 'false' %>,
    token: '<%= locals.token || '' %>',
    user: <%- locals.user ? JSON.stringify(locals.user) : 'null' %>
  };
</script>
<script src="/js/cursos.js"></script>

<!-- Modal de Intercambio -->
<div id="modalIntercambio" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50 flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
    <div class="p-6 border-b border-gray-200">
      <div class="flex items-center justify-between">
        <h2 class="text-2xl font-bold text-gray-900">
          <i class="fas fa-exchange-alt mr-3 text-teal-500"></i>
          Nuevo Intercambio
        </h2>
        <button onclick="cerrarModalIntercambio()" class="text-gray-400 hover:text-gray-600">
          <i class="fas fa-times text-xl"></i>
        </button>
      </div>
    </div>
    
    <div class="p-6">
      <form id="formIntercambio">
        <!-- Paso 1: Seleccionar mi curso -->
        <div class="mb-6">
          <label class="block text-sm font-medium text-gray-700 mb-2">
            <i class="fas fa-book mr-2 text-purple-500"></i>
            Mi curso para intercambiar
          </label>
          <select id="miCurso" name="cursoEmisor" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-transparent" required>
            <option value="">Selecciona uno de tus cursos...</option>
          </select>
        </div>

        <!-- Paso 2: Buscar usuario -->
        <div class="mb-6">
          <label class="block text-sm font-medium text-gray-700 mb-2">
            <i class="fas fa-user mr-2 text-blue-500"></i>
            Buscar usuario
          </label>
          <div class="relative">
            <input type="text" id="buscarUsuario" placeholder="Haz clic para ver todos los usuarios o escribe para buscar..." 
                   class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-transparent">
            <i class="fas fa-chevron-down absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
          </div>
          <div id="resultadosUsuarios" class="absolute z-10 mt-1 w-full bg-white border border-gray-300 rounded-lg shadow-lg max-h-32 overflow-y-auto hidden"></div>
          <input type="hidden" id="usuarioSeleccionado" name="receptor">
          <div id="usuarioElegido" class="mt-2 hidden">
            <div class="flex items-center p-3 bg-blue-50 rounded-lg">
              <i class="fas fa-user-circle text-blue-500 text-xl mr-3"></i>
              <div>
                <div class="font-medium" id="nombreUsuarioElegido"></div>
                <div class="text-sm text-gray-600" id="emailUsuarioElegido"></div>
              </div>
              <button type="button" onclick="limpiarUsuarioSeleccionado()" class="ml-auto text-red-500 hover:text-red-700">
                <i class="fas fa-times"></i>
              </button>
            </div>
          </div>
        </div>

        <!-- Paso 3: Seleccionar curso del usuario -->
        <div class="mb-6">
          <label class="block text-sm font-medium text-gray-700 mb-2">
            <i class="fas fa-book-open mr-2 text-green-500"></i>
            Curso que deseas del usuario
          </label>
          <select id="cursoUsuario" name="cursoReceptor" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-transparent" required disabled>
            <option value="">Primero selecciona un usuario...</option>
          </select>
        </div>

        <!-- Paso 4: Duración -->
        <div class="mb-6">
          <label class="block text-sm font-medium text-gray-700 mb-2">
            <i class="fas fa-clock mr-2 text-orange-500"></i>
            Duración del intercambio
          </label>
          <select name="duracion" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-transparent" required>
            <option value="7">1 semana</option>
            <option value="14">2 semanas</option>
            <option value="30" selected>1 mes</option>
            <option value="60">2 meses</option>
            <option value="90">3 meses</option>
          </select>
        </div>

        <!-- Paso 5: Comentario opcional -->
        <div class="mb-6">
          <label class="block text-sm font-medium text-gray-700 mb-2">
            <i class="fas fa-comment mr-2 text-indigo-500"></i>
            Mensaje (opcional)
          </label>
          <textarea name="comentario" rows="3" placeholder="Escribe un mensaje para el usuario..." 
                    class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-transparent resize-none"></textarea>
        </div>

        <!-- Botones -->
        <div class="flex gap-3">
          <button type="button" onclick="cerrarModalIntercambio()" 
                  class="flex-1 px-6 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors">
            Cancelar
          </button>
          <button type="submit" 
                  class="flex-1 px-6 py-3 bg-teal-500 text-white rounded-lg hover:bg-teal-600 transition-colors font-medium">
            <i class="fas fa-paper-plane mr-2"></i>
            Enviar Solicitud
          </button>
        </div>
      </form>
    </div>
  </div>
</div>


</body>
</html>
