<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cursos - SkillTrade</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-gray-50 min-h-screen">

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Header -->
  <div class="mb-8 flex justify-between items-center">
    <div>
      <h1 class="text-4xl font-bold text-gray-800 mb-2">Explorar Cursos</h1>
      <p class="text-gray-600">Descubre y aprende con nuestros cursos especializados</p>
    </div>
    <% if (locals.signedIn) { %>
    <a href="/cursos/crear" 
       class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 text-white font-semibold rounded-lg transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5">
      <i class="fas fa-plus mr-2"></i>
      Crear Curso
    </a>
    <% } %>
  </div>

  <!-- Búsqueda -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-8">
    <div class="relative">
      <input 
        id="q" 
        name="q" 
        value="<%= q || '' %>" 
        class="w-full h-12 rounded-lg border border-gray-300 pl-12 pr-4 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" 
        placeholder="Buscar cursos por título o palabra clave..." 
      />
      <i class="fas fa-search absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
    </div>
  </div>

  <!-- Lista de cursos -->
  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% if (cursos && cursos.length > 0) { %>
      <% cursos.forEach(curso => { %>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden hover:shadow-lg transition-shadow">
          <!-- Imagen del curso -->
          <div class="aspect-video bg-gradient-to-br from-blue-500 to-purple-600 relative">
            <% if (curso.imagen) { %>
              <img src="<%= curso.imagen %>" alt="<%= curso.titulo %>" class="w-full h-full object-cover">
            <% } else { %>
              <div class="w-full h-full flex items-center justify-center">
                <i class="fas fa-graduation-cap text-white text-4xl"></i>
              </div>
            <% } %>
            <div class="absolute top-4 left-4">
              <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-white/90 backdrop-blur text-blue-600">
                <%= curso.nivel || 'Intermedio' %>
              </span>
            </div>
          </div>

          <!-- Contenido -->
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-800 mb-2 line-clamp-2">
              <%= curso.titulo %>
            </h3>
            <p class="text-gray-600 text-sm mb-4 line-clamp-3">
              <%= curso.descripcion %>
            </p>

            <!-- Categorías -->
            <div class="flex flex-wrap gap-2 mb-4">
              <% if (curso.categoria && Array.isArray(curso.categoria)) { %>
                <% curso.categoria.slice(0, 2).forEach(cat => { %>
                  <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                    <%= cat %>
                  </span>
                <% }) %>
              <% } %>
            </div>

            <!-- Footer -->
            <div class="flex items-center justify-between">
              <div class="text-2xl font-bold text-green-600">
                <% if (curso.precio && curso.precio > 0) { %>
                  $<%= curso.precio.toLocaleString() %>
                <% } else { %>
                  Gratis
                <% } %>
              </div>
              <a href="/curso/<%= curso._id %>" 
                 class="inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-lg transition-colors">
                Ver curso
                <i class="fas fa-arrow-right ml-2"></i>
              </a>
            </div>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <!-- Estado vacío -->
      <div class="col-span-full text-center py-16">
        <div class="w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-6">
          <i class="fas fa-book-open text-gray-400 text-3xl"></i>
        </div>
        <h3 class="text-xl font-semibold text-gray-800 mb-2">No hay cursos disponibles</h3>
        <p class="text-gray-600 mb-6">Aún no se han publicado cursos en la plataforma.</p>
        <% if (locals.signedIn) { %>
        <a href="/cursos/crear" 
           class="inline-flex items-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition-colors">
          <i class="fas fa-plus mr-2"></i>
          Crear el primer curso
        </a>
        <% } %>
      </div>
    <% } %>
  </div>
</div>

<script>
  console.log('Cursos cargados:', <%= JSON.stringify(cursos || []) %>);
</script>

</body>
</html>
