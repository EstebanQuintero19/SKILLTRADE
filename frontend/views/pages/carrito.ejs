<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Carrito - SkillTrade</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <style>
    body { font-family: 'Inter', sans-serif; }
    .card-shadow { box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06); }
    .card-shadow:hover { box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05); }
    .fade-in { animation: fadeIn 0.6s ease-out; }
    .fade-in-delay { animation: fadeIn 0.8s ease-out; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    .gradient-bg { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
    .hero-pattern { background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.15) 1px, transparent 0); background-size: 20px 20px; }
    .course-card { animation: fadeInUp 0.6s ease-out forwards; }
    .course-card:nth-child(2) { animation-delay: 0.1s; }
    .course-card:nth-child(3) { animation-delay: 0.2s; }
    @keyframes fadeInUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
    .bg-custom { background: linear-gradient(135deg, #e0e7ff 0%, #c7d2fe 30%, #ddd6fe 60%, #e0e7ff 100%); }
  </style>
</head>
<body class="bg-custom min-h-screen">

<!-- Header -->
<%- include('../partials/header') %>

<!-- Hero Section -->
<div class="gradient-bg hero-pattern relative overflow-hidden">
  <div class="absolute inset-0 bg-black opacity-20"></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center">
      <!-- Breadcrumb -->
      <div class="flex items-center justify-center space-x-2 text-white/80 text-sm mb-6 fade-in">
        <a href="/" class="hover:text-white transition-colors">
          <i class="fas fa-home"></i> Inicio
        </a>
        <i class="fas fa-chevron-right text-xs"></i>
        <a href="/cursos" class="hover:text-white transition-colors">Cursos</a>
        <i class="fas fa-chevron-right text-xs"></i>
        <span class="text-white">Carrito</span>
      </div>

      <h1 class="text-5xl font-bold text-white mb-4 fade-in">
        <i class="fas fa-shopping-cart mr-4"></i>
        Carrito de Compras
      </h1>
      <p class="text-xl text-white/90 max-w-2xl mx-auto fade-in-delay">
        Revisa tus cursos seleccionados y procede al pago de forma segura
      </p>

      <!-- Stats rápidas -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-12 fade-in-delay">
        <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6 border border-white/20">
          <div class="text-3xl font-bold text-white"><%= items ? items.length : 0 %></div>
          <div class="text-white/80 text-sm">Cursos en carrito</div>
        </div>
        <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6 border border-white/20">
          <div class="text-3xl font-bold text-white">
            $<%= items ? items.reduce((sum, i) => sum + Number(i.curso?.precio || 0), 0).toFixed(2) : '0.00' %>
          </div>
          <div class="text-white/80 text-sm">Total a pagar</div>
        </div>
        <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6 border border-white/20">
          <div class="text-3xl font-bold text-white">
            <i class="fas fa-shield-alt"></i>
          </div>
          <div class="text-white/80 text-sm">Pago seguro</div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Contenido principal -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <% if (items && items.length > 0) { %>
    <div class="grid lg:grid-cols-3 gap-8">
      <!-- Lista de cursos -->
      <div class="lg:col-span-2">
        <div class="bg-white rounded-xl card-shadow overflow-hidden">
          <div class="px-6 py-4 bg-gradient-to-r from-purple-100 to-blue-100 border-b border-purple-200">
            <h2 class="text-xl font-bold text-purple-800 flex items-center">
              <i class="fas fa-list-ul mr-3 text-purple-600"></i>
              <%= items.length %> <%= items.length === 1 ? 'curso' : 'cursos' %> en tu carrito
            </h2>
          </div>
          
          <div class="divide-y divide-purple-200">
            <% items.forEach((item, index) => { %>
              <div class="p-6 hover:bg-purple-50 transition-all duration-300 course-card">
                <div class="flex gap-6">
                  <!-- Thumbnail del curso -->
                  <div class="flex-shrink-0 w-40 h-28 bg-gradient-to-br from-purple-500 to-blue-600 rounded-xl flex items-center justify-center shadow-lg">
                    <i class="fas fa-play-circle text-4xl text-white"></i>
                  </div>
                  
                  <!-- Info del curso -->
                  <div class="flex-1 min-w-0">
                    <h3 class="font-bold text-purple-800 text-xl mb-2">
                      <%= item.curso?.titulo || 'Curso sin título' %>
                    </h3>
                    <p class="text-sm text-purple-600 mb-3">
                      <i class="fas fa-user mr-1"></i>
                      Por <span class="font-medium">Instructor Experto</span>
                    </p>
                    
                    <!-- Badges y características -->
                    <div class="flex flex-wrap items-center gap-3 mb-3">
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
                        <i class="fas fa-globe mr-1"></i>
                        Online
                      </span>
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                        <i class="fas fa-clock mr-1"></i>
                        Acceso de por vida
                      </span>
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                        <i class="fas fa-certificate mr-1"></i>
                        Certificado
                      </span>
                    </div>

                    <!-- Características adicionales -->
                    <div class="flex items-center gap-4 text-sm text-purple-500">
                      <span class="flex items-center">
                        <i class="fas fa-video mr-1"></i>
                        15 lecciones
                      </span>
                      <span class="flex items-center">
                        <i class="fas fa-users mr-1"></i>
                        1,234 estudiantes
                      </span>
                      <span class="flex items-center">
                        <i class="fas fa-star mr-1 text-yellow-400"></i>
                        4.8 (156 reseñas)
                      </span>
                    </div>
                  </div>
                  
                  <!-- Precio y acciones -->
                  <div class="text-right flex flex-col justify-between items-end">
                    <div class="mb-4">
                      <p class="text-3xl font-bold text-purple-600">
                        $<%= Number(item.curso?.precio || 0).toFixed(2) %>
                      </p>
                      <p class="text-sm text-purple-400 line-through">$<%= (Number(item.curso?.precio || 0) * 1.5).toFixed(2) %></p>
                    </div>
                    
                    <div class="space-y-2">
                      <button 
                        class="flex items-center gap-2 px-4 py-2 text-sm font-medium text-purple-600 hover:text-red-600 hover:bg-red-50 rounded-lg transition-all duration-200"
                        onclick="if(confirm('¿Estás seguro de que quieres eliminar este curso del carrito?')) { /* Agregar lógica de remover */ }"
                      >
                        <i class="fas fa-trash"></i>
                        Eliminar
                      </button>
                      <button class="flex items-center gap-2 px-4 py-2 text-sm font-medium text-purple-600 hover:text-purple-700 hover:bg-purple-50 rounded-lg transition-all duration-200">
                        <i class="fas fa-heart"></i>
                        Guardar
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </div>

      <!-- Resumen del pedido -->
      <div class="lg:col-span-1">
        <div class="bg-white rounded-xl card-shadow p-8 sticky top-4">
          <h2 class="text-2xl font-bold text-purple-800 mb-6 flex items-center">
            <i class="fas fa-receipt mr-3 text-purple-600"></i>
            Resumen del Pedido
          </h2>
          
          <!-- Desglose de precios -->
          <div class="space-y-4 mb-8">
            <div class="flex justify-between text-purple-600">
              <span>Subtotal (<%= items.length %> <%= items.length === 1 ? 'curso' : 'cursos' %>)</span>
              <span class="font-semibold">
                $<%= items.reduce((sum, i) => sum + Number(i.curso?.precio || 0), 0).toFixed(2) %>
              </span>
            </div>
            <div class="flex justify-between text-purple-600">
              <span>Descuento</span>
              <span class="font-semibold text-green-600">-$0.00</span>
            </div>
            <div class="border-t border-purple-200 pt-4 flex justify-between items-center">
              <span class="text-xl font-bold text-purple-800">Total</span>
              <span class="text-3xl font-bold text-purple-600">
                $<%= items.reduce((sum, i) => sum + Number(i.curso?.precio || 0), 0).toFixed(2) %>
              </span>
            </div>
          </div>

          <!-- Campo de cupón -->
          <div class="mb-6">
            <label class="block text-sm font-medium text-purple-700 mb-2">
              <i class="fas fa-tag mr-1"></i>
              Código de descuento
            </label>
            <div class="flex gap-2">
              <input 
                type="text" 
                placeholder="Ingresa tu cupón"
                class="flex-1 px-3 py-2 border border-purple-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
              >
              <button class="px-4 py-2 bg-purple-100 text-purple-600 rounded-lg hover:bg-purple-200 transition-colors">
                Aplicar
              </button>
            </div>
          </div>

          <!-- Botones de acción -->
          <form method="post" action="/carrito/pagar" class="space-y-3">
            <button 
              type="submit"
              class="w-full py-4 px-6 rounded-xl bg-gradient-to-r from-purple-600 to-blue-600 text-white font-bold text-lg hover:from-purple-700 hover:to-blue-700 transition-all duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-1"
            >
              <i class="fas fa-credit-card mr-2"></i>
              Proceder al Pago
            </button>
            <a 
              href="/cursos"
              class="block w-full py-3 px-6 rounded-xl bg-purple-100 text-purple-700 font-semibold text-center hover:bg-purple-200 transition-colors"
            >
              <i class="fas fa-arrow-left mr-2"></i>
              Seguir Explorando
            </a>
          </form>

          <!-- Garantías y seguridad -->
          <div class="mt-8 pt-6 border-t border-purple-200">
            <div class="space-y-3 text-sm text-purple-600">
              <div class="flex items-center">
                <i class="fas fa-shield-alt text-green-500 mr-3"></i>
                <span>Pago 100% seguro y protegido</span>
              </div>
              <div class="flex items-center">
                <i class="fas fa-undo text-blue-500 mr-3"></i>
                <span>Garantía de devolución de 30 días</span>
              </div>
              <div class="flex items-center">
                <i class="fas fa-infinity text-purple-500 mr-3"></i>
                <span>Acceso de por vida</span>
              </div>
              <div class="flex items-center">
                <i class="fas fa-mobile-alt text-orange-500 mr-3"></i>
                <span>Acceso en móvil y escritorio</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

  <% } else { %>
    <!-- Carrito vacío -->
    <div class="bg-white rounded-xl card-shadow p-16 text-center fade-in">
      <div class="max-w-lg mx-auto">
        <!-- Icono grande -->
        <div class="w-32 h-32 bg-gradient-to-br from-purple-100 to-blue-100 rounded-full flex items-center justify-center mx-auto mb-8">
          <i class="fas fa-shopping-cart text-6xl text-purple-400"></i>
        </div>
        
        <h2 class="text-3xl font-bold text-purple-800 mb-4">Tu carrito está vacío</h2>
        <p class="text-lg text-purple-600 mb-8">
          Explora nuestros cursos y agrega los que te interesen para comenzar tu aprendizaje
        </p>

        <!-- Sugerencias de categorías -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
          <a href="/cursos?categoria=programacion" class="p-4 bg-blue-50 rounded-lg hover:bg-blue-100 transition-colors group">
            <i class="fas fa-code text-2xl text-blue-600 mb-2 group-hover:scale-110 transition-transform"></i>
            <div class="text-sm font-medium text-blue-800">Programación</div>
          </a>
          <a href="/cursos?categoria=diseno" class="p-4 bg-purple-50 rounded-lg hover:bg-purple-100 transition-colors group">
            <i class="fas fa-palette text-2xl text-purple-600 mb-2 group-hover:scale-110 transition-transform"></i>
            <div class="text-sm font-medium text-purple-800">Diseño</div>
          </a>
          <a href="/cursos?categoria=marketing" class="p-4 bg-green-50 rounded-lg hover:bg-green-100 transition-colors group">
            <i class="fas fa-bullhorn text-2xl text-green-600 mb-2 group-hover:scale-110 transition-transform"></i>
            <div class="text-sm font-medium text-green-800">Marketing</div>
          </a>
          <a href="/cursos?categoria=negocios" class="p-4 bg-orange-50 rounded-lg hover:bg-orange-100 transition-colors group">
            <i class="fas fa-briefcase text-2xl text-orange-600 mb-2 group-hover:scale-110 transition-transform"></i>
            <div class="text-sm font-medium text-orange-800">Negocios</div>
          </a>
        </div>

        <a 
          href="/cursos"
          class="inline-flex items-center px-8 py-4 rounded-xl bg-gradient-to-r from-purple-600 to-blue-600 text-white font-bold text-lg hover:from-purple-700 hover:to-blue-700 transition-all duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-1"
        >
          <i class="fas fa-search mr-3"></i>
          Explorar Todos los Cursos
        </a>
      </div>
    </div>
  <% } %>
</div>

<!-- Footer -->
<%- include('../partials/footer') %>

</body>
</html>
