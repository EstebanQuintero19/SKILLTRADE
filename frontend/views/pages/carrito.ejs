<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Carrito - SkillTrade</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-gray-50 min-h-screen">

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <h1 class="text-4xl font-bold text-[#151117] mb-8">Carrito de Compras</h1>

  <% if (items && items.length > 0) { %>
    <div class="grid lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2">
        <div class="bg-white rounded-xl shadow-sm border border-[#edeaf0] overflow-hidden">
          <div class="px-6 py-4 bg-[#f5f2f8] border-b border-[#edeaf0]">
            <h2 class="text-lg font-semibold text-[#151117]">
              <%= items.length %> <%= items.length === 1 ? 'curso' : 'cursos' %> en tu carrito
            </h2>
          </div>
          
          <div class="divide-y divide-[#edeaf0]">
            <% items.forEach(i => { %>
              <div class="p-6 hover:bg-gray-50 transition-colors">
                <div class="flex gap-4">
                  <!-- Thumbnail del curso -->
                  <div class="flex-shrink-0 w-32 h-20 bg-gradient-to-br from-teal-400 to-teal-600 rounded-lg flex items-center justify-center">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                    </svg>
                  </div>
                  
                  <!-- Info del curso -->
                  <div class="flex-1 min-w-0">
                    <h3 class="font-semibold text-[#151117] text-lg mb-1">
                      <%= i.curso?.titulo || 'Curso sin título' %>
                    </h3>
                    <p class="text-sm text-[#6f6880] mb-2">
                      Por <span class="font-medium">Instructor</span>
                    </p>
                    <div class="flex items-center gap-2 text-sm text-[#6f6880]">
                      <span class="flex items-center">
                        <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                          <path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/>
                          <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/>
                        </svg>
                        Online
                      </span>
                    </div>
                  </div>
                  
                  <!-- Precio y acciones -->
                  <div class="text-right flex flex-col justify-between items-end">
                    <p class="text-2xl font-bold text-[#5a1593]">
                      $<%= Number(i.curso?.precio || 0).toFixed(2) %>
                    </p>
                    <button 
                      class="text-[#6f6880] hover:text-red-500 transition-colors text-sm font-medium flex items-center gap-1"
                      onclick="event.preventDefault(); /* Agregar lógica de remover */"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                      </svg>
                      Eliminar
                    </button>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </div>

      <!-- Resumen del pedido -->
      <div class="lg:col-span-1">
        <div class="bg-white rounded-xl shadow-sm border border-[#edeaf0] p-6 sticky top-4">
          <h2 class="text-xl font-bold text-[#151117] mb-6">Resumen del Pedido</h2>
          
          <div class="space-y-3 mb-6">
            <div class="flex justify-between text-[#6f6880]">
              <span>Subtotal (<%= items.length %> <%= items.length === 1 ? 'curso' : 'cursos' %>)</span>
              <span class="font-medium">
                $<%= items.reduce((sum, i) => sum + Number(i.curso?.precio || 0), 0).toFixed(2) %>
              </span>
            </div>
            <div class="border-t border-[#edeaf0] pt-3 flex justify-between items-center">
              <span class="text-lg font-bold text-[#151117]">Total</span>
              <span class="text-2xl font-bold text-[#5a1593]">
                $<%= items.reduce((sum, i) => sum + Number(i.curso?.precio || 0), 0).toFixed(2) %>
              </span>
            </div>
          </div>

          <form method="post" action="/carrito/pagar" class="space-y-3">
            <button 
              type="submit"
              class="w-full py-3 px-4 rounded-lg bg-[#5a1593] text-white font-semibold hover:bg-[#4a1275] transition-colors shadow-md hover:shadow-lg"
            >
              Proceder al Pago
            </button>
            <a 
              href="/cursos"
              class="block w-full py-3 px-4 rounded-lg bg-[#eee8f3] text-[#5a1593] font-semibold text-center hover:bg-[#e0d5ed] transition-colors"
            >
              Seguir Explorando
            </a>
          </form>

          <div class="mt-6 pt-6 border-t border-[#edeaf0]">
            <p class="text-xs text-[#6f6880] text-center">
              💳 Pago seguro y protegido
            </p>
          </div>
        </div>
      </div>
    </div>

  <% } else { %>
    <!-- Carrito vacío -->
    <div class="bg-white rounded-xl shadow-sm border border-[#edeaf0] p-12 text-center">
      <div class="max-w-md mx-auto">
        <div class="w-24 h-24 bg-[#f5f2f8] rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-12 h-12 text-[#6f6880]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
        </div>
        <h2 class="text-2xl font-bold text-[#151117] mb-3">Tu carrito está vacío</h2>
        <p class="text-[#6f6880] mb-6">Explora nuestros cursos y agrega los que te interesen</p>
        <a 
          href="/cursos"
          class="inline-block py-3 px-8 rounded-lg bg-[#5a1593] text-white font-semibold hover:bg-[#4a1275] transition-colors shadow-md hover:shadow-lg"
        >
          Explorar Cursos
        </a>
      </div>
    </div>
  <% } %>
</div>

</body>
</html>