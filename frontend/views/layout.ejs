<!--
/**
 * LAYOUT PRINCIPAL - SkillTrade Frontend
 * @author SkillTrade Team
 * @version 1.0.0
 * 
 * DESCRIPCIÓN:
 * Plantilla base EJS que define la estructura HTML común para todas las páginas
 * de la aplicación SkillTrade. Incluye configuración de metadatos, estilos
 * globales y la estructura básica de header, main y footer.
 * 
 * SECCIONES:
 * - HEAD: Configuración de metadatos, título dinámico, Tailwind CSS y fuentes
 * - BODY: Estructura base con header, contenido principal y footer
 * - INCLUDES: Integración de partials (header.ejs y footer.ejs)
 * 
 * CARACTERÍSTICAS TÉCNICAS:
 * - Responsive design con viewport meta tag
 * - Integración de Tailwind CSS desde CDN
 * - Fuente Inter de Google Fonts
 * - Título dinámico configurable desde cada página
 * - Estructura semántica HTML5
 * - Fondo gris claro (bg-gray-50) y altura mínima completa
 * 
 * VARIABLES EJS:
 * - title: Título específico de cada página (opcional)
 * - body: Contenido principal inyectado desde cada vista
 */
-->
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- Título dinámico: usa variable 'title' o título por defecto -->
  <title><%= title || 'SkillTrade - Plataforma de Aprendizaje' %></title>
  <!-- Framework CSS Tailwind desde CDN para estilos utilitarios -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Fuente Inter de Google Fonts para tipografía moderna -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Estilos globales personalizados -->
  <style>
    body { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-gray-50 min-h-screen">
  <!-- Header de navegación global (sticky) -->
  <%- include('partials/header') %>
  
  <!-- Contenido principal de cada página -->
  <main>
    <%- body %>
  </main>
  
  <!-- Footer informativo global -->
  <%- include('partials/footer') %>
</body>
</html>

